      show ((T F).out n).val = n + ((T F).wit n + (T F).anc n)
      omega)
  have hpA : ∀ j : Fin n, p j ≠ (⟨(T F).anc n, hAlt⟩ : Fin ((T F).anc n + 1)) := by
    intro j
    refine shiPf_ne_of_val ?_
    have h1 := hp j
    have h2 := j.isLt
    show ¬ ((p j).val = (T F).anc n)
    omega
  have hqA : ∀ j : Fin n, q j ≠ (⟨(T F).anc n, hAlt⟩ : Fin ((T F).anc n + 1)) := by
    intro j
    refine shiPf_ne_of_val ?_
    have h1 := hq j
    have h2 := j.isLt
    show ¬ ((q j).val = (T F).anc n)
    omega
  -- `hInit`: EVERY spread along `e` vanishes on strings where the output wire is `1`,
  -- because that wire is the only one off the image of `e`.
  have hzeroOut : ∀ (ψ : QState (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1))) + (n + (F.wit n + (F.anc n + 1))))) (Y : Bits (n + ((T F).wit n + ((T F).anc n + 1)))),
      Y ((T F).out n) = true → ShiSpread.spread e ψ Y = 0 := by
    intro ψ Y hY
    show (if (∀ k : Fin (n + ((T F).wit n + ((T F).anc n + 1))), ShiSpread.OffImage e k → Y k = false)
        then ψ (ShiSpread.restrict e Y) else 0) = 0
    refine if_neg ?_
    intro hall
    have h1 : Y ((T F).out n) = false :=
      hall ((T F).out n) ((hoff ((T F).out n)).mpr rfl)
    exact Bool.noConfusion (h1.symm.trans hY)
  -- The nine bridges: reading the restricted string on block `i` IS reading `Y` through `e_i`,
  -- and `e_i` sends each copy role wire to the role wire named by `exists_layout_bijection`.
  have hb1i : ∀ (Y : Bits (n + ((T F).wit n + ((T F).anc n + 1)))) (i : Fin n),
      ShiTensor.leftBits (ShiTensor.leftBits (ShiSpread.restrict e Y))
          (Fin.castAdd (F.wit n + (F.anc n + 1)) i)
        = Y (Fin.castAdd ((T F).wit n + ((T F).anc n + 1)) i) :=
    fun Y i => congrArg Y ((hi1 (Fin.castAdd (F.wit n + (F.anc n + 1)) i)).trans (hr1 i))
  have hb2i : ∀ (Y : Bits (n + ((T F).wit n + ((T F).anc n + 1)))) (j : Fin n),
      ShiTensor.rightBits (ShiTensor.leftBits (ShiSpread.restrict e Y))
          (Fin.castAdd (F.wit n + (F.anc n + 1)) j)
        = Y (Fin.natAdd n (Fin.natAdd ((T F).wit n) (p j))) :=
    fun Y j => congrArg Y ((hi2 (Fin.castAdd (F.wit n + (F.anc n + 1)) j)).trans (hr2 j))
  have hb3i : ∀ (Y : Bits (n + ((T F).wit n + ((T F).anc n + 1)))) (j : Fin n),
      ShiTensor.rightBits (ShiSpread.restrict e Y)
          (Fin.castAdd (F.wit n + (F.anc n + 1)) j)
        = Y (Fin.natAdd n (Fin.natAdd ((T F).wit n) (q j))) :=
    fun Y j => congrArg Y ((hi3 (Fin.castAdd (F.wit n + (F.anc n + 1)) j)).trans (hr3 j))
  have hb1a : ∀ (Y : Bits (n + ((T F).wit n + ((T F).anc n + 1)))) (l : Fin (F.anc n + 1)) (l' : Fin ((T F).anc n + 1)),
      l'.val = l.val →
      ShiTensor.leftBits (ShiTensor.leftBits (ShiSpread.restrict e Y))
          (Fin.natAdd n (Fin.natAdd (F.wit n) l))
        = Y (Fin.natAdd n (Fin.natAdd ((T F).wit n) l')) :=
    fun Y l l' h =>
      congrArg Y ((hi1 (Fin.natAdd n (Fin.natAdd (F.wit n) l))).trans (ha1 l l' h))
  have hb2a : ∀ (Y : Bits (n + ((T F).wit n + ((T F).anc n + 1)))) (l : Fin (F.anc n + 1)) (l' : Fin ((T F).anc n + 1)),
      l'.val = n + F.anc n + 1 + l.val →
      ShiTensor.rightBits (ShiTensor.leftBits (ShiSpread.restrict e Y))
          (Fin.natAdd n (Fin.natAdd (F.wit n) l))
        = Y (Fin.natAdd n (Fin.natAdd ((T F).wit n) l')) :=
    fun Y l l' h =>
      congrArg Y ((hi2 (Fin.natAdd n (Fin.natAdd (F.wit n) l))).trans (ha2 l l' h))
  have hb3a : ∀ (Y : Bits (n + ((T F).wit n + ((T F).anc n + 1)))) (l : Fin (F.anc n + 1)) (l' : Fin ((T F).anc n + 1)),
      l'.val = 2 * n + 2 * F.anc n + 2 + l.val →
      ShiTensor.rightBits (ShiSpread.restrict e Y)
          (Fin.natAdd n (Fin.natAdd (F.wit n) l))
        = Y (Fin.natAdd n (Fin.natAdd ((T F).wit n) l')) :=
    fun Y l l' h =>
      congrArg Y ((hi3 (Fin.natAdd n (Fin.natAdd (F.wit n) l))).trans (ha3 l l' h))
  have hbw1 : ∀ (Y : Bits (n + ((T F).wit n + ((T F).anc n + 1)))) (j : Fin (F.wit n)) (j' : Fin ((T F).wit n)),
      j'.val = j.val →
      ShiTensor.leftBits (ShiTensor.leftBits (ShiSpread.restrict e Y))
          (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))
        = Y (Fin.natAdd n (Fin.castAdd ((T F).anc n + 1) j')) :=
    fun Y j j' h =>
      congrArg Y ((hi1 (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))).trans (hw1 j j' h))
  have hbw2 : ∀ (Y : Bits (n + ((T F).wit n + ((T F).anc n + 1)))) (j : Fin (F.wit n)) (j' : Fin ((T F).wit n)),
      j'.val = F.wit n + j.val →
      ShiTensor.rightBits (ShiTensor.leftBits (ShiSpread.restrict e Y))
          (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))
        = Y (Fin.natAdd n (Fin.castAdd ((T F).anc n + 1) j')) :=
    fun Y j j' h =>
      congrArg Y ((hi2 (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))).trans (hw2 j j' h))
  have hbw3 : ∀ (Y : Bits (n + ((T F).wit n + ((T F).anc n + 1)))) (j : Fin (F.wit n)) (j' : Fin ((T F).wit n)),
      j'.val = 2 * F.wit n + j.val →
      ShiTensor.rightBits (ShiSpread.restrict e Y)
          (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))
        = Y (Fin.natAdd n (Fin.castAdd ((T F).anc n + 1) j')) :=
    fun Y j j' h =>
      congrArg Y ((hi3 (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))).trans (hw3 j j' h))
  -- The guard equivalence.  The fan-out theorem's guard already EXCLUDES the `p`- and
  -- `q`-ranges by hypothesis, so those two intervals are vacuous below.
  have hPQR : ∀ Y : Bits (n + ((T F).wit n + ((T F).anc n + 1))),
      (((∀ i : Fin n, Y (Fin.castAdd ((T F).wit n + ((T F).anc n + 1)) i) = x i)
          ∧ (∀ j : Fin n, Y (Fin.natAdd n (Fin.natAdd ((T F).wit n) (p j))) = x j)
          ∧ (∀ j : Fin n, Y (Fin.natAdd n (Fin.natAdd ((T F).wit n) (q j))) = x j)
          ∧ (∀ l : Fin ((T F).anc n + 1), (∀ j : Fin n, p j ≠ l) → (∀ j : Fin n, q j ≠ l) →
              Y (Fin.natAdd n (Fin.natAdd ((T F).wit n) l)) = false))
        ↔ ((∀ k : Fin (n + ((T F).wit n + ((T F).anc n + 1))), ShiSpread.OffImage e k → Y k = false)
            ∧ (((∀ i : Fin n, ShiTensor.leftBits (ShiTensor.leftBits (ShiSpread.restrict e Y))
                    (Fin.castAdd (F.wit n + (F.anc n + 1)) i) = x i)
                ∧ (∀ l : Fin (F.anc n + 1),
                    ShiTensor.leftBits (ShiTensor.leftBits (ShiSpread.restrict e Y))
                      (Fin.natAdd n (Fin.natAdd (F.wit n) l)) = false))
              ∧ ((∀ i : Fin n, ShiTensor.rightBits (ShiTensor.leftBits (ShiSpread.restrict e Y))
                    (Fin.castAdd (F.wit n + (F.anc n + 1)) i) = x i)
                ∧ (∀ l : Fin (F.anc n + 1),
                    ShiTensor.rightBits (ShiTensor.leftBits (ShiSpread.restrict e Y))
                      (Fin.natAdd n (Fin.natAdd (F.wit n) l)) = false))
              ∧ ((∀ i : Fin n, ShiTensor.rightBits (ShiSpread.restrict e Y)
                    (Fin.castAdd (F.wit n + (F.anc n + 1)) i) = x i)
                ∧ (∀ l : Fin (F.anc n + 1),
                    ShiTensor.rightBits (ShiSpread.restrict e Y)
                      (Fin.natAdd n (Fin.natAdd (F.wit n) l)) = false))))) := by
    intro Y
    constructor
    · rintro ⟨pi, pp, pq, pl⟩
      refine ⟨?_, ⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩⟩
      · intro k hk
        rw [(hoff k).mp hk, houtEq]
        exact pl _ hpA hqA
      · intro i
        exact (hb1i Y i).trans (pi i)
      · intro l
        have hl := l.isLt
        have hb : l.val < (T F).anc n + 1 := by omega
        refine (hb1a Y l ⟨l.val, hb⟩ rfl).trans (pl ⟨l.val, hb⟩ ?_ ?_)
        · intro j
          refine shiPf_ne_of_val ?_
          have h1 := hp j
          show ¬ ((p j).val = l.val)
          omega
        · intro j
          refine shiPf_ne_of_val ?_
          have h1 := hq j
          show ¬ ((q j).val = l.val)
          omega
      · intro i
        exact (hb2i Y i).trans (pp i)
      · intro l
        have hl := l.isLt
        have hb : n + F.anc n + 1 + l.val < (T F).anc n + 1 := by omega
        refine (hb2a Y l ⟨n + F.anc n + 1 + l.val, hb⟩ rfl).trans
          (pl ⟨n + F.anc n + 1 + l.val, hb⟩ ?_ ?_)
        · intro j
          refine shiPf_ne_of_val ?_
          have h1 := hp j
          have h2 := j.isLt
          show ¬ ((p j).val = n + F.anc n + 1 + l.val)
          omega
        · intro j
          refine shiPf_ne_of_val ?_
          have h1 := hq j
          show ¬ ((q j).val = n + F.anc n + 1 + l.val)
          omega
      · intro i
        exact (hb3i Y i).trans (pq i)
      · intro l
        have hl := l.isLt
        have hb : 2 * n + 2 * F.anc n + 2 + l.val < (T F).anc n + 1 := by omega
        refine (hb3a Y l ⟨2 * n + 2 * F.anc n + 2 + l.val, hb⟩ rfl).trans
          (pl ⟨2 * n + 2 * F.anc n + 2 + l.val, hb⟩ ?_ ?_)
        · intro j
          refine shiPf_ne_of_val ?_
          have h1 := hp j
          have h2 := j.isLt
          show ¬ ((p j).val = 2 * n + 2 * F.anc n + 2 + l.val)
          omega
        · intro j
          refine shiPf_ne_of_val ?_
          have h1 := hq j
          have h2 := j.isLt
          show ¬ ((q j).val = 2 * n + 2 * F.anc n + 2 + l.val)
          omega
    · rintro ⟨hQ, ⟨r1i, r1a⟩, ⟨r2i, r2a⟩, ⟨r3i, r3a⟩⟩
      refine ⟨?_, ?_, ?_, ?_⟩
      · intro i
        exact (hb1i Y i).symm.trans (r1i i)
      · intro j
        exact (hb2i Y j).symm.trans (r2i j)
      · intro j
        exact (hb3i Y j).symm.trans (r3i j)
      · intro l hpl hql
        have hl := l.isLt
        -- copy 1's ancilla AND output wires: role ancilla indices `[0, F.anc n]`
        rcases Nat.lt_or_ge l.val (F.anc n + 1) with c1 | c1
        · exact (hb1a Y ⟨l.val, c1⟩ l rfl).symm.trans (r1a ⟨l.val, c1⟩)
        -- the `p`-wires: VACUOUS, excluded by `hpl`
        rcases Nat.lt_or_ge l.val (F.anc n + 1 + n) with c2 | c2
        · exfalso
          have hj : l.val - (F.anc n + 1) < n := by omega
          refine hpl ⟨l.val - (F.anc n + 1), hj⟩ (Fin.val_injective ?_)
          have h1 : (p ⟨l.val - (F.anc n + 1), hj⟩).val
              = F.anc n + 1 + (l.val - (F.anc n + 1)) := hp ⟨l.val - (F.anc n + 1), hj⟩
          show (p ⟨l.val - (F.anc n + 1), hj⟩).val = l.val
          omega
        -- copy 2's ancilla AND output wires
        rcases Nat.lt_or_ge l.val (n + F.anc n + 1 + (F.anc n + 1)) with c3 | c3
        · have hb : l.val - (n + F.anc n + 1) < F.anc n + 1 := by omega
          refine (hb2a Y ⟨l.val - (n + F.anc n + 1), hb⟩ l ?_).symm.trans
            (r2a ⟨l.val - (n + F.anc n + 1), hb⟩)
          show l.val = n + F.anc n + 1 + (l.val - (n + F.anc n + 1))
          omega
        -- the `q`-wires: VACUOUS, excluded by `hql`
        rcases Nat.lt_or_ge l.val (2 * n + 2 * F.anc n + 2) with c4 | c4
        · exfalso
          have hj : l.val - (n + 2 * F.anc n + 2) < n := by omega
          refine hql ⟨l.val - (n + 2 * F.anc n + 2), hj⟩ (Fin.val_injective ?_)
          have h1 : (q ⟨l.val - (n + 2 * F.anc n + 2), hj⟩).val
              = n + 2 * F.anc n + 2 + (l.val - (n + 2 * F.anc n + 2)) :=
            hq ⟨l.val - (n + 2 * F.anc n + 2), hj⟩
          show (q ⟨l.val - (n + 2 * F.anc n + 2), hj⟩).val = l.val
          omega
        -- copy 3's ancilla AND output wires
        rcases Nat.lt_or_ge l.val (2 * n + 2 * F.anc n + 2 + (F.anc n + 1)) with c5 | c5
        · have hb : l.val - (2 * n + 2 * F.anc n + 2) < F.anc n + 1 := by omega
          refine (hb3a Y ⟨l.val - (2 * n + 2 * F.anc n + 2), hb⟩ l ?_).symm.trans
            (r3a ⟨l.val - (2 * n + 2 * F.anc n + 2), hb⟩)
          show l.val = 2 * n + 2 * F.anc n + 2 + (l.val - (2 * n + 2 * F.anc n + 2))
          omega
        -- the ONE leftover index: the output wire, carried symbolically
        · have hlout : (T F).out n = Fin.natAdd n (Fin.natAdd ((T F).wit n) l) :=
            Fin.val_injective (by
              show ((T F).out n).val = n + ((T F).wit n + l.val)
              omega)
          rw [← hlout]
          exact hQ ((T F).out n) ((hoff ((T F).out n)).mpr rfl)
  -- The amplitude: `χ`'s dependent-`if` assembly of the three copies' witness blocks IS the
  -- role witness block, read off `Y`.
  have hasm : ∀ Y : Bits (n + ((T F).wit n + ((T F).anc n + 1))),
      (fun j : Fin ((T F).wit n) =>
        if h : j.val < F.wit n then
          ShiTensor.leftBits (ShiTensor.leftBits (ShiSpread.restrict e Y))
            (Fin.natAdd n (Fin.castAdd (F.anc n + 1) (⟨j.val, h⟩ : Fin (F.wit n))))
        else if h2 : j.val < F.wit n + F.wit n then
          ShiTensor.rightBits (ShiTensor.leftBits (ShiSpread.restrict e Y))
            (Fin.natAdd n (Fin.castAdd (F.anc n + 1)
              (⟨j.val - F.wit n, by omega⟩ : Fin (F.wit n))))
        else
          ShiTensor.rightBits (ShiSpread.restrict e Y)
            (Fin.natAdd n (Fin.castAdd (F.anc n + 1)
              (⟨j.val - F.wit n - F.wit n, by
                have hj := j.isLt
                have hw := hwit F n
                omega⟩ : Fin (F.wit n)))))
        = fun w : Fin ((T F).wit n) =>
            Y (Fin.natAdd n (Fin.castAdd ((T F).anc n + 1) w)) := by
    intro Y
    funext j
    have hj := j.isLt
    refine shiPf_dite_eq (fun hc => ?_) (fun hn => ?_)
    · exact hbw1 Y ⟨j.val, hc⟩ j rfl
    · refine shiPf_dite_eq (fun hc2 => ?_) (fun hn2 => ?_)
      · refine hbw2 Y _ j ?_
        show j.val = F.wit n + (j.val - F.wit n)
        omega
      · refine hbw3 Y _ j ?_
        show j.val = 2 * F.wit n + (j.val - F.wit n - F.wit n)
        omega
  -- The circuit factoring: `E1 ++ E2 ++ E3` is ONE embedding of the three-block circuit.
  have hinj1 : Function.Injective
      (((Fin.castAdd (n + (F.wit n + (F.anc n + 1))) : Fin (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1)))) → Fin (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1))) + (n + (F.wit n + (F.anc n + 1)))))) ∘
        (Fin.castAdd (n + (F.wit n + (F.anc n + 1))) : Fin (n + (F.wit n + (F.anc n + 1))) → Fin (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1)))))) :=
    (Fin.castAdd_injective (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1)))) (n + (F.wit n + (F.anc n + 1)))).comp
      (Fin.castAdd_injective (n + (F.wit n + (F.anc n + 1))) (n + (F.wit n + (F.anc n + 1))))
  have hinj2 : Function.Injective
      (((Fin.castAdd (n + (F.wit n + (F.anc n + 1))) : Fin (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1)))) → Fin (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1))) + (n + (F.wit n + (F.anc n + 1)))))) ∘
        (Fin.natAdd (n + (F.wit n + (F.anc n + 1))) : Fin (n + (F.wit n + (F.anc n + 1))) → Fin (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1)))))) :=
    (Fin.castAdd_injective (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1)))) (n + (F.wit n + (F.anc n + 1)))).comp
      (Fin.natAdd_injective (n + (F.wit n + (F.anc n + 1))) (n + (F.wit n + (F.anc n + 1))))
  have hinj3 : Function.Injective
      (Fin.natAdd (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1)))) : Fin (n + (F.wit n + (F.anc n + 1))) → Fin (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1))) + (n + (F.wit n + (F.anc n + 1))))) :=
    Fin.natAdd_injective (n + (F.wit n + (F.anc n + 1))) (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1))))
  have hcm1 : e ∘ (((Fin.castAdd (n + (F.wit n + (F.anc n + 1))) : Fin (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1)))) → Fin (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1))) + (n + (F.wit n + (F.anc n + 1)))))) ∘
      (Fin.castAdd (n + (F.wit n + (F.anc n + 1))) : Fin (n + (F.wit n + (F.anc n + 1))) → Fin (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1)))))) = e1 := funext hi1
  have hcm2 : e ∘ (((Fin.castAdd (n + (F.wit n + (F.anc n + 1))) : Fin (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1)))) → Fin (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1))) + (n + (F.wit n + (F.anc n + 1)))))) ∘
      (Fin.natAdd (n + (F.wit n + (F.anc n + 1))) : Fin (n + (F.wit n + (F.anc n + 1))) → Fin (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1)))))) = e2 := funext hi2
  have hcm3 : e ∘ (Fin.natAdd (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1)))) :
      Fin (n + (F.wit n + (F.anc n + 1))) → Fin (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1))) + (n + (F.wit n + (F.anc n + 1))))) = e3 := funext hi3
  have hE1eq : ShiEmbed.embedCirc e1 he1 (F.circ n)
      = ShiEmbed.embedCirc e he (ShiEmbed.embedCirc _ hinj1 (F.circ n)) :=
    (shiPf_embedCirc_congr he1 (he.comp hinj1) hcm1.symm (F.circ n)).trans
      ((ShiEmbed.embedCirc_depth_append_comp _ hinj1 e he).2.2 (F.circ n))
  have hE2eq : ShiEmbed.embedCirc e2 he2 (F.circ n)
      = ShiEmbed.embedCirc e he (ShiEmbed.embedCirc _ hinj2 (F.circ n)) :=
    (shiPf_embedCirc_congr he2 (he.comp hinj2) hcm2.symm (F.circ n)).trans
      ((ShiEmbed.embedCirc_depth_append_comp _ hinj2 e he).2.2 (F.circ n))
  have hE3eq : ShiEmbed.embedCirc e3 he3 (F.circ n)
      = ShiEmbed.embedCirc e he (ShiEmbed.embedCirc _ hinj3 (F.circ n)) :=
    (shiPf_embedCirc_congr he3 (he.comp hinj3) hcm3.symm (F.circ n)).trans
      ((ShiEmbed.embedCirc_depth_append_comp _ hinj3 e he).2.2 (F.circ n))
  have hdist := (ShiEmbed.embedCirc_depth_append_comp e he
      (id : Fin (n + ((T F).wit n + ((T F).anc n + 1))) → Fin (n + ((T F).wit n + ((T F).anc n + 1)))) Function.injective_id).2.1
  have hgroup : fan2 ++ fan3 ++ ShiEmbed.embedCirc e1 he1 (F.circ n)
        ++ ShiEmbed.embedCirc e2 he2 (F.circ n) ++ ShiEmbed.embedCirc e3 he3 (F.circ n)
      = (fan2 ++ fan3) ++ (ShiEmbed.embedCirc e1 he1 (F.circ n)
          ++ ShiEmbed.embedCirc e2 he2 (F.circ n)
          ++ ShiEmbed.embedCirc e3 he3 (F.circ n)) := by
    simp only [List.append_assoc]
  refine ⟨e, he, hi1, hi2, hi3, hoff, hzeroOut, ?_⟩
  rw [hgroup, shiPf_append, ← ShiSpread.runLayered_embedCirc_spread e he, hdist, hdist,
    ← hE1eq, ← hE2eq, ← hE3eq]
  refine shiPf_runLayered_congr _ ?_
