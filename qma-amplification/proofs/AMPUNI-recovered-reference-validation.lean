open ShiShallow ShiClassQMA

/-! ### Two-point sums over basis strings -/

private lemma shiQma1_two_point_sum {ι : Type} [Fintype ι] [DecidableEq ι] {A B : ι}
    (hAB : A ≠ B) (F : ι → ℂ)
    (hF : ∀ x, x ≠ A → x ≠ B → F x = 0) :
    ∑ x, F x = F A + F B := by
  have hsub : ({A, B} : Finset ι) ⊆ Finset.univ := Finset.subset_univ _
  have h1 : ∑ x ∈ ({A, B} : Finset ι), F x = ∑ x ∈ Finset.univ, F x := by
    refine Finset.sum_subset hsub ?_
    intro x _ hx
    exact hF x (fun h => hx (by simp [h])) (fun h => hx (by simp [h]))
  rw [← h1]
  exact Finset.sum_pair hAB

private lemma shiQma1_update_ne {n : ℕ} (i : Fin n) (y : Bits n) :
    Function.update y i false ≠ Function.update y i true := by
  intro h
  have h1 : Function.update y i false i = Function.update y i true i := congrFun h i
  rw [Function.update_self, Function.update_self] at h1
  exact Bool.false_ne_true h1

/-! ### `apply1Matrix U i` is unitary whenever `U` is -/

private lemma shiQma1_a1_entry {n : ℕ} (U : Matrix Bool Bool ℂ) (i : Fin n) (y z : Bits n) :
    apply1Matrix U i y z =
      if (∀ k, k ∉ ({i} : Finset (Fin n)) → y k = z k) then U (y i) (z i) else 0 := by
  first
  | rfl
  | (simp only [apply1Matrix, Matrix.of_apply]; done)

/-! ### `cnotMatrix i j` is unitary for `i ≠ j` -/

private lemma shiQma1_cnot_entry {n : ℕ} (i j : Fin n) (y z : Bits n) :
    cnotMatrix i j y z =
      if (∀ k, k ∉ ({i, j} : Finset (Fin n)) → y k = z k) ∧ z i = y i
          ∧ z j = xor (y j) (y i) then 1 else 0 := by
  first
  | rfl
  | (simp only [cnotMatrix, Matrix.of_apply]; done)

private lemma shiQma1_cnot_col_unique {n : ℕ} (i j : Fin n) (y z : Bits n)
    (h1 : ∀ k, k ∉ ({i, j} : Finset (Fin n)) → y k = z k)
    (h2 : z i = y i) (h3 : z j = xor (y j) (y i)) :
    z = Function.update y j (xor (y j) (y i)) := by
  funext k
  by_cases hkj : k = j
  · rw [hkj, Function.update_self]
    exact h3
  · rw [Function.update_of_ne hkj]
    by_cases hki : k = i
    · rw [hki]
      exact h2
    · refine (h1 k ?_).symm
      first
        | (simp [hki, hkj]; done)
        | (simp only [Finset.mem_insert, Finset.mem_singleton]; tauto)

private lemma shiQma1_cnot_cond {n : ℕ} (i j : Fin n) (hij : i ≠ j) (y : Bits n) :
    (∀ k, k ∉ ({i, j} : Finset (Fin n)) →
        y k = Function.update y j (xor (y j) (y i)) k)
      ∧ Function.update y j (xor (y j) (y i)) i = y i
      ∧ Function.update y j (xor (y j) (y i)) j = xor (y j) (y i) := by
  refine ⟨?_, ?_, ?_⟩
  · intro k hk
    have hkj : k ≠ j := by
      intro h
      exact hk (by simp [h])
    exact (Function.update_of_ne hkj (xor (y j) (y i)) y).symm
  · exact Function.update_of_ne hij (xor (y j) (y i)) y
  · exact Function.update_self j (xor (y j) (y i)) y

private lemma shiQma1_cnot_entry_iff {n : ℕ} (i j : Fin n) (hij : i ≠ j) (y z : Bits n) :
    cnotMatrix i j y z =
      if z = Function.update y j (xor (y j) (y i)) then (1 : ℂ) else 0 := by
  rw [shiQma1_cnot_entry]
  by_cases hc : (∀ k, k ∉ ({i, j} : Finset (Fin n)) → y k = z k) ∧ z i = y i
      ∧ z j = xor (y j) (y i)
  · rw [if_pos hc, if_pos (shiQma1_cnot_col_unique i j y z hc.1 hc.2.1 hc.2.2)]
  · have hz : z ≠ Function.update y j (xor (y j) (y i)) := by
      intro hz
      exact hc (by rw [hz]; exact shiQma1_cnot_cond i j hij y)
    rw [if_neg hc, if_neg hz]

/-! ### The unconditional state-vector / matrix bridge (inlined MTX-1 + MTX-2 + MTX-3) -/

private lemma shiQma1_guard_update {n : ℕ} (i : Fin n) (y z : Bits n)
    (h : ∀ k, k ∉ ({i} : Finset (Fin n)) → y k = z k) :
    z = Function.update y i (z i) := by
  funext k
  by_cases hk : k = i
  · rw [hk, Function.update_self]
  · rw [Function.update_of_ne hk]
    exact (h k (by simpa [Finset.mem_singleton] using hk)).symm

private lemma shiQma1_a1_col_entry {n : ℕ} (U : Matrix Bool Bool ℂ) (i : Fin n)
    (y : Bits n) (b : Bool) :
    apply1Matrix U i y (Function.update y i b) = U (y i) b := by
  have hg : ∀ k, k ∉ ({i} : Finset (Fin n)) → y k = Function.update y i b k := by
    intro k hk
    have hki : k ≠ i := by simpa [Finset.mem_singleton] using hk
    rw [Function.update_of_ne hki]
  rw [shiQma1_a1_entry, if_pos hg, Function.update_self]

private lemma shiQma1_a1_col_vanish {n : ℕ} (U : Matrix Bool Bool ℂ) (i : Fin n)
    (y z : Bits n) (h0 : z ≠ Function.update y i false)
    (h1 : z ≠ Function.update y i true) :
    apply1Matrix U i y z = 0 := by
  rw [shiQma1_a1_entry]
  refine if_neg ?_
  intro hguard
  have hz : z = Function.update y i (z i) := shiQma1_guard_update i y z hguard
  cases hzi : z i
  · exact h0 (hz.trans (by rw [hzi]))
  · exact h1 (hz.trans (by rw [hzi]))

private lemma shiQma1_apply1 {n : ℕ} (U : Matrix Bool Bool ℂ) (i : Fin n) (ψ : QState n) :
    apply1 U i ψ = Matrix.mulVec (apply1Matrix U i) ψ := by
  funext y
  have hRHS : Matrix.mulVec (apply1Matrix U i) ψ y
      = ∑ z : Bits n, apply1Matrix U i y z * ψ z :=
    Matrix.mulVec_apply_eq_sum (apply1Matrix U i) ψ y
  have hkey : (∑ z : Bits n, apply1Matrix U i y z * ψ z)
      = apply1Matrix U i y (Function.update y i false) * ψ (Function.update y i false)
        + apply1Matrix U i y (Function.update y i true) * ψ (Function.update y i true) :=
    shiQma1_two_point_sum (shiQma1_update_ne i y)
      (fun z => apply1Matrix U i y z * ψ z)
      (fun z h0 h1 => by
        have hv := shiQma1_a1_col_vanish U i y z h0 h1
        simp [hv])
  have hLHS : apply1 U i ψ y = ∑ b : Bool, U (y i) b * ψ (Function.update y i b) := rfl
  rw [hLHS, hRHS, hkey]
  simp only [shiQma1_a1_col_entry]
  first
  | (rw [Fintype.sum_bool]; exact add_comm _ _)
  | (rw [Fintype.sum_bool]; ring)
  | (simp [Fintype.sum_bool, add_comm]; done)

private lemma shiQma1_cnot {n : ℕ} (i j : Fin n) (hij : i ≠ j) (ψ : QState n) :
    cnotState i j hij ψ = Matrix.mulVec (cnotMatrix i j) ψ := by
  funext y
  have hL : cnotState i j hij ψ y = ψ (Function.update y j (xor (y j) (y i))) := rfl
  have hR : Matrix.mulVec (cnotMatrix i j) ψ y
      = ∑ z : Bits n, cnotMatrix i j y z * ψ z :=
    Matrix.mulVec_apply_eq_sum (cnotMatrix i j) ψ y
  have hone : cnotMatrix i j y (Function.update y j (xor (y j) (y i))) = 1 := by
    rw [shiQma1_cnot_entry, if_pos (shiQma1_cnot_cond i j hij y)]
  have hzero : ∀ z ∈ (Finset.univ : Finset (Bits n)),
      z ≠ Function.update y j (xor (y j) (y i)) →
      cnotMatrix i j y z * ψ z = 0 := by
    intro z _ hz
    rw [shiQma1_cnot_entry_iff i j hij y z, if_neg hz, zero_mul]
  have hsingle : (∑ z : Bits n, cnotMatrix i j y z * ψ z)
      = cnotMatrix i j y (Function.update y j (xor (y j) (y i)))
        * ψ (Function.update y j (xor (y j) (y i))) :=
    Finset.sum_eq_single_of_mem _ (Finset.mem_univ _) hzero
  rw [hL, hR, hsingle, hone, one_mul]

private lemma shiQma1_bridge {n : ℕ} (c : Layered n) (ψ : QState n) :
    runLayered c ψ = Matrix.mulVec (circMatrix c) ψ := by
  have hg : ∀ (g : Instr n) (φ : QState n),
      g.apply φ = Matrix.mulVec (gateMatrix g) φ := by
    intro g φ
    cases g with
    | h i => exact shiQma1_apply1 hMat i φ
    | s i => exact shiQma1_apply1 sMat i φ
    | t i => exact shiQma1_apply1 tMat i φ
    | x i => exact shiQma1_apply1 xMat i φ
    | cnot i j hij => exact shiQma1_cnot i j hij φ
  have hl : ∀ (l : List (Instr n)) (φ : QState n),
      runLayer l φ = Matrix.mulVec (layerMatrix l) φ := by
    intro l
    induction l with
    | nil =>
        intro φ
        first
        | (show φ = Matrix.mulVec (1 : Op n) φ
           rw [Matrix.one_mulVec]
           done)
        | (simp [runLayer, layerMatrix]; done)
    | cons g t ih =>
        intro φ
        first
        | (show runLayer t (g.apply φ) = Matrix.mulVec (layerMatrix t * gateMatrix g) φ
           rw [ih (g.apply φ), hg g φ, Matrix.mulVec_mulVec]
           done)
        | (simp only [runLayer, layerMatrix]
           rw [ih (g.apply φ), hg g φ, Matrix.mulVec_mulVec]
           done)
  induction c generalizing ψ with
  | nil =>
      first
      | (show ψ = Matrix.mulVec (1 : Op n) ψ
         rw [Matrix.one_mulVec]
         done)
      | (simp [runLayered, circMatrix]; done)
  | cons l t ih =>
      first
      | (show runLayered t (runLayer l ψ)
             = Matrix.mulVec (circMatrix t * layerMatrix l) ψ
         rw [ih (runLayer l ψ), hl l ψ, Matrix.mulVec_mulVec]
         done)
      | (simp only [runLayered, circMatrix]
         rw [ih (runLayer l ψ), hl l ψ, Matrix.mulVec_mulVec]
         done)

/-! ### The output projector: entries and its action on a vector -/

private lemma shiQma1_projEntry {n : ℕ} (out : Fin n) (y z : Bits n) :
    projOut out y z = if y = z ∧ y out = true then 1 else 0 := by
  first
  | rfl
  | (simp only [projOut, Matrix.of_apply]; done)
  | (simp [projOut]; done)

private lemma shiQma1_projMulVec {n : ℕ} (out : Fin n) (w : Bits n → ℂ) (y : Bits n) :
    Matrix.mulVec (projOut out) w y = if y out = true then w y else 0 := by
  have hR : Matrix.mulVec (projOut out) w y = ∑ z : Bits n, projOut out y z * w z :=
    Matrix.mulVec_apply_eq_sum (projOut out) w y
  by_cases hy : y out = true
  · have hzero : ∀ z ∈ (Finset.univ : Finset (Bits n)), z ≠ y →
        projOut out y z * w z = 0 := by
      intro z _ hz
      have hne : ¬(y = z ∧ y out = true) := by
        intro hc
        exact hz hc.1.symm
      rw [shiQma1_projEntry out y z, if_neg hne, zero_mul]
    have hsum : (∑ z : Bits n, projOut out y z * w z) = projOut out y y * w y :=
      Finset.sum_eq_single_of_mem y (Finset.mem_univ y) hzero
    rw [hR, hsum, shiQma1_projEntry out y y, if_pos (And.intro rfl hy), one_mul, if_pos hy]
  · have hzero : ∀ z ∈ (Finset.univ : Finset (Bits n)),
        projOut out y z * w z = 0 := by
      intro z _
      have hne : ¬(y = z ∧ y out = true) := by
        intro hc
        exact hy hc.2
      rw [shiQma1_projEntry out y z, if_neg hne, zero_mul]
    have hsum : (∑ z : Bits n, projOut out y z * w z) = 0 :=
      Finset.sum_eq_zero hzero
    rw [hR, hsum, if_neg hy]

/-! ### `conj z * z` is the real number `‖z‖ ^ 2` -/

private lemma shiQma1_conjMulSelf (z : ℂ) : star z * z = ((‖z‖ ^ 2 : ℝ) : ℂ) := by
  have h : (starRingEnd ℂ) z * z = star z * z := by rw [starRingEnd_apply]
  rw [← h]
  first
  | (rw [Complex.conj_mul']; done)
  | (rw [Complex.conj_mul', Complex.ofReal_pow]; done)
  | (rw [Complex.conj_mul']; norm_cast; done)
  | (rw [Complex.conj_mul']; push_cast; ring)
  | (rw [RCLike.conj_mul]; done)
  | (rw [RCLike.conj_mul, Complex.ofReal_pow]; done)
  | (rw [RCLike.conj_mul]; norm_cast; done)
  | (rw [RCLike.conj_mul]; push_cast; ring)

/-! ### The general quadratic-form identity, at an arbitrary input state -/

private lemma shiQma1_general {N : ℕ} (c : Layered N) (out : Fin N) (Φ : QState N) :
    (∑ y : Bits N, if y out then ‖runLayered c Φ y‖ ^ 2 else 0)
      = (∑ y : Bits N, (starRingEnd ℂ) (Φ y)
          * Matrix.mulVec (star (circMatrix c) * projOut out * circMatrix c) Φ y).re := by
  have hb : runLayered c Φ = Matrix.mulVec (circMatrix c) Φ :=
    shiQma1_bridge c Φ
  have hacc : (∑ y : Bits N, if y out then ‖runLayered c Φ y‖ ^ 2 else 0)
      = ∑ y : Bits N,
          (if y out = true then ‖Matrix.mulVec (circMatrix c) Φ y‖ ^ 2 else 0) := by
    rw [hb]
  have hdotR : (∑ y : Bits N,
        (starRingEnd ℂ) (Φ y)
          * (Matrix.mulVec (star (circMatrix c) * projOut out * circMatrix c) Φ) y)
      = dotProduct (star Φ)
          (Matrix.mulVec (star (circMatrix c) * projOut out * circMatrix c) Φ) := by
    first
    | rfl
    | (simp only [dotProduct, Pi.star_apply, starRingEnd_apply]; done)
    | (simp only [dotProduct, Pi.star_apply]; done)
  have halg : dotProduct (star Φ)
        (Matrix.mulVec (star (circMatrix c) * projOut out * circMatrix c) Φ)
      = dotProduct (star (Matrix.mulVec (circMatrix c) Φ))
          (Matrix.mulVec (projOut out) (Matrix.mulVec (circMatrix c) Φ)) := by
    first
    | (rw [Matrix.star_mulVec, Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec,
           Matrix.dotProduct_mulVec, Matrix.vecMul_vecMul, Matrix.star_eq_conjTranspose,
           mul_assoc]
       done)
    | (rw [Matrix.star_mulVec, Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec,
           Matrix.dotProduct_mulVec, Matrix.vecMul_vecMul, Matrix.star_eq_conjTranspose,
           Matrix.mul_assoc]
       done)
    | (simp only [Matrix.star_mulVec, Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec,
                  Matrix.vecMul_vecMul, Matrix.star_eq_conjTranspose, mul_assoc]
       done)
  have hentry : ∀ y : Bits N,
      star (Matrix.mulVec (circMatrix c) Φ y)
        * Matrix.mulVec (projOut out) (Matrix.mulVec (circMatrix c) Φ) y
      = ((if y out = true then
            ‖Matrix.mulVec (circMatrix c) Φ y‖ ^ 2 else 0 : ℝ) : ℂ) := by
    intro y
    rw [shiQma1_projMulVec]
    by_cases hy : y out = true
    · first
      | (rw [if_pos hy, if_pos hy]; exact shiQma1_conjMulSelf _)
      | (rw [if_pos hy]; rw [if_pos hy]; exact shiQma1_conjMulSelf _)
      | (simp only [if_pos hy]; exact shiQma1_conjMulSelf _)
    · first
      | (rw [if_neg hy, if_neg hy, mul_zero, Complex.ofReal_zero]; done)
      | (rw [if_neg hy]; rw [if_neg hy]; rw [mul_zero, Complex.ofReal_zero]; done)
      | (simp only [if_neg hy, mul_zero, Complex.ofReal_zero]; done)
  have hdotL : dotProduct (star (Matrix.mulVec (circMatrix c) Φ))
        (Matrix.mulVec (projOut out) (Matrix.mulVec (circMatrix c) Φ))
      = ((∑ y : Bits N,
            (if y out = true then
              ‖Matrix.mulVec (circMatrix c) Φ y‖ ^ 2 else 0) : ℝ) : ℂ) := by
    have hd : dotProduct (star (Matrix.mulVec (circMatrix c) Φ))
          (Matrix.mulVec (projOut out) (Matrix.mulVec (circMatrix c) Φ))
        = ∑ y : Bits N,
            star (Matrix.mulVec (circMatrix c) Φ y)
              * Matrix.mulVec (projOut out) (Matrix.mulVec (circMatrix c) Φ) y := by
      first
      | rfl
      | (simp only [dotProduct, Pi.star_apply]; done)
    rw [hd, Complex.ofReal_sum]
    exact Finset.sum_congr rfl (fun y _ => hentry y)
  rw [hacc, hdotR, halg, hdotL, Complex.ofReal_re]

/-! ### The registered statement -/

theorem _root_.QMAReferenceValidation.candidate7 {n : ℕ} (F : QMAFamily) (x : Bits n)
    (ψ : QState (F.wit n)) :
    F.acceptWith x ψ
      = (∑ y : Bits (n + (F.wit n + (F.anc n + 1))),
          (starRingEnd ℂ) (witnessInputState F x ψ y)
            * Matrix.mulVec
                (star (circMatrix (F.circ n)) * projOut (F.out n) * circMatrix (F.circ n))
                (witnessInputState F x ψ) y).re := by
  have hgen := shiQma1_general (F.circ n) (F.out n) (witnessInputState F x ψ)
  have hunf : F.acceptWith x ψ
      = ∑ y : Bits (n + (F.wit n + (F.anc n + 1))),
          (if y (F.out n) then
            ‖runLayered (F.circ n) (witnessInputState F x ψ) y‖ ^ 2 else 0) := by
    first
    | rfl
    | (simp only [QMAFamily.acceptWith]; done)
    | (unfold QMAFamily.acceptWith; done)
  rw [hunf]
  first
  | (exact hgen; done)
  | (exact hgen)

end QMAReferenceValidation.Source7

