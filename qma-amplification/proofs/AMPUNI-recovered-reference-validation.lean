    unless ← isDefEq (← inferType candidate) (← inferType target) do
      throwError "Recovered proof type differs from ShiClassQMAAmpX.ampFamilyX_semantically_eq_ampFamily"
    let info ← getConstInfo ``QMAReferenceValidation.candidate3
