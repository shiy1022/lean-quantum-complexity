/-!
# The three-copy wire embedding of the amplified register

Given the layout permutation `sigma` of `ShiShallow.exists_layout_bijection` and the three copy
embeddings `e1, e2, e3` that the amplifier structure theorem produces, this file builds the
SINGLE embedding

  `e : Fin (M + M + M) -> Fin (n + (wit' + (anc' + 1)))`,   `M = n + (wit + (anc + 1))`

of the three-block register into the amplified register, and establishes the five facts a
consumer needs in order to rewrite `runLayered (E1 ++ E2 ++ E3)` as
`runLayered (embedCirc e he C3)` and then to identify `ShiSpread.spread e`:

* `Function.Injective e`;
* `e` restricted to the three blocks is `e1`, `e2`, `e3`;
* the image of `e` is the complement of the SINGLE wire `(T F).out n`;
* and the twelve ROLE identities: where each copy's input, witness and ancilla/output wires
  land in the amplified register.  Copy 2's and copy 3's input wires land exactly on the
  fan-out target wires `p j` and `q j`, which is the compatibility the state identity needs.

## Why the embedding is NOT `fun v => sigma (Fin.mk v.val _)`

`T` is an ABSTRACT transform here: `(T F).wit n` and `(T F).anc n` are opaque terms tied to
`3 * F.wit n` and `2 * n + 3 * F.anc n + 3` only PROPOSITIONALLY, by `hwit`/`hanc`.  But
`sigma` has codomain `Fin (n + (3 * F.wit n + ((2 * n + 3 * F.anc n + 3) + 1)))` while `e1`,
`e2`, `e3` and the required `e` have codomain `Fin (n + ((T F).wit n + ((T F).anc n + 1)))`.
Those are DIFFERENT types -- equal only up to a propositional equality of widths -- so
`sigma (Fin.mk v.val _)` does not even typecheck as a candidate for `e`, and inserting a
`Fin.cast` would put a cast into the statement that every consumer would then have to carry.

The embedding is therefore assembled from `e1`, `e2`, `e3` themselves by `.val` arithmetic
(`shiPf_idx`/`shiPf_blk`/`shiPf_e`), and every fact about it is proved by transporting `.val`
equations: `sigma` is used only through the `.val` clauses supplied as hypotheses, never as a
function into the amplified register.  NO `Fin.cast` and NO width-cast isometry is needed
anywhere in this file.

## What is NOT here

The state identity itself -- that the prefix `fan2 ++ fan3 ++ E1 ++ E2 ++ E3` carries
`witnessInputState (T F) x Psi` to `ShiSpread.spread e (runLayered C3 chi)` -- is N3b and is
NOT proved here.  This file is its `Fin`-level input.
-/

open ShiShallow ShiSpread

/-! ### Generic transport helpers -/

/-- Chain a `.val` equation through the layout map to identify two wires. -/
private theorem shiPf_wire {R C r : ℕ} {x k : Fin R} {y : Fin C}
    (h1 : x.val = y.val) (h2 : y.val = r) (h3 : k.val = r) : x = k :=
  Fin.val_injective (h1.trans (h2.trans h3.symm))

/-- Injectivity of a bijection, read off at the level of `.val`. -/
private theorem shiPf_bij_val {NS C : ℕ} {f : Fin NS → Fin C} (hf : Function.Bijective f)
    {s t : Fin NS} (h : (f s).val = (f t).val) : s.val = t.val :=
  congrArg Fin.val (hf.injective (Fin.val_injective h))

/-- Read a `.val` equation off an equation with an explicit `Fin.mk`.  Stated so that the
right-hand side is the bare natural `c`, which `omega` can use as an atom -- `omega` does not
reduce the projection `(Fin.mk c h).val`. -/
private theorem shiPf_mk_val {N : ℕ} {x : Fin N} {c : ℕ} (h : c < N) (hx : x = ⟨c, h⟩) :
    x.val = c :=
  congrArg Fin.val hx

/-! ### The three-block index map -/

/-- The within-block index of a three-block position. -/
private def shiPf_idx (M k : ℕ) : ℕ :=
  if k < M then k else if k < M + M then k - M else k - M - M

private theorem shiPf_idx_lt (M k : ℕ) (h : k < M + M + M) : shiPf_idx M k < M := by
  simp only [shiPf_idx]
  split_ifs <;> omega

/-- The within-block index, as an element of `Fin M`. -/
private def shiPf_blk {M : ℕ} (v : Fin (M + M + M)) : Fin M :=
  ⟨shiPf_idx M v.val, shiPf_idx_lt M v.val v.isLt⟩

/-- The three-block embedding assembled from the three copy embeddings.  Defined by `.val`
arithmetic, so it needs no `Fin.cast` and no `Fin.addCases`. -/
private def shiPf_e {M R : ℕ} (e1 e2 e3 : Fin M → Fin R) (v : Fin (M + M + M)) : Fin R :=
  if v.val < M then e1 (shiPf_blk v)
  else if v.val < M + M then e2 (shiPf_blk v) else e3 (shiPf_blk v)

private theorem shiPf_e_b1 {M R : ℕ} (e1 e2 e3 : Fin M → Fin R) (v : Fin (M + M + M))
    (h : v.val < M) : shiPf_e e1 e2 e3 v = e1 (shiPf_blk v) := by
  show (if v.val < M then e1 (shiPf_blk v)
      else if v.val < M + M then e2 (shiPf_blk v) else e3 (shiPf_blk v))
    = e1 (shiPf_blk v)
  exact if_pos h

private theorem shiPf_e_b2 {M R : ℕ} (e1 e2 e3 : Fin M → Fin R) (v : Fin (M + M + M))
    (h1 : ¬ (v.val < M)) (h2 : v.val < M + M) :
    shiPf_e e1 e2 e3 v = e2 (shiPf_blk v) := by
  show (if v.val < M then e1 (shiPf_blk v)
      else if v.val < M + M then e2 (shiPf_blk v) else e3 (shiPf_blk v))
    = e2 (shiPf_blk v)
  rw [if_neg h1, if_pos h2]

private theorem shiPf_e_b3 {M R : ℕ} (e1 e2 e3 : Fin M → Fin R) (v : Fin (M + M + M))
    (h1 : ¬ (v.val < M)) (h2 : ¬ (v.val < M + M)) :
    shiPf_e e1 e2 e3 v = e3 (shiPf_blk v) := by
  show (if v.val < M then e1 (shiPf_blk v)
      else if v.val < M + M then e2 (shiPf_blk v) else e3 (shiPf_blk v))
    = e3 (shiPf_blk v)
  rw [if_neg h1, if_neg h2]

/-! ### `e` restricted to the three blocks -/

private theorem shiPf_e_i1 {M R : ℕ} (e1 e2 e3 : Fin M → Fin R) (v : Fin M) :
    shiPf_e e1 e2 e3 (Fin.castAdd M (Fin.castAdd M v)) = e1 v := by
  have hlt := v.isLt
  have hv : (Fin.castAdd M (Fin.castAdd M v) : Fin (M + M + M)).val = v.val := rfl
  have h1 : (Fin.castAdd M (Fin.castAdd M v) : Fin (M + M + M)).val < M := by
    rw [hv]; exact hlt
  have hb : shiPf_blk (Fin.castAdd M (Fin.castAdd M v) : Fin (M + M + M)) = v := by
    apply Fin.val_injective
    show shiPf_idx M (Fin.castAdd M (Fin.castAdd M v) : Fin (M + M + M)).val = v.val
    rw [hv]
    simp only [shiPf_idx]
    split_ifs <;> omega
  exact (shiPf_e_b1 e1 e2 e3 _ h1).trans (congrArg e1 hb)

private theorem shiPf_e_i2 {M R : ℕ} (e1 e2 e3 : Fin M → Fin R) (v : Fin M) :
    shiPf_e e1 e2 e3 (Fin.castAdd M (Fin.natAdd M v)) = e2 v := by
  have hlt := v.isLt
  have hv : (Fin.castAdd M (Fin.natAdd M v) : Fin (M + M + M)).val = M + v.val := rfl
  have h1 : ¬ ((Fin.castAdd M (Fin.natAdd M v) : Fin (M + M + M)).val < M) := by
    rw [hv]; omega
  have h2 : (Fin.castAdd M (Fin.natAdd M v) : Fin (M + M + M)).val < M + M := by
    rw [hv]; omega
  have hb : shiPf_blk (Fin.castAdd M (Fin.natAdd M v) : Fin (M + M + M)) = v := by
    apply Fin.val_injective
    show shiPf_idx M (Fin.castAdd M (Fin.natAdd M v) : Fin (M + M + M)).val = v.val
    rw [hv]
    simp only [shiPf_idx]
    split_ifs <;> omega
  exact (shiPf_e_b2 e1 e2 e3 _ h1 h2).trans (congrArg e2 hb)

private theorem shiPf_e_i3 {M R : ℕ} (e1 e2 e3 : Fin M → Fin R) (v : Fin M) :
    shiPf_e e1 e2 e3 (Fin.natAdd (M + M) v) = e3 v := by
  have hlt := v.isLt
  have hv : (Fin.natAdd (M + M) v : Fin (M + M + M)).val = M + M + v.val := rfl
  have h1 : ¬ ((Fin.natAdd (M + M) v : Fin (M + M + M)).val < M) := by
    rw [hv]; omega
  have h2 : ¬ ((Fin.natAdd (M + M) v : Fin (M + M + M)).val < M + M) := by
    rw [hv]; omega
  have hb : shiPf_blk (Fin.natAdd (M + M) v : Fin (M + M + M)) = v := by
    apply Fin.val_injective
    show shiPf_idx M (Fin.natAdd (M + M) v : Fin (M + M + M)).val = v.val
    rw [hv]
    simp only [shiPf_idx]
    split_ifs <;> omega
  exact (shiPf_e_b3 e1 e2 e3 _ h1 h2).trans (congrArg e3 hb)

/-! ### The layout transport law for `e`

This single lemma carries injectivity AND the off-image characterisation: it says that `e`
agrees with the layout map on positions, at the level of `.val`, with no reference to the
amplified register's width. -/

private theorem shiPf_e_val {M R NS C : ℕ} (e1 e2 e3 : Fin M → Fin R) {σ : Fin NS → Fin C}
    (hE1 : ∀ (v : Fin M) (u : Fin NS), u.val = v.val → (e1 v).val = (σ u).val)
    (hE2 : ∀ (v : Fin M) (u : Fin NS), u.val = M + v.val → (e2 v).val = (σ u).val)
    (hE3 : ∀ (v : Fin M) (u : Fin NS), u.val = 2 * M + v.val → (e3 v).val = (σ u).val)
    (v : Fin (M + M + M)) (u : Fin NS) (hu : u.val = v.val) :
    (shiPf_e e1 e2 e3 v).val = (σ u).val := by
  have hvlt := v.isLt
  by_cases g1 : v.val < M
  · refine (congrArg Fin.val (shiPf_e_b1 e1 e2 e3 v g1)).trans (hE1 (shiPf_blk v) u ?_)
    show u.val = shiPf_idx M v.val
    simp only [shiPf_idx]
    split_ifs <;> omega
  · by_cases g2 : v.val < M + M
    · refine (congrArg Fin.val (shiPf_e_b2 e1 e2 e3 v g1 g2)).trans (hE2 (shiPf_blk v) u ?_)
      show u.val = M + shiPf_idx M v.val
      simp only [shiPf_idx]
      split_ifs <;> omega
    · refine (congrArg Fin.val (shiPf_e_b3 e1 e2 e3 v g1 g2)).trans (hE3 (shiPf_blk v) u ?_)
      show u.val = 2 * M + shiPf_idx M v.val
      simp only [shiPf_idx]
      split_ifs <;> omega

/-! ### The deliverable -/

theorem _root_.QMAReferenceValidation.candidate11 (T : ShiClassQMA.QMAFamily → ShiClassQMA.QMAFamily)
    (hwit : ∀ (F : ShiClassQMA.QMAFamily) (n : ℕ), (T F).wit n = 3 * F.wit n)
    (hanc : ∀ (F : ShiClassQMA.QMAFamily) (n : ℕ), (T F).anc n = 2 * n + 3 * F.anc n + 3)
    (hout : ∀ (F : ShiClassQMA.QMAFamily) (n : ℕ),
        ((T F).out n).val = 3 * n + 3 * F.wit n + 3 * F.anc n + 3) :
    ∀ (F : ShiClassQMA.QMAFamily) (n : ℕ)
      (σ : Fin (3 * (n + (F.wit n + (F.anc n + 1))) + 1) → Fin (n + (3 * F.wit n + ((2 * n + 3 * F.anc n + 3) + 1))))
      (p q : Fin n → Fin ((T F).anc n + 1))
      (e1 e2 e3 : Fin (n + (F.wit n + (F.anc n + 1))) → Fin (n + ((T F).wit n + ((T F).anc n + 1)))),
      σ = Classical.choose (ShiShallow.exists_layout_bijection n (F.wit n) (F.anc n)) →
      (∀ (v : Fin (n + (F.wit n + (F.anc n + 1)))) (u : Fin (3 * (n + (F.wit n + (F.anc n + 1))) + 1)),
          u.val = v.val → (e1 v).val = (σ u).val) →
      (∀ (v : Fin (n + (F.wit n + (F.anc n + 1)))) (u : Fin (3 * (n + (F.wit n + (F.anc n + 1))) + 1)),
          u.val = n + (F.wit n + (F.anc n + 1)) + v.val → (e2 v).val = (σ u).val) →
      (∀ (v : Fin (n + (F.wit n + (F.anc n + 1)))) (u : Fin (3 * (n + (F.wit n + (F.anc n + 1))) + 1)),
          u.val = 2 * (n + (F.wit n + (F.anc n + 1))) + v.val → (e3 v).val = (σ u).val) →
      (∀ j : Fin n, (p j).val = F.anc n + 1 + j.val) →
      (∀ j : Fin n, (q j).val = n + 2 * F.anc n + 2 + j.val) →
      ∃ e : Fin (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1))) + (n + (F.wit n + (F.anc n + 1)))) → Fin (n + ((T F).wit n + ((T F).anc n + 1))),
        Function.Injective e
        ∧ (∀ v : Fin (n + (F.wit n + (F.anc n + 1))),
            e (Fin.castAdd (n + (F.wit n + (F.anc n + 1))) (Fin.castAdd (n + (F.wit n + (F.anc n + 1))) v)) = e1 v)
        ∧ (∀ v : Fin (n + (F.wit n + (F.anc n + 1))),
            e (Fin.castAdd (n + (F.wit n + (F.anc n + 1))) (Fin.natAdd (n + (F.wit n + (F.anc n + 1))) v)) = e2 v)
        ∧ (∀ v : Fin (n + (F.wit n + (F.anc n + 1))),
            e (Fin.natAdd (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1)))) v) = e3 v)
        ∧ (∀ k : Fin (n + ((T F).wit n + ((T F).anc n + 1))), ShiSpread.OffImage e k ↔ k = (T F).out n)
        ∧ (∀ i : Fin n, e1 (Fin.castAdd (F.wit n + (F.anc n + 1)) i)
            = Fin.castAdd ((T F).wit n + ((T F).anc n + 1)) i)
        ∧ (∀ j : Fin n, e2 (Fin.castAdd (F.wit n + (F.anc n + 1)) j)
            = Fin.natAdd n (Fin.natAdd ((T F).wit n) (p j)))
        ∧ (∀ j : Fin n, e3 (Fin.castAdd (F.wit n + (F.anc n + 1)) j)
            = Fin.natAdd n (Fin.natAdd ((T F).wit n) (q j)))
        ∧ (∀ (j : Fin (F.wit n)) (j' : Fin ((T F).wit n)), j'.val = j.val →
            e1 (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))
              = Fin.natAdd n (Fin.castAdd ((T F).anc n + 1) j'))
        ∧ (∀ (j : Fin (F.wit n)) (j' : Fin ((T F).wit n)), j'.val = F.wit n + j.val →
            e2 (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))
              = Fin.natAdd n (Fin.castAdd ((T F).anc n + 1) j'))
        ∧ (∀ (j : Fin (F.wit n)) (j' : Fin ((T F).wit n)), j'.val = 2 * F.wit n + j.val →
            e3 (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))
              = Fin.natAdd n (Fin.castAdd ((T F).anc n + 1) j'))
        ∧ (∀ (l : Fin (F.anc n + 1)) (l' : Fin ((T F).anc n + 1)), l'.val = l.val →
            e1 (Fin.natAdd n (Fin.natAdd (F.wit n) l))
              = Fin.natAdd n (Fin.natAdd ((T F).wit n) l'))
        ∧ (∀ (l : Fin (F.anc n + 1)) (l' : Fin ((T F).anc n + 1)),
            l'.val = n + F.anc n + 1 + l.val →
            e2 (Fin.natAdd n (Fin.natAdd (F.wit n) l))
              = Fin.natAdd n (Fin.natAdd ((T F).wit n) l'))
        ∧ (∀ (l : Fin (F.anc n + 1)) (l' : Fin ((T F).anc n + 1)),
            l'.val = 2 * n + 2 * F.anc n + 2 + l.val →
            e3 (Fin.natAdd n (Fin.natAdd (F.wit n) l))
              = Fin.natAdd n (Fin.natAdd ((T F).wit n) l')) := by
  intro F n σ p q e1 e2 e3 hσdef hE1 hE2 hE3 hp hq
  subst hσdef
  obtain ⟨hbij, hc1, hc2, hc3, hc4, hc5, hc6, hc7, hc8, hc9, hc10, hc11, hc12, hc13⟩ :=
    Classical.choose_spec (ShiShallow.exists_layout_bijection n (F.wit n) (F.anc n))
  have hW : (T F).wit n = 3 * F.wit n := hwit F n
  have hA : (T F).anc n = 2 * n + 3 * F.anc n + 3 := hanc F n
  have hO : ((T F).out n).val = 3 * n + 3 * F.wit n + 3 * F.anc n + 3 := hout F n
  have hscr : 3 * (n + (F.wit n + (F.anc n + 1))) < 3 * (n + (F.wit n + (F.anc n + 1))) + 1 := by omega
  have hscrval := hc13 ⟨3 * (n + (F.wit n + (F.anc n + 1))), hscr⟩ rfl
  refine ⟨shiPf_e e1 e2 e3, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  -- (1) injectivity, from injectivity of the layout permutation
  · intro x y hxy
    have hx := x.isLt
    have hy := y.isLt
    have ux : x.val < 3 * (n + (F.wit n + (F.anc n + 1))) + 1 := by omega
    have uy : y.val < 3 * (n + (F.wit n + (F.anc n + 1))) + 1 := by omega
    have h1 := shiPf_e_val e1 e2 e3 hE1 hE2 hE3 x ⟨x.val, ux⟩ rfl
    have h2 := shiPf_e_val e1 e2 e3 hE1 hE2 hE3 y ⟨y.val, uy⟩ rfl
    have h3 : (shiPf_e e1 e2 e3 x).val = (shiPf_e e1 e2 e3 y).val := congrArg Fin.val hxy
    have h4 : x.val = y.val :=
      shiPf_bij_val hbij (s := ⟨x.val, ux⟩) (t := ⟨y.val, uy⟩) (by omega)
    exact Fin.val_injective h4
  -- (2)(3)(4) the three blocks
  · exact shiPf_e_i1 e1 e2 e3
  · exact shiPf_e_i2 e1 e2 e3
  · exact shiPf_e_i3 e1 e2 e3
  -- (5) the image of `e` is the complement of the single wire `(T F).out n`
  · intro k
    constructor
    · intro hk
      by_contra hne
      have hk' : ∀ i, shiPf_e e1 e2 e3 i ≠ k := hk
      have hk2 := k.isLt
      have hklt : k.val < n + (3 * F.wit n + ((2 * n + 3 * F.anc n + 3) + 1)) := by omega
      obtain ⟨u, hu⟩ := hbij.surjective (⟨k.val, hklt⟩ : Fin (n + (3 * F.wit n + ((2 * n + 3 * F.anc n + 3) + 1))))
      have huv := shiPf_mk_val hklt hu
      have hult := u.isLt
      by_cases hu3 : u.val = 3 * (n + (F.wit n + (F.anc n + 1)))
      · have hsv := hc13 u hu3
        exact hne (Fin.val_injective (by omega))
      · have hlt2 : u.val < n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1))) + (n + (F.wit n + (F.anc n + 1))) := by omega
        have h9 := shiPf_e_val e1 e2 e3 hE1 hE2 hE3 ⟨u.val, hlt2⟩ u rfl
        exact hk' ⟨u.val, hlt2⟩ (Fin.val_injective (by omega))
    · intro hk
      show ∀ i, shiPf_e e1 e2 e3 i ≠ k
      intro v hcon
      have hvlt := v.isLt
      have hu : v.val < 3 * (n + (F.wit n + (F.anc n + 1))) + 1 := by omega
      have h1 := shiPf_e_val e1 e2 e3 hE1 hE2 hE3 v ⟨v.val, hu⟩ rfl
      have h2 : (shiPf_e e1 e2 e3 v).val = ((T F).out n).val :=
        congrArg Fin.val (hcon.trans hk)
      have h5 : v.val = 3 * (n + (F.wit n + (F.anc n + 1))) :=
        shiPf_bij_val hbij (s := ⟨v.val, hu⟩) (t := ⟨3 * (n + (F.wit n + (F.anc n + 1))), hscr⟩) (by omega)
      omega
  -- (6) copy 1's input wires are the amplified register's input wires
  · intro i
    have hi := i.isLt
    have hu : i.val < 3 * (n + (F.wit n + (F.anc n + 1))) + 1 := by omega
    exact shiPf_wire
      (hE1 (Fin.castAdd (F.wit n + (F.anc n + 1)) i) ⟨i.val, hu⟩ rfl)
      (hc1 ⟨i.val, hu⟩ i.val hi rfl) rfl
  -- (7) copy 2's input wires are the fan-out targets `p j`
  · intro j
    have hj := j.isLt
    have hpj := hp j
    have hu : n + (F.wit n + (F.anc n + 1)) + j.val < 3 * (n + (F.wit n + (F.anc n + 1))) + 1 := by omega
    refine shiPf_wire
      (hE2 (Fin.castAdd (F.wit n + (F.anc n + 1)) j) ⟨n + (F.wit n + (F.anc n + 1)) + j.val, hu⟩ rfl)
      (hc5 ⟨n + (F.wit n + (F.anc n + 1)) + j.val, hu⟩ j.val hj rfl) ?_
    show n + ((T F).wit n + (p j).val) = n + 3 * F.wit n + F.anc n + 1 + j.val
    omega
  -- (8) copy 3's input wires are the fan-out targets `q j`
  · intro j
    have hj := j.isLt
    have hqj := hq j
    have hu : 2 * (n + (F.wit n + (F.anc n + 1))) + j.val < 3 * (n + (F.wit n + (F.anc n + 1))) + 1 := by omega
    refine shiPf_wire
      (hE3 (Fin.castAdd (F.wit n + (F.anc n + 1)) j) ⟨2 * (n + (F.wit n + (F.anc n + 1))) + j.val, hu⟩ rfl)
      (hc9 ⟨2 * (n + (F.wit n + (F.anc n + 1))) + j.val, hu⟩ j.val hj rfl) ?_
    show n + ((T F).wit n + (q j).val) = 2 * n + 3 * F.wit n + 2 * F.anc n + 2 + j.val
    omega
  -- (9) copy 1's witness wires: witness block, offset 0
  · intro j j' hj'
    have hj := j.isLt
    have hu : n + j.val < 3 * (n + (F.wit n + (F.anc n + 1))) + 1 := by omega
    refine shiPf_wire
      (hE1 (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j)) ⟨n + j.val, hu⟩ rfl)
      (hc2 ⟨n + j.val, hu⟩ j.val hj rfl) ?_
    show n + j'.val = n + j.val
    omega
  -- (10) copy 2's witness wires: witness block, offset `F.wit n`
  · intro j j' hj'
    have hj := j.isLt
    have hu : n + (F.wit n + (F.anc n + 1)) + n + j.val < 3 * (n + (F.wit n + (F.anc n + 1))) + 1 := by omega
    have hoff : n + (F.wit n + (F.anc n + 1)) + n + j.val = n + (F.wit n + (F.anc n + 1)) + (n + j.val) := by omega
    refine shiPf_wire
      (hE2 (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j)) ⟨n + (F.wit n + (F.anc n + 1)) + n + j.val, hu⟩ hoff)
      (hc6 ⟨n + (F.wit n + (F.anc n + 1)) + n + j.val, hu⟩ j.val hj rfl) ?_
    show n + j'.val = n + F.wit n + j.val
    omega
  -- (11) copy 3's witness wires: witness block, offset `2 * F.wit n`
  · intro j j' hj'
    have hj := j.isLt
    have hu : 2 * (n + (F.wit n + (F.anc n + 1))) + n + j.val < 3 * (n + (F.wit n + (F.anc n + 1))) + 1 := by omega
    have hoff : 2 * (n + (F.wit n + (F.anc n + 1))) + n + j.val = 2 * (n + (F.wit n + (F.anc n + 1))) + (n + j.val) := by omega
    refine shiPf_wire
      (hE3 (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j)) ⟨2 * (n + (F.wit n + (F.anc n + 1))) + n + j.val, hu⟩ hoff)
      (hc10 ⟨2 * (n + (F.wit n + (F.anc n + 1))) + n + j.val, hu⟩ j.val hj rfl) ?_
    show n + j'.val = n + 2 * F.wit n + j.val
    omega
  -- (12) copy 1's ancilla AND output wires: role ancilla block, offset 0
  · intro l l' hl'
    have hl := l.isLt
    have hu : n + F.wit n + l.val < 3 * (n + (F.wit n + (F.anc n + 1))) + 1 := by omega
    have hoff : n + F.wit n + l.val = n + (F.wit n + l.val) := by omega
    rcases Nat.lt_or_ge l.val (F.anc n) with hlt | hge
    · refine shiPf_wire
        (hE1 (Fin.natAdd n (Fin.natAdd (F.wit n) l)) ⟨n + F.wit n + l.val, hu⟩ hoff)
        (hc3 ⟨n + F.wit n + l.val, hu⟩ l.val hlt rfl) ?_
      show n + ((T F).wit n + l'.val) = n + 3 * F.wit n + l.val
      omega
    · have hcv : n + F.wit n + l.val = n + F.wit n + F.anc n := by omega
      refine shiPf_wire
        (hE1 (Fin.natAdd n (Fin.natAdd (F.wit n) l)) ⟨n + F.wit n + l.val, hu⟩ hoff)
        (hc4 ⟨n + F.wit n + l.val, hu⟩ hcv) ?_
      show n + ((T F).wit n + l'.val) = n + 3 * F.wit n + F.anc n
      omega
  -- (13) copy 2's ancilla AND output wires: role ancilla block, offset `n + anc + 1`
  · intro l l' hl'
    have hl := l.isLt
    have hu : n + (F.wit n + (F.anc n + 1)) + n + F.wit n + l.val < 3 * (n + (F.wit n + (F.anc n + 1))) + 1 := by omega
    have hoff : n + (F.wit n + (F.anc n + 1)) + n + F.wit n + l.val = n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + l.val)) := by omega
    rcases Nat.lt_or_ge l.val (F.anc n) with hlt | hge
    · refine shiPf_wire
        (hE2 (Fin.natAdd n (Fin.natAdd (F.wit n) l))
          ⟨n + (F.wit n + (F.anc n + 1)) + n + F.wit n + l.val, hu⟩ hoff)
        (hc7 ⟨n + (F.wit n + (F.anc n + 1)) + n + F.wit n + l.val, hu⟩ l.val hlt rfl) ?_
      show n + ((T F).wit n + l'.val) = 2 * n + 3 * F.wit n + F.anc n + 1 + l.val
      omega
    · have hcv : n + (F.wit n + (F.anc n + 1)) + n + F.wit n + l.val = n + (F.wit n + (F.anc n + 1)) + n + F.wit n + F.anc n := by omega
      refine shiPf_wire
        (hE2 (Fin.natAdd n (Fin.natAdd (F.wit n) l))
          ⟨n + (F.wit n + (F.anc n + 1)) + n + F.wit n + l.val, hu⟩ hoff)
        (hc8 ⟨n + (F.wit n + (F.anc n + 1)) + n + F.wit n + l.val, hu⟩ hcv) ?_
      show n + ((T F).wit n + l'.val) = 2 * n + 3 * F.wit n + 2 * F.anc n + 1
      omega
  -- (14) copy 3's ancilla AND output wires: role ancilla block, offset `2 * n + 2 * anc + 2`
  · intro l l' hl'
    have hl := l.isLt
    have hu : 2 * (n + (F.wit n + (F.anc n + 1))) + n + F.wit n + l.val < 3 * (n + (F.wit n + (F.anc n + 1))) + 1 := by omega
    have hoff : 2 * (n + (F.wit n + (F.anc n + 1))) + n + F.wit n + l.val
        = 2 * (n + (F.wit n + (F.anc n + 1))) + (n + (F.wit n + l.val)) := by omega
    rcases Nat.lt_or_ge l.val (F.anc n) with hlt | hge
    · refine shiPf_wire
        (hE3 (Fin.natAdd n (Fin.natAdd (F.wit n) l))
          ⟨2 * (n + (F.wit n + (F.anc n + 1))) + n + F.wit n + l.val, hu⟩ hoff)
        (hc11 ⟨2 * (n + (F.wit n + (F.anc n + 1))) + n + F.wit n + l.val, hu⟩ l.val hlt rfl) ?_
      show n + ((T F).wit n + l'.val) = 3 * n + 3 * F.wit n + 2 * F.anc n + 2 + l.val
      omega
    · have hcv : 2 * (n + (F.wit n + (F.anc n + 1))) + n + F.wit n + l.val
          = 2 * (n + (F.wit n + (F.anc n + 1))) + n + F.wit n + F.anc n := by omega
      refine shiPf_wire
        (hE3 (Fin.natAdd n (Fin.natAdd (F.wit n) l))
          ⟨2 * (n + (F.wit n + (F.anc n + 1))) + n + F.wit n + l.val, hu⟩ hoff)
        (hc12 ⟨2 * (n + (F.wit n + (F.anc n + 1))) + n + F.wit n + l.val, hu⟩ hcv) ?_
