/-!
# The prefix state identity

The amplified circuit's prefix is `fan2 ++ fan3 ++ E1 ++ E2 ++ E3`: two fan-out blocks that
copy the classical input onto copy 2's and copy 3's input wires, then the three embedded
copies of `F.circ n`.  This file shows that the prefix carries
`ShiClassQMA.witnessInputState (T F) x Ψ` to `ShiSpread.spread e (runLayered C3 χ)`, where `e`
is the three-block embedding of `ShiClassQMA.exists_amplifier_three_block_embedding`, `C3` the
canonical three-block circuit of `ShiTensor.runLayered_embed_three_blocks`, and `χ` the explicit
three-copy state written out in the statement.

## How the four joints meet

1. **Fan-out.** `ShiClassQMA.fanout_replicates_input_across_copies` already turns
   `runLayered (fan2 ++ fan3) (witnessInputState (T F) x Ψ)` into a single `if`, whose guard is
   "input reads `x`, the `p`-wires read `x`, the `q`-wires read `x`, and every OTHER role ancilla
   wire is `0`", with amplitude `Ψ` at the role witness block.  Nothing about `u2`/`u3` is
   re-derived here.
2. **Guard.** That guard is equivalent to `Y out = false` together with the THREE copy guards of
   `witnessInputState` read through `e1`, `e2`, `e3` -- which is exactly `spread`'s off-image
   condition together with `χ`'s own `ok ∧ ok ∧ ok`.  The equivalence is the ancilla-index
   partition
   `[0,a] ⊎ [a+1,a+n] ⊎ [n+a+1,n+2a+1] ⊎ [n+2a+2,2n+2a+1] ⊎ [2n+2a+2,2n+3a+2] ⊎ {2n+3a+3}`,
   totalling `2n+3a+4 = (T F).anc n + 1`, with the single leftover index `(T F).anc n` being the
   output wire.  The two `p`/`q` ranges are VACUOUS in the backward direction, because the
   fan-out theorem's guard already excludes them by hypothesis.
3. **Amplitude.** The role witness block splits into the three copies' witness blocks, which is
   exactly `χ`'s dependent-`if` assembly map read backwards.
4. **Circuit.** `E1 ++ E2 ++ E3 = ShiEmbed.embedCirc e he C3`, by `embedCirc`'s `++`
   distribution and composition laws plus `e ∘ ι_i = e_i` from
   `exists_amplifier_three_block_embedding`; then `ShiSpread.runLayered_embedCirc_spread`.

`Ψ` is ARBITRARY throughout: it is applied to one assembled `Bits ((T F).wit n)` and is never
factored as a product of three copies.  `σ` is touched ONLY through the `.val` clauses, which are
passed straight to `exists_amplifier_three_block_embedding`.
-/

open ShiShallow

/-! ### Generic helpers -/

/-- Distinct `.val`s give distinct wires. -/
private theorem shiPf_ne_of_val {N : ℕ} {u v : Fin N} (h : u.val ≠ v.val) : u ≠ v :=
  fun he => h (congrArg Fin.val he)

/-- `runLayered` splits over `++` because it is a `List.foldl`. -/
private theorem shiPf_append {N : ℕ} (c d : Layered N) (ψ : QState N) :
    runLayered (c ++ d) ψ = runLayered d (runLayered c ψ) := by
  show (c ++ d).foldl (fun st l => runLayer l st) ψ
      = d.foldl (fun st l => runLayer l st) (c.foldl (fun st l => runLayer l st) ψ)
  exact List.foldl_append

/-- Congruence for `runLayered` in the state argument. -/
private theorem shiPf_runLayered_congr {N : ℕ} (c : Layered N) {ψ φ : QState N} (h : ψ = φ) :
    runLayered c ψ = runLayered c φ :=
  congrArg _ h

/-- Both branches of a `dite` give the same value. -/
private theorem shiPf_dite_eq {α : Sort _} {c : Prop} [Decidable c] {t : c → α} {e : ¬c → α}
    {r : α} (h1 : ∀ hc : c, t hc = r) (h2 : ∀ hn : ¬c, e hn = r) : dite c t e = r := by
  by_cases hc : c
  · rw [dif_pos hc]; exact h1 hc
  · rw [dif_neg hc]; exact h2 hc

/-- The whole final assembly: a single guard on the left against a NESTED guard on the right,
with the two amplitudes equal.  Both zero branches are literally `0`. -/
private theorem shiPf_ite3 {P Q R : Prop} [Decidable P] [Decidable Q] [Decidable R] {A B : ℂ}
    (hPQR : P ↔ (Q ∧ R)) (hAB : A = B) :
    (if P then A else 0) = (if Q then (if R then B else 0) else 0) := by
  by_cases hQ : Q
  · by_cases hR : R
    · rw [if_pos hQ, if_pos hR, if_pos (hPQR.mpr ⟨hQ, hR⟩), hAB]
    · rw [if_pos hQ, if_neg hR, if_neg (fun hP => hR (hPQR.mp hP).2)]
  · rw [if_neg hQ, if_neg (fun hP => hQ (hPQR.mp hP).1)]

/-- Replace the wire map of an `embedCirc` along an equation, carrying the dependent
injectivity proof by `subst` rather than by rewriting at the function slot. -/
private theorem shiPf_embedCirc_congr {m N : ℕ} {f g : Fin m → Fin N}
    (hf : Function.Injective f) (hg : Function.Injective g) (h : f = g) (c : Layered m) :
    ShiEmbed.embedCirc f hf c = ShiEmbed.embedCirc g hg c := by
  subst h
  rfl

