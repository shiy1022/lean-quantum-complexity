-- Well-formedness of the threefold amplifier, for the CURRENT (pullback fan-out) shape.
--
-- `ShiBQP.WellFormed F := fun F => forall n, forall l in F.circ n, LayerOk l`
-- (Def_ShiBQP_Core.lean:132), so the entire content is: every layer of the
-- concatenation is `LayerOk`.  The pullback fan-out carries its own `LayerOk`
-- (fourth conjunct of `exists_fanout_embedded_pullback`), reached through a DOUBLE
-- `Classical.choose_spec`, so no fan-out-specific closure lemma is needed.

set_option autoImplicit false

open ShiShallow ShiClassQMA

theorem _root_.QMAReferenceValidation.candidate17 (T : ShiClassQMA.QMAFamily → ShiClassQMA.QMAFamily)
    (hcirc : ∀ (F : ShiClassQMA.QMAFamily) (n : ℕ),
      ∃ (g2 g3 : Fin (n + n) → Fin (n + ((T F).wit n + ((T F).anc n + 1))))
        (e1 e2 e3 : Fin (n + (F.wit n + (F.anc n + 1)))
          → Fin (n + ((T F).wit n + ((T F).anc n + 1))))
        (rd fan2 fan3 : ShiShallow.Layered (n + ((T F).wit n + ((T F).anc n + 1))))
        (hg2 : Function.Injective g2) (hg3 : Function.Injective g3)
        (he1 : Function.Injective e1) (he2 : Function.Injective e2)
        (he3 : Function.Injective e3),
        fan2 = Classical.choose (ShiShallow.exists_fanout_embedded_pullback n
                 (n + ((T F).wit n + ((T F).anc n + 1))) g2 hg2)
        ∧ fan3 = Classical.choose (ShiShallow.exists_fanout_embedded_pullback n
                 (n + ((T F).wit n + ((T F).anc n + 1))) g3 hg3)
        ∧ (T F).circ n
            = fan2 ++ fan3
              ++ ShiEmbed.embedCirc e1 he1 (F.circ n)
              ++ ShiEmbed.embedCirc e2 he2 (F.circ n)
              ++ ShiEmbed.embedCirc e3 he3 (F.circ n) ++ rd
        ∧ (∀ l ∈ rd, ShiShallow.LayerOk l)) :
    ∀ F : ShiClassQMA.QMAFamily,
      ShiBQP.WellFormed F.toFamily → ShiBQP.WellFormed (T F).toFamily := by
  intro F hF n l hl
  obtain ⟨g2, g3, e1, e2, e3, rd, fan2, fan3, hg2, hg3, he1, he2, he3,
    hf2, hf3, heq, hrd⟩ := hcirc F n
  -- the source family's layers are `LayerOk`
  have hFn : ∀ l ∈ F.circ n, ShiShallow.LayerOk l := hF n
  -- `LayerOk` for the two pullback fan-out blocks, via a DOUBLE `Classical.choose_spec`
  have hspec2 :=
    Classical.choose_spec (Classical.choose_spec (ShiShallow.exists_fanout_embedded_pullback n
      (n + ((T F).wit n + ((T F).anc n + 1))) g2 hg2))
  have hspec3 :=
    Classical.choose_spec (Classical.choose_spec (ShiShallow.exists_fanout_embedded_pullback n
      (n + ((T F).wit n + ((T F).anc n + 1))) g3 hg3))
  have hfan2 : ∀ l ∈ fan2, ShiShallow.LayerOk l := by
    rw [hf2]
    exact hspec2.2.2.2.1
  have hfan3 : ∀ l ∈ fan3, ShiShallow.LayerOk l := by
    rw [hf3]
    exact hspec3.2.2.2.1
  -- `LayerOk` for the three embedded copies
  have hE1 := ShiEmbed.layerOk_closure_append_embedCirc e1 he1
  have hE2 := ShiEmbed.layerOk_closure_append_embedCirc e2 he2
  have hE3 := ShiEmbed.layerOk_closure_append_embedCirc e3 he3
  have hec1 : ∀ l ∈ ShiEmbed.embedCirc e1 he1 (F.circ n), ShiShallow.LayerOk l :=
    hE1.1 (F.circ n) hFn
  have hec2 : ∀ l ∈ ShiEmbed.embedCirc e2 he2 (F.circ n), ShiShallow.LayerOk l :=
    hE2.1 (F.circ n) hFn
  have hec3 : ∀ l ∈ ShiEmbed.embedCirc e3 he3 (F.circ n), ShiShallow.LayerOk l :=
    hE3.1 (F.circ n) hFn
  -- close under the LEFT-associated appends
  have happ := hE1.2
  have key := happ _ rd (happ _ _ (happ _ _ (happ _ _ (happ _ _ hfan2 hfan3) hec1) hec2) hec3) hrd
  exact key l (by rw [← heq]; exact hl)

