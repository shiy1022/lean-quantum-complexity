Gap B of the QMA soundness assembly: the ENTRY formula for the witness-embedding isometry.

`ShiClassQMA.exists_witnessInputState_isometry` supplies `W` only through its ACTION
(`Matrix.mulVec W psi = witnessInputState F x psi`), while
`ShiTensor.conjTranspose_majority_compression_three_blocks` pins its threefold operator `Pi`
through the ENTRIES of `W`.  This file converts the action into the entries, by feeding the
action the indicator vectors, and then reads off the threefold action of that very `Pi` on an
ARBITRARY (possibly entangled) vector `Theta` on the three witness blocks.

The witness-block string reassembled on the right-hand side is spelled with `Fin.append`,
which is the spelling supported by `ShiTensor.tensor_split_append_inverse`.

`theorem QMAReferenceValidation.candidate18`'s STATEMENT is self-contained: the support condition and the witness-block
restriction are inlined verbatim from the body of `ShiClassQMA.witnessInputState`.  The two
`private abbrev`s below are reducible restatements of exactly those two inlined expressions and
are used only INSIDE the proofs; nothing in the statement of `QMAReferenceValidation.candidate18` mentions them.

Built against Mathlib (Apache-2.0) at revision 0df444a360eaa60ab8c11dca51a86af692955474.
-/

set_option autoImplicit false

open ShiShallow ShiTensor ShiClassQMA

/-- The witness-block restriction of a full basis string, verbatim as `witnessInputState`
reads it. -/
private abbrev shiWe_wb {n : ℕ} (F : ShiClassQMA.QMAFamily)
    (z : ShiShallow.Bits (n + (F.wit n + (F.anc n + 1)))) : ShiShallow.Bits (F.wit n) :=
  fun j : Fin (F.wit n) => z (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))

/-- The support condition of `witnessInputState`, verbatim: the input block reads `x` and the
ancilla/output block is all-zero. -/
private abbrev shiWe_ok {n : ℕ} (F : ShiClassQMA.QMAFamily) (x : ShiShallow.Bits n)
    (z : ShiShallow.Bits (n + (F.wit n + (F.anc n + 1)))) : Prop :=
  (∀ i : Fin n, z (Fin.castAdd (F.wit n + (F.anc n + 1)) i) = x i) ∧
  (∀ l : Fin (F.anc n + 1), z (Fin.natAdd n (Fin.natAdd (F.wit n) l)) = false)

/-- **The bridge.**  Feeding the action law the indicator vector at `u` reads off the entry of
`W` at `(y, u)`: it is `1` exactly on the support strings whose witness block is `u`. -/
private lemma shiWe_entry {n : ℕ} (F : ShiClassQMA.QMAFamily) (x : ShiShallow.Bits n)
    (W : Matrix (ShiShallow.Bits (n + (F.wit n + (F.anc n + 1))))
                (ShiShallow.Bits (F.wit n)) ℂ)
    (hW : ∀ ψ : ShiShallow.QState (F.wit n),
            Matrix.mulVec W ψ = ShiClassQMA.witnessInputState F x ψ)
    (y : ShiShallow.Bits (n + (F.wit n + (F.anc n + 1))))
    (u : ShiShallow.Bits (F.wit n)) :
    W y u = if shiWe_ok F x y ∧ shiWe_wb F y = u then 1 else 0 := by
  have hpt := congrFun (hW (fun j : ShiShallow.Bits (F.wit n) =>
    if j = u then (1 : ℂ) else 0)) y
  have hs : ∀ j : ShiShallow.Bits (F.wit n),
      W y j * (if j = u then (1 : ℂ) else 0) = if j = u then W y j else 0 := by
    intro j
    by_cases hj : j = u
    · rw [if_pos hj, if_pos hj, mul_one]
    · rw [if_neg hj, if_neg hj, mul_zero]
  have hsum : Matrix.mulVec W
        (fun j : ShiShallow.Bits (F.wit n) => if j = u then (1 : ℂ) else 0) y
      = ∑ j : ShiShallow.Bits (F.wit n), W y j * (if j = u then (1 : ℂ) else 0) :=
    Matrix.mulVec_apply_eq_sum W _ y
  have hL : Matrix.mulVec W
        (fun j : ShiShallow.Bits (F.wit n) => if j = u then (1 : ℂ) else 0) y = W y u :=
    hsum.trans ((Finset.sum_congr rfl (fun j _ => hs j)).trans
      (Fintype.sum_ite_eq' u (fun j => W y j)))
  have hR0 : ShiClassQMA.witnessInputState F x
        (fun j : ShiShallow.Bits (F.wit n) => if j = u then (1 : ℂ) else 0) y
      = if shiWe_ok F x y then (if shiWe_wb F y = u then (1 : ℂ) else 0) else 0 := by
    first
      | (rfl; done)
      | (simp only [ShiClassQMA.witnessInputState]; all_goals rfl)
  have hR : (if shiWe_ok F x y then (if shiWe_wb F y = u then (1 : ℂ) else 0) else 0)
      = if shiWe_ok F x y ∧ shiWe_wb F y = u then (1 : ℂ) else 0 := by
    by_cases hA : shiWe_ok F x y
    · by_cases hB : shiWe_wb F y = u
      · rw [if_pos hA, if_pos hB, if_pos (And.intro hA hB)]
      · rw [if_pos hA, if_neg hB,
          if_neg (show ¬(shiWe_ok F x y ∧ shiWe_wb F y = u) from fun h => hB h.2)]
    · rw [if_neg hA,
        if_neg (show ¬(shiWe_ok F x y ∧ shiWe_wb F y = u) from fun h => hA h.1)]
  exact hL.symm.trans (hpt.trans (hR0.trans hR))

/-- **Gap B, closed.**  Given the witness-embedding isometry `W` of
`ShiClassQMA.exists_witnessInputState_isometry` through its ACTION only, first: its ENTRIES are
the 0/1 placement entries that `ShiTensor.conjTranspose_majority_compression_three_blocks`
demands of `W` in its `hPi`.  Second: the threefold operator `Pi` that `hPi` pins acts on an
ARBITRARY vector `Θ` over the three witness blocks by guarding on the three per-copy support
conditions and reading `Θ` at the three witness blocks concatenated with `Fin.append`.

The support condition and the witness-block restriction are INLINED verbatim from the body of
`ShiClassQMA.witnessInputState` (`Def_ShiClassQMA.lean` lines 85-93), so that this statement is
self-contained and mentions no auxiliary declaration. -/
theorem _root_.QMAReferenceValidation.candidate18 {n : ℕ} (F : ShiClassQMA.QMAFamily) (x : ShiShallow.Bits n)
    (W : Matrix (ShiShallow.Bits (n + (F.wit n + (F.anc n + 1))))
                (ShiShallow.Bits (F.wit n)) ℂ)
    (hW : ∀ ψ : ShiShallow.QState (F.wit n),
            Matrix.mulVec W ψ = ShiClassQMA.witnessInputState F x ψ) :
    (∀ (y : ShiShallow.Bits (n + (F.wit n + (F.anc n + 1))))
        (u : ShiShallow.Bits (F.wit n)),
        W y u
          = if ((∀ i : Fin n, y (Fin.castAdd (F.wit n + (F.anc n + 1)) i) = x i) ∧
                (∀ l : Fin (F.anc n + 1), y (Fin.natAdd n (Fin.natAdd (F.wit n) l)) = false))
              ∧ (fun j : Fin (F.wit n) => y (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))) = u
            then 1 else 0)
    ∧ (∀ Θ : ShiShallow.QState (F.wit n + F.wit n + F.wit n),
        Matrix.mulVec
            (Matrix.of fun
                (Y : ShiShallow.Bits
                  (n + (F.wit n + (F.anc n + 1)) + (n + (F.wit n + (F.anc n + 1)))
                    + (n + (F.wit n + (F.anc n + 1)))))
                (U : ShiShallow.Bits (F.wit n + F.wit n + F.wit n)) =>
              W (ShiTensor.leftBits (ShiTensor.leftBits Y))
                  (ShiTensor.leftBits (ShiTensor.leftBits U))
                * W (ShiTensor.rightBits (ShiTensor.leftBits Y))
                    (ShiTensor.rightBits (ShiTensor.leftBits U))
                * W (ShiTensor.rightBits Y) (ShiTensor.rightBits U)) Θ
          = fun Y =>
              if ((∀ i : Fin n,
                     ShiTensor.leftBits (ShiTensor.leftBits Y)
                       (Fin.castAdd (F.wit n + (F.anc n + 1)) i) = x i) ∧
                   (∀ l : Fin (F.anc n + 1),
                     ShiTensor.leftBits (ShiTensor.leftBits Y)
                       (Fin.natAdd n (Fin.natAdd (F.wit n) l)) = false))
                  ∧ ((∀ i : Fin n,
                        ShiTensor.rightBits (ShiTensor.leftBits Y)
                          (Fin.castAdd (F.wit n + (F.anc n + 1)) i) = x i) ∧
                      (∀ l : Fin (F.anc n + 1),
                        ShiTensor.rightBits (ShiTensor.leftBits Y)
                          (Fin.natAdd n (Fin.natAdd (F.wit n) l)) = false))
                  ∧ ((∀ i : Fin n,
                        ShiTensor.rightBits Y
                          (Fin.castAdd (F.wit n + (F.anc n + 1)) i) = x i) ∧
                      (∀ l : Fin (F.anc n + 1),
                        ShiTensor.rightBits Y
                          (Fin.natAdd n (Fin.natAdd (F.wit n) l)) = false))
              then Θ (Fin.append
                    (Fin.append
                      (fun j : Fin (F.wit n) =>
                        ShiTensor.leftBits (ShiTensor.leftBits Y)
                          (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j)))
                      (fun j : Fin (F.wit n) =>
                        ShiTensor.rightBits (ShiTensor.leftBits Y)
                          (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))))
                    (fun j : Fin (F.wit n) =>
                      ShiTensor.rightBits Y
                        (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))))
              else 0) := by
  obtain ⟨hla, hra, hlr1⟩ :=
    ShiTensor.tensor_split_append_inverse (m := F.wit n) (p := F.wit n)
  obtain ⟨hlA, hrA, hlr2⟩ :=
    ShiTensor.tensor_split_append_inverse (m := F.wit n + F.wit n) (p := F.wit n)
  refine ⟨fun y u => shiWe_entry F x W hW y u, ?_⟩
  intro Θ
  funext Y
  rw [Matrix.mulVec_apply_eq_sum]
  simp only [Matrix.of_apply]
  by_cases hp : ((∀ i : Fin n,
                    ShiTensor.leftBits (ShiTensor.leftBits Y)
                      (Fin.castAdd (F.wit n + (F.anc n + 1)) i) = x i) ∧
                  (∀ l : Fin (F.anc n + 1),
                    ShiTensor.leftBits (ShiTensor.leftBits Y)
                      (Fin.natAdd n (Fin.natAdd (F.wit n) l)) = false))
                  ∧ ((∀ i : Fin n,
                        ShiTensor.rightBits (ShiTensor.leftBits Y)
                          (Fin.castAdd (F.wit n + (F.anc n + 1)) i) = x i) ∧
                      (∀ l : Fin (F.anc n + 1),
                        ShiTensor.rightBits (ShiTensor.leftBits Y)
                          (Fin.natAdd n (Fin.natAdd (F.wit n) l)) = false))
                  ∧ ((∀ i : Fin n,
                        ShiTensor.rightBits Y
                          (Fin.castAdd (F.wit n + (F.anc n + 1)) i) = x i) ∧
                      (∀ l : Fin (F.anc n + 1),
                        ShiTensor.rightBits Y
                          (Fin.natAdd n (Fin.natAdd (F.wit n) l)) = false))
  · rw [if_pos hp]
    have hterm : ∀ U : ShiShallow.Bits (F.wit n + F.wit n + F.wit n),
        W (leftBits (leftBits Y)) (leftBits (leftBits U))
            * W (rightBits (leftBits Y)) (rightBits (leftBits U))
            * W (rightBits Y) (rightBits U) * Θ U
          = if U = Fin.append
                (Fin.append (shiWe_wb F (leftBits (leftBits Y)))
                  (shiWe_wb F (rightBits (leftBits Y))))
                (shiWe_wb F (rightBits Y))
            then Θ U else 0 := by
      intro U
      by_cases hU : U = Fin.append
          (Fin.append (shiWe_wb F (leftBits (leftBits Y)))
            (shiWe_wb F (rightBits (leftBits Y))))
          (shiWe_wb F (rightBits Y))
      · have e1 : leftBits (leftBits U) = shiWe_wb F (leftBits (leftBits Y)) := by
          rw [hU, hlA]
          exact hla _ _
        have e2 : rightBits (leftBits U) = shiWe_wb F (rightBits (leftBits Y)) := by
          rw [hU, hlA]
          exact hra _ _
        have e3 : rightBits U = shiWe_wb F (rightBits Y) := by
          rw [hU]
          exact hrA _ _
        have o1 : W (leftBits (leftBits Y)) (shiWe_wb F (leftBits (leftBits Y))) = 1 :=
          (shiWe_entry F x W hW _ _).trans (if_pos (And.intro hp.1 rfl))
        have o2 : W (rightBits (leftBits Y)) (shiWe_wb F (rightBits (leftBits Y))) = 1 :=
          (shiWe_entry F x W hW _ _).trans (if_pos (And.intro hp.2.1 rfl))
        have o3 : W (rightBits Y) (shiWe_wb F (rightBits Y)) = 1 :=
          (shiWe_entry F x W hW _ _).trans (if_pos (And.intro hp.2.2 rfl))
        rw [if_pos hU, e1, e2, e3, o1, o2, o3]
        all_goals simp only [one_mul]
      · rw [if_neg hU]
        by_cases f1 : shiWe_wb F (leftBits (leftBits Y)) = leftBits (leftBits U)
        · by_cases f2 : shiWe_wb F (rightBits (leftBits Y)) = rightBits (leftBits U)
          · by_cases f3 : shiWe_wb F (rightBits Y) = rightBits U
            · refine absurd ?_ hU
              rw [f1, f2, f3, hlr1 (leftBits U)]
              exact (hlr2 U).symm
            · rw [(shiWe_entry F x W hW (rightBits Y) (rightBits U)).trans
                  (if_neg (fun h => f3 h.2)), mul_zero, zero_mul]
          · rw [(shiWe_entry F x W hW (rightBits (leftBits Y))
                  (rightBits (leftBits U))).trans (if_neg (fun h => f2 h.2)),
              mul_zero, zero_mul, zero_mul]
        · rw [(shiWe_entry F x W hW (leftBits (leftBits Y))
                (leftBits (leftBits U))).trans (if_neg (fun h => f1 h.2)),
            zero_mul, zero_mul, zero_mul]
    exact (Finset.sum_congr rfl (fun U _ => hterm U)).trans
      (Fintype.sum_ite_eq' _ Θ)
  · rw [if_neg hp]
    refine Finset.sum_eq_zero (fun U _ => ?_)
    by_cases h1 : shiWe_ok F x (leftBits (leftBits Y))
    · by_cases h2 : shiWe_ok F x (rightBits (leftBits Y))
      · have h3 : ¬ shiWe_ok F x (rightBits Y) := fun h3 => hp (And.intro h1 (And.intro h2 h3))
        rw [(shiWe_entry F x W hW (rightBits Y) (rightBits U)).trans
            (if_neg (fun h => h3 h.1)), mul_zero, zero_mul]
      · rw [(shiWe_entry F x W hW (rightBits (leftBits Y))
              (rightBits (leftBits U))).trans (if_neg (fun h => h2 h.1)),
          mul_zero, zero_mul, zero_mul]
    · rw [(shiWe_entry F x W hW (leftBits (leftBits Y))
            (leftBits (leftBits U))).trans (if_neg (fun h => h1 h.1)),
        zero_mul, zero_mul, zero_mul]

end QMAReferenceValidation.Source18

