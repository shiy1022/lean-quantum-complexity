-- HSND-3 : the SOUNDNESS half of threefold QMA amplification.
-- Final assembly; every ingredient is a published prove2.me theorem cited by name.

set_option autoImplicit false

open ShiShallow ShiClassQMA

/-- `‖0‖ ^ 2` inside either branch of an `if` is `0`; feeds `hH` of the spread reindexing. -/
private theorem shiHs_ite_norm_zero {cc : Prop} [Decidable cc] :
    (if cc then ‖(0 : ℂ)‖ ^ 2 else (0 : ℝ)) = 0 := by
  rw [norm_zero, pow_two, mul_zero, ite_self]

/-- Dropping a guard `d` from `if d ∧ cc then N else 0` when `N` vanishes wherever `d` fails. -/
private theorem shiHs_guard_drop {cc d : Prop} [Decidable cc] [Decidable d] (N : ℝ)
    (hN : ¬ d → N = 0) :
    (if d ∧ cc then N else (0 : ℝ)) = if cc then N else 0 := by
  by_cases hc : cc
  · by_cases hd : d
    · rw [if_pos (And.intro hd hc), if_pos hc]
    · rw [if_neg (fun h : d ∧ cc => hd h.1), if_pos hc, hN hd]
  · rw [if_neg (fun h : d ∧ cc => hc h.2), if_neg hc]

/-- A two-block string is determined by its two halves. -/
private theorem shiHs_bits_eq_split {m k : ℕ} (u v : Bits (m + k))
    (h1 : ShiTensor.leftBits u = ShiTensor.leftBits v)
    (h2 : ShiTensor.rightBits u = ShiTensor.rightBits v) : u = v := by
  funext i
  induction i using Fin.addCases with
  | left j => exact congrFun h1 j
  | right j => exact congrFun h2 j

/-- Reading a three-block tuple through the width cast `K = w + w + w`. -/
private theorem shiHs_append_cast {w K : ℕ} (hKs : K = w + w + w)
    (b1 b2 b3 : Fin w → Bool) (i : Fin K) :
    Fin.append (Fin.append b1 b2) b3 (Fin.cast hKs i)
      = if h : i.val < w then b1 ⟨i.val, h⟩
        else if h2 : i.val < w + w then b2 ⟨i.val - w, by omega⟩
        else b3 ⟨i.val - w - w, by have := i.isLt; omega⟩ := by
  by_cases h1 : i.val < w
  · have hi : Fin.cast hKs i
        = Fin.castAdd w (Fin.castAdd w (⟨i.val, h1⟩ : Fin w)) := Fin.ext rfl
    rw [hi, Fin.append_left, Fin.append_left, dif_pos h1]
  · by_cases h2 : i.val < w + w
    · have hi : Fin.cast hKs i
          = Fin.castAdd w (Fin.natAdd w (⟨i.val - w, by omega⟩ : Fin w)) := by
        apply Fin.ext
        show i.val = w + (i.val - w)
        omega
      rw [hi, Fin.append_left, Fin.append_right, dif_neg h1, dif_pos h2]
    · have hi : Fin.cast hKs i
          = Fin.natAdd (w + w) (⟨i.val - w - w, by have := i.isLt; omega⟩ : Fin w) := by
        apply Fin.ext
        show i.val = w + w + (i.val - w - w)
        omega
      rw [hi, Fin.append_right, dif_neg h1, dif_neg h2]

/-- Copy-1 block lifting, rewritten as a nested left-block extension. -/
private theorem shiHs_shape_one {w : ℕ} (A : Op w) :
    (Matrix.of fun y z : Bits (w + w + w) =>
        A (ShiTensor.leftBits (ShiTensor.leftBits y))
            (ShiTensor.leftBits (ShiTensor.leftBits z))
          * (if ShiTensor.rightBits (ShiTensor.leftBits y)
                = ShiTensor.rightBits (ShiTensor.leftBits z) then 1 else 0)
          * (if ShiTensor.rightBits y = ShiTensor.rightBits z then 1 else 0))
      = Matrix.of fun y z : Bits (w + w + w) =>
          if ShiTensor.rightBits y = ShiTensor.rightBits z then
            (Matrix.of fun y' z' : Bits (w + w) =>
                if ShiTensor.rightBits y' = ShiTensor.rightBits z' then
                  A (ShiTensor.leftBits y') (ShiTensor.leftBits z') else 0)
              (ShiTensor.leftBits y) (ShiTensor.leftBits z)
          else 0 := by
  ext y z
  by_cases h2 : ShiTensor.rightBits y = ShiTensor.rightBits z
  · by_cases h1 : ShiTensor.rightBits (ShiTensor.leftBits y)
        = ShiTensor.rightBits (ShiTensor.leftBits z)
    · simp only [Matrix.of_apply, if_pos h1, if_pos h2, mul_one]
    · simp only [Matrix.of_apply, if_pos h2, if_neg h1, mul_one, mul_zero]
  · simp only [Matrix.of_apply, if_neg h2, mul_zero]

/-- Copy-2 block lifting, rewritten as a left-block extension of a right-block extension. -/
private theorem shiHs_shape_two {w : ℕ} (A : Op w) :
    (Matrix.of fun y z : Bits (w + w + w) =>
        (if ShiTensor.leftBits (ShiTensor.leftBits y)
              = ShiTensor.leftBits (ShiTensor.leftBits z) then 1 else 0)
          * A (ShiTensor.rightBits (ShiTensor.leftBits y))
              (ShiTensor.rightBits (ShiTensor.leftBits z))
          * (if ShiTensor.rightBits y = ShiTensor.rightBits z then 1 else 0))
      = Matrix.of fun y z : Bits (w + w + w) =>
          if ShiTensor.rightBits y = ShiTensor.rightBits z then
            (Matrix.of fun y' z' : Bits (w + w) =>
                if ShiTensor.leftBits y' = ShiTensor.leftBits z' then
                  A (ShiTensor.rightBits y') (ShiTensor.rightBits z') else 0)
              (ShiTensor.leftBits y) (ShiTensor.leftBits z)
          else 0 := by
  ext y z
  by_cases h2 : ShiTensor.rightBits y = ShiTensor.rightBits z
  · by_cases h1 : ShiTensor.leftBits (ShiTensor.leftBits y)
        = ShiTensor.leftBits (ShiTensor.leftBits z)
    · simp only [Matrix.of_apply, if_pos h1, if_pos h2, one_mul, mul_one]
    · simp only [Matrix.of_apply, if_pos h2, if_neg h1, mul_one, zero_mul]
  · simp only [Matrix.of_apply, if_neg h2, mul_zero]

/-- Copy-3 block lifting, rewritten as a single right-block extension. -/
private theorem shiHs_shape_three {w : ℕ} (A : Op w) :
    (Matrix.of fun y z : Bits (w + w + w) =>
        (if ShiTensor.leftBits (ShiTensor.leftBits y)
              = ShiTensor.leftBits (ShiTensor.leftBits z) then 1 else 0)
          * (if ShiTensor.rightBits (ShiTensor.leftBits y)
                = ShiTensor.rightBits (ShiTensor.leftBits z) then 1 else 0)
          * A (ShiTensor.rightBits y) (ShiTensor.rightBits z))
      = Matrix.of fun y z : Bits (w + w + w) =>
          if ShiTensor.leftBits y = ShiTensor.leftBits z then
            A (ShiTensor.rightBits y) (ShiTensor.rightBits z) else 0 := by
  ext y z
  by_cases h0 : ShiTensor.leftBits y = ShiTensor.leftBits z
  · have hl : ShiTensor.leftBits (ShiTensor.leftBits y)
        = ShiTensor.leftBits (ShiTensor.leftBits z) := by rw [h0]
    have hr : ShiTensor.rightBits (ShiTensor.leftBits y)
        = ShiTensor.rightBits (ShiTensor.leftBits z) := by rw [h0]
    simp only [Matrix.of_apply, if_pos h0, if_pos hl, if_pos hr, one_mul]
  · by_cases hl : ShiTensor.leftBits (ShiTensor.leftBits y)
        = ShiTensor.leftBits (ShiTensor.leftBits z)
    · have hr : ¬ (ShiTensor.rightBits (ShiTensor.leftBits y)
          = ShiTensor.rightBits (ShiTensor.leftBits z)) := by
        intro hrr
        exact h0 (shiHs_bits_eq_split _ _ hl hrr)
      simp only [Matrix.of_apply, if_neg h0, if_neg hr, if_pos hl, one_mul, zero_mul]
    · simp only [Matrix.of_apply, if_neg h0, if_neg hl, zero_mul]

/-- `hlift` of the endgame: an entangled-free statement about PRODUCTS of eigenvectors only,
which is all `quadratic_form_three_block_majority_le_of_bound` consumes. -/
private theorem shiHs_lift {w : ℕ} (A : Op w) (p q t : QState w) (α β γ : ℂ)
    (hp : Matrix.mulVec A p = α • p) (hq : Matrix.mulVec A q = β • q)
    (ht : Matrix.mulVec A t = γ • t) :
    Matrix.mulVec (Matrix.of fun y z : Bits (w + w + w) =>
        A (ShiTensor.leftBits (ShiTensor.leftBits y))
            (ShiTensor.leftBits (ShiTensor.leftBits z))
          * (if ShiTensor.rightBits (ShiTensor.leftBits y)
                = ShiTensor.rightBits (ShiTensor.leftBits z) then 1 else 0)
          * (if ShiTensor.rightBits y = ShiTensor.rightBits z then 1 else 0))
        (ShiTensor.tensor (ShiTensor.tensor p q) t)
      = α • ShiTensor.tensor (ShiTensor.tensor p q) t
    ∧ Matrix.mulVec (Matrix.of fun y z : Bits (w + w + w) =>
        (if ShiTensor.leftBits (ShiTensor.leftBits y)
              = ShiTensor.leftBits (ShiTensor.leftBits z) then 1 else 0)
          * A (ShiTensor.rightBits (ShiTensor.leftBits y))
              (ShiTensor.rightBits (ShiTensor.leftBits z))
          * (if ShiTensor.rightBits y = ShiTensor.rightBits z then 1 else 0))
        (ShiTensor.tensor (ShiTensor.tensor p q) t)
      = β • ShiTensor.tensor (ShiTensor.tensor p q) t
    ∧ Matrix.mulVec (Matrix.of fun y z : Bits (w + w + w) =>
        (if ShiTensor.leftBits (ShiTensor.leftBits y)
              = ShiTensor.leftBits (ShiTensor.leftBits z) then 1 else 0)
          * (if ShiTensor.rightBits (ShiTensor.leftBits y)
                = ShiTensor.rightBits (ShiTensor.leftBits z) then 1 else 0)
          * A (ShiTensor.rightBits y) (ShiTensor.rightBits z))
        (ShiTensor.tensor (ShiTensor.tensor p q) t)
      = γ • ShiTensor.tensor (ShiTensor.tensor p q) t := by
  refine ⟨?_, ?_, ?_⟩
  · rw [shiHs_shape_one A]
    exact ShiTensor.mulVec_block_extend_tensor_eigenvector
      (Matrix.of fun y' z' : Bits (w + w) =>
        if ShiTensor.rightBits y' = ShiTensor.rightBits z' then
          A (ShiTensor.leftBits y') (ShiTensor.leftBits z') else 0)
      α (ShiTensor.tensor p q) t
      (fun a' => congrFun (ShiTensor.mulVec_block_extend_tensor_eigenvector A α p q
        (fun a'' => congrFun hp a'')) a')
  · rw [shiHs_shape_two A]
    exact ShiTensor.mulVec_block_extend_tensor_eigenvector
      (Matrix.of fun y' z' : Bits (w + w) =>
        if ShiTensor.leftBits y' = ShiTensor.leftBits z' then
          A (ShiTensor.rightBits y') (ShiTensor.rightBits z') else 0)
      β (ShiTensor.tensor p q) t
      (fun a' => congrFun (ShiTensor.mulVec_block_extend_right_tensor_eigenvector A β p q
        (fun b'' => congrFun hq b'')) a')
  · rw [shiHs_shape_three A]
    exact ShiTensor.mulVec_block_extend_right_tensor_eigenvector A γ
      (ShiTensor.tensor p q) t (fun b' => congrFun ht b')

/-- Steps 4-9 of the spine, at abstract per-copy width `M` and witness width `w`:
the three-copy majority weight of the spread state, bounded by `3 s ^ 2 - 2 s ^ 3`. -/
private theorem shiHs_core {M w : ℕ} (c : Layered M) (out : Fin M)
    (C3 : Layered (M + M + M))
    (hC3 : C3 =
      ShiEmbed.embedCirc
          ((Fin.castAdd M : Fin (M + M) → Fin (M + M + M)) ∘
            (Fin.castAdd M : Fin M → Fin (M + M)))
          ((Fin.castAdd_injective (M + M) M).comp (Fin.castAdd_injective M M)) c
        ++ ShiEmbed.embedCirc
          ((Fin.castAdd M : Fin (M + M) → Fin (M + M + M)) ∘
            (Fin.natAdd M : Fin M → Fin (M + M)))
          ((Fin.castAdd_injective (M + M) M).comp (Fin.natAdd_injective M M)) c
        ++ ShiEmbed.embedCirc (Fin.natAdd (M + M) : Fin M → Fin (M + M + M))
          (Fin.natAdd_injective M (M + M)) c)
    (W : Matrix (Bits M) (Bits w) ℂ)
    (hWiso : Matrix.conjTranspose W * W = (1 : Op w))
    (Pi : Matrix (Bits (M + M + M)) (Bits (w + w + w)) ℂ)
    (hPi : Pi = Matrix.of fun (y : Bits (M + M + M)) (u : Bits (w + w + w)) =>
      W (ShiTensor.leftBits (ShiTensor.leftBits y)) (ShiTensor.leftBits (ShiTensor.leftBits u))
        * W (ShiTensor.rightBits (ShiTensor.leftBits y))
            (ShiTensor.rightBits (ShiTensor.leftBits u))
        * W (ShiTensor.rightBits y) (ShiTensor.rightBits u))
    (s : ℝ) (hs1 : s ≤ 1)
    (hbnd : ∀ v : Bits w → ℂ, (∑ y : Bits w, ‖v y‖ ^ 2) = 1 →
      0 ≤ (∑ y : Bits w, (starRingEnd ℂ) (v y) * Matrix.mulVec
            (Matrix.conjTranspose W * (star (circMatrix c) * projOut out * circMatrix c) * W)
            v y).re
        ∧ (∑ y : Bits w, (starRingEnd ℂ) (v y) * Matrix.mulVec
            (Matrix.conjTranspose W * (star (circMatrix c) * projOut out * circMatrix c) * W)
            v y).re ≤ s)
    (Θ : QState (w + w + w)) (hΘ : (∑ y : Bits (w + w + w), ‖Θ y‖ ^ 2) = 1) :
    (∑ y : Bits (M + M + M),
        if (2 : ℕ) ≤ (if y (Fin.castAdd M (Fin.castAdd M out)) = true then (1 : ℕ) else 0)
              + (if y (Fin.castAdd M (Fin.natAdd M out)) = true then (1 : ℕ) else 0)
              + (if y (Fin.natAdd (M + M) out) = true then (1 : ℕ) else 0)
          then ‖runLayered C3 (Matrix.mulVec Pi Θ) y‖ ^ 2 else 0)
      ≤ 3 * s ^ 2 - 2 * s ^ 3 := by
  obtain ⟨hL1, hL2, hL3⟩ :=
    ShiTensor.three_copy_acceptance_operators_are_block_liftings c out C3 hC3
      (star (circMatrix c) * projOut out * circMatrix c) rfl _ _ _ rfl rfl rfl
  rw [ShiShallow.runLayered_eq_circMatrix_mulVec
      (fun U i ψ => ShiShallow.apply1_eq_apply1Matrix_mulVec U i ψ)
      (fun i j hij ψ => ShiShallow.cnotState_eq_cnotMatrix_mulVec i j hij ψ)
      C3 (Matrix.mulVec Pi Θ),
    ShiShallow.majority_weight_eq_conj_majority_quadratic_form (circMatrix C3)
      (ShiShallow.circMatrix_unitary C3) (Fin.castAdd M (Fin.castAdd M out))
      (Fin.castAdd M (Fin.natAdd M out)) (Fin.natAdd (M + M) out) (Matrix.mulVec Pi Θ),
    hL1, hL2, hL3,
    (ShiShallow.quadratic_form_transport_and_two_bridge
      (M := M + M + M) (N := M + M + M)).2,
    (ShiShallow.quadratic_form_transport_and_two_bridge
      (M := M + M + M) (N := w + w + w)).1,
    ShiTensor.conjTranspose_majority_compression_three_blocks W hWiso
      (star (circMatrix c) * projOut out * circMatrix c)
      (Matrix.conjTranspose W * (star (circMatrix c) * projOut out * circMatrix c) * W) rfl
      Pi hPi _ _ _ rfl rfl rfl _ _ _ rfl rfl rfl]
  refine ShiTensor.quadratic_form_three_block_majority_le_of_bound
      (Matrix.conjTranspose W * (star (circMatrix c) * projOut out * circMatrix c) * W)
      ?_ s hs1 hbnd _ _ _ ?_ Θ hΘ
  · have hH : Matrix.conjTranspose (star (circMatrix c) * projOut out * circMatrix c)
        = star (circMatrix c) * projOut out * circMatrix c :=
      ShiShallow.acceptOperator_isHermitian (circMatrix c) out
    show Matrix.conjTranspose
        (Matrix.conjTranspose W * (star (circMatrix c) * projOut out * circMatrix c) * W)
      = Matrix.conjTranspose W * (star (circMatrix c) * projOut out * circMatrix c) * W
    rw [Matrix.conjTranspose_mul, Matrix.conjTranspose_mul,
      Matrix.conjTranspose_conjTranspose, hH]
    exact (Matrix.mul_assoc _ _ _).symm
  · intro pv qv tv α β γ hpv hqv htv
    exact shiHs_lift
      (Matrix.conjTranspose W * (star (circMatrix c) * projOut out * circMatrix c) * W)
      pv qv tv α β γ hpv hqv htv

