        hAB, hBC, hCA, hABC]; module; done)
  | (simp only [Matrix.sub_mulVec, Matrix.add_mulVec, Matrix.smul_mulVec]
     rw [hAB, hBC, hCA, hABC]; module; done)
  | (rw [Matrix.sub_mulVec, Matrix.add_mulVec, Matrix.add_mulVec, Matrix.smul_mulVec,
        hAB, hBC, hCA, hABC]; module; done)
  | (simp only [Matrix.sub_mulVec, Matrix.add_mulVec, Matrix.smul_mulVec,
        hAB, hBC, hCA, hABC]
