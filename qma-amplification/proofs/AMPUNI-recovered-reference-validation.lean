    · exact h1 (hz.trans (by rw [hzi]))
  first
  | (simp only [apply1Matrix, Matrix.of_apply]; rw [if_neg hg]; done)
  | (unfold apply1Matrix; rw [Matrix.of_apply, if_neg hg]; done)
  | (simp only [apply1Matrix, Matrix.of_apply, if_neg hg]; done)

