          ∧ (∀ j j' : Fin n, p j ≠ q j')
          ∧ (∀ Φ : QState (n + ((T F).wit n + ((T F).anc n + 1))), runLayered fan2 Φ = fun Y => Φ (u2 Y))
          ∧ (∀ (Y : Bits (n + ((T F).wit n + ((T F).anc n + 1)))) (j : Fin n),
