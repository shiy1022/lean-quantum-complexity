-/

set_option autoImplicit false

open ShiShallow
open ShiClassQMA
open ShiTensor

/-! ### Helper 1 : an isometry preserves the total squared norm.

There is NO CORE-tower theorem for this: `ShiShallow.runLayered_norm` and the whole
`sum_norm_sq_*` chain live in the `Def_ShiShallow_Circuit` tower, which may not be
co-imported here. So it is proved from `ofReal_norm_sq` and the entrywise isometry identity. -/

private lemma shiHc_bridge {m : ℕ} (u : QState m) :
    ((∑ y : Bits m, ‖u y‖ ^ 2 : ℝ) : ℂ) = ∑ y : Bits m, star (u y) * u y := by
  rw [Complex.ofReal_sum]
  exact Finset.sum_congr rfl (fun y _ => ShiShallow.ofReal_norm_sq (u y))

private lemma shiHc_sum_normSq_mulVec {K M : ℕ}
    (W : Matrix (Bits K) (Bits M) ℂ)
    (hW : Matrix.conjTranspose W * W = (1 : Op M)) (v : QState M) :
    ∑ y : Bits K, ‖Matrix.mulVec W v y‖ ^ 2 = ∑ z : Bits M, ‖v z‖ ^ 2 := by
  have hcol : ∀ b d : Bits M,
      (∑ y : Bits K, star (W y b) * W y d) = (if b = d then (1 : ℂ) else 0) := by
    intro b d
    have h := congrFun (congrFun hW b) d
    simp only [Matrix.mul_apply, Matrix.conjTranspose_apply, Matrix.one_apply] at h
    exact h
  have key : ∀ y : Bits K, star (Matrix.mulVec W v y) * Matrix.mulVec W v y
      = ∑ b : Bits M, ∑ d : Bits M, (star (W y b) * W y d) * (star (v b) * v d) := by
    intro y
    have hmv : Matrix.mulVec W v y = ∑ b : Bits M, W y b * v b := by
      simp only [Matrix.mulVec, dotProduct]
    rw [hmv, star_sum, Finset.sum_mul_sum]
    refine Finset.sum_congr rfl (fun b _ => Finset.sum_congr rfl (fun d _ => ?_))
    rw [star_mul']
    ring
  refine Complex.ofReal_injective ?_
  rw [shiHc_bridge, shiHc_bridge]
  calc ∑ y : Bits K, star (Matrix.mulVec W v y) * Matrix.mulVec W v y
      = ∑ y : Bits K, ∑ b : Bits M, ∑ d : Bits M,
          (star (W y b) * W y d) * (star (v b) * v d) :=
        Finset.sum_congr rfl (fun y _ => key y)
    _ = ∑ b : Bits M, ∑ d : Bits M, ∑ y : Bits K,
          (star (W y b) * W y d) * (star (v b) * v d) := by
        rw [Finset.sum_comm]
        exact Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)
    _ = ∑ b : Bits M, ∑ d : Bits M,
          (if b = d then (1 : ℂ) else 0) * (star (v b) * v d) := by
        refine Finset.sum_congr rfl (fun b _ => Finset.sum_congr rfl (fun d _ => ?_))
        rw [← Finset.sum_mul, hcol b d]
    _ = ∑ b : Bits M, star (v b) * v b := by
        refine Finset.sum_congr rfl (fun b _ => ?_)
        have hterm : ∀ d : Bits M, (if b = d then (1 : ℂ) else 0) * (star (v b) * v d)
            = (if b = d then star (v b) * v b else 0) := by
          intro d
          by_cases hbd : b = d
          · rw [if_pos hbd, if_pos hbd, one_mul, hbd]
          · rw [if_neg hbd, if_neg hbd, zero_mul]
        rw [Finset.sum_congr rfl (fun d _ => hterm d), Finset.sum_ite_eq]
        rw [if_pos (Finset.mem_univ b)]

private lemma shiHc_runLayered_normSq {N : ℕ} (cc : Layered N) (v : QState N) :
    ∑ y : Bits N, ‖runLayered cc v y‖ ^ 2 = ∑ z : Bits N, ‖v z‖ ^ 2 := by
  have hu : Matrix.conjTranspose (ShiShallow.circMatrix cc) * ShiShallow.circMatrix cc
      = (1 : Op N) := by
    rw [← Matrix.star_eq_conjTranspose]
    exact ShiShallow.circMatrix_unitary cc
  rw [ShiShallow.runLayered_eq_circMatrix_mulVec
      (fun U i w => ShiShallow.apply1_eq_apply1Matrix_mulVec U i w)
      (fun i j hij w => ShiShallow.cnotState_eq_cnotMatrix_mulVec i j hij w) cc v]
  exact shiHc_sum_normSq_mulVec (ShiShallow.circMatrix cc) hu v

/-! ### Helper 2 : `hJoint` and `hIE` for `tensor_majority_three_accept_weight_closed_form`.

NOTE: `ShiTensor.guarded_tensor_factor_and_majority_inclusion_exclusion` exists only as
`Solutions/Sol_ShiTensor.guarded_tensor_factor_and_majority_inclusion_exclusion.lean`;
there is NO `Theorems/Thm_...` reference copy, so it cannot be imported. Reproved here. -/

private lemma shiHc_pt {m p : ℕ} (a : QState m) (b : QState p)
    (r : Bits m → Bool) (t : Bits p → Bool) (s : Bits m) (cc : Bits p) :
    (if r s && t cc then ‖a s * b cc‖ ^ 2 else 0)
      = (if r s then ‖a s‖ ^ 2 else 0) * (if t cc then ‖b cc‖ ^ 2 else 0) := by
  cases _hr : r s <;> cases _ht : t cc <;> norm_num [norm_mul, mul_pow]

private lemma shiHc_joint (m p : ℕ) (a : QState m) (b : QState p)
    (r : Bits m → Bool) (t : Bits p → Bool) :
    ∑ y : Bits (m + p), (if r (leftBits y) && t (rightBits y)
        then ‖tensor a b y‖ ^ 2 else 0)
      = (∑ s : Bits m, (if r s then ‖a s‖ ^ 2 else 0))
        * ∑ cc : Bits p, (if t cc then ‖b cc‖ ^ 2 else 0) := by
  have key : ∀ y : Bits (m + p),
      (if r (leftBits y) && t (rightBits y) then ‖tensor a b y‖ ^ 2 else 0)
        = (fun s : Bits m => if r s then ‖a s‖ ^ 2 else 0) (leftBits y)
          * (fun cc : Bits p => if t cc then ‖b cc‖ ^ 2 else 0) (rightBits y) := by
    intro y
    exact shiHc_pt a b r t (leftBits y) (rightBits y)
  exact (Finset.sum_congr rfl (fun y _ => key y)).trans
    (ShiTensor.sum_split_factor (m := m) (p := p) (R := ℝ)
      (fun s : Bits m => if r s then ‖a s‖ ^ 2 else 0)
      (fun cc : Bits p => if t cc then ‖b cc‖ ^ 2 else 0))

private lemma shiHc_ie (b1 b2 b3 : Bool) :
    (if 2 ≤ (if b1 then (1 : ℕ) else 0) + (if b2 then (1 : ℕ) else 0)
          + (if b3 then (1 : ℕ) else 0) then (1 : ℝ) else 0)
      = (if b1 then (1 : ℝ) else 0) * (if b2 then (1 : ℝ) else 0)
        + (if b2 then (1 : ℝ) else 0) * (if b3 then (1 : ℝ) else 0)
        + (if b3 then (1 : ℝ) else 0) * (if b1 then (1 : ℝ) else 0)
        - 2 * ((if b1 then (1 : ℝ) else 0) * (if b2 then (1 : ℝ) else 0)
            * (if b3 then (1 : ℝ) else 0)) := by
  cases b1 <;> cases b2 <;> cases b3 <;> norm_num

/-! ### Helper 3 : the majority COUNT guard equals the majority OR guard. -/

private lemma shiHc_maj_or (b1 b2 b3 : Bool) (X : ℝ) :
    (if 2 ≤ (if b1 then (1 : ℕ) else 0) + (if b2 then (1 : ℕ) else 0)
          + (if b3 then (1 : ℕ) else 0) then X else 0)
      = (if (b1 && b2) || ((b2 && b3) || (b1 && b3)) then X else 0) := by
  cases b1 <;> cases b2 <;> cases b3 <;> norm_num

/-! ### Helper 4 : the guarded summand vanishes at amplitude `0`. -/

private lemma shiHc_ite_norm_zero (k : ℕ) :
    (if 2 ≤ k then ‖(0 : ℂ)‖ ^ 2 else (0 : ℝ)) = 0 := by
  by_cases hk : 2 ≤ k
  · rw [if_pos hk, norm_zero]
    norm_num
  · rw [if_neg hk]

/-! ### Helper 5 : `maj3 t = 3t^2 - 2t^3` is monotone on `[0,1]`. -/

private lemma shiHc_maj3_mono (a b : ℝ) (ha0 : 0 ≤ a) (hab : a ≤ b) (hb1 : b ≤ 1) :
    3 * a ^ 2 - 2 * a ^ 3 ≤ 3 * b ^ 2 - 2 * b ^ 3 := by
  have hb0 : 0 ≤ b := ha0.trans hab
  have ha1 : a ≤ 1 := hab.trans hb1
  have hd : 0 ≤ b - a := sub_nonneg.mpr hab
  nlinarith [mul_nonneg hd (mul_nonneg hb0 (sub_nonneg.mpr hb1)),
    mul_nonneg hd (mul_nonneg ha0 (sub_nonneg.mpr ha1)),
    mul_nonneg hd (mul_nonneg hb0 (sub_nonneg.mpr ha1)),
    mul_nonneg hd (mul_nonneg ha0 (sub_nonneg.mpr hb1))]

/-! ### Helper 6 : definitional unfoldings used as rewrite handles. -/

private lemma shiHc_wis (G : QMAFamily) {m : ℕ} (x : Bits m) (ψ : QState (G.wit m))
    (y : Bits (m + (G.wit m + (G.anc m + 1)))) :
    witnessInputState G x ψ y
      = if (∀ i : Fin m, y (Fin.castAdd (G.wit m + (G.anc m + 1)) i) = x i) ∧
           (∀ l : Fin (G.anc m + 1), y (Fin.natAdd m (Fin.natAdd (G.wit m) l)) = false)
        then ψ (fun j : Fin (G.wit m) => y (Fin.natAdd m (Fin.castAdd (G.anc m + 1) j)))
        else 0 := rfl

private lemma shiHc_tensor3 {m p q : ℕ} (a : QState m) (b : QState p) (dd : QState q)
    (y : Bits (m + p + q)) :
    tensor (tensor a b) dd y
      = a (leftBits (leftBits y)) * b (rightBits (leftBits y)) * dd (rightBits y) := rfl

/-! ### The completeness half. -/

theorem _root_.QMAReferenceValidation.candidate10 (T : ShiClassQMA.QMAFamily → ShiClassQMA.QMAFamily)
    (hwit : ∀ F n, (T F).wit n = 3 * F.wit n)
    (hanc : ∀ F n, (T F).anc n = 2 * n + 3 * F.anc n + 3)
    (hout : ∀ F n, ((T F).out n).val = 3 * n + 3 * F.wit n + 3 * F.anc n + 3)
    (hstruct : ∀ (F : ShiClassQMA.QMAFamily) (n : ℕ),
