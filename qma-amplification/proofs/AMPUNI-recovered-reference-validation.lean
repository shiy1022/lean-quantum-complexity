      throwError "Candidate has a direct placeholder: ShiClassQMAAmpX.ampFamilyX_semantically_eq_ampFamily"
    logInfo "REFERENCE_TYPE_CHECKED ShiClassQMAAmpX.ampFamilyX_semantically_eq_ampFamily"

namespace QMAReferenceValidation.Source4
-- AMPPROP-1.  The FIELD IDENTITIES, the OUTPUT-WIRE index and the DEPTH BOUND of the
-- explicit threefold amplifier `ShiClassQMAAmp.ampFamily`, plus `WellFormed` and
-- `PolyBounded` preservation, plus a concrete non-vacuity instance.
--
-- WHY THIS IS NOT A RESTATEMENT OF AN ACCEPTED RESULT.
-- `ShiClassQMA.exists_threefold_amplifier_structure_at_output_wires` proves these four
-- facts about an EXISTENTIALLY QUANTIFIED `T`, with the construction `private` and hence
-- invisible downstream.  `Definitions.Def_ShiClassQMAAmp` now publishes that construction as
-- `ShiClassQMAAmp.ampFamily`.  This file re-establishes the four facts ABOUT THAT NAMED
-- DEFINITION, which is what lets every accepted analytic amplification theorem (all of which
-- are generic in `T` and take these very facts as hypotheses) be instantiated at `ampFamily`
-- by a downstream file.
--
-- NON-VACUITY.  The final conjunct exhibits a concrete `F` (`wit = 1`, `anc = 0`, empty
-- circuit) and pins all four quantities at NUMERALS there: `wit = 3`, `anc = 3`,
-- `out = 6`, `depth = 113`.  In particular the additive constant `113` is exhibited, not
-- merely asserted, since `depth (F.circ n) = 0` for the empty circuit.

set_option autoImplicit false

open ShiShallow ShiClassQMA ShiClassQMAAmp

/-! ### The layout clauses, replayed against the PUBLISHED `ampSig`

`ampSig n w a` is `Classical.choose (ShiShallow.exists_layout_bijection n w a)`, so its
thirteen placement clauses plus bijectivity are recovered by `Classical.choose_spec` exactly as
in the source proof.  Only two of the fourteen conjuncts are needed here: bijectivity (for the
wire-distinctness side conditions of the readout) and the SCRATCH clause (for the output-wire
index). -/

private theorem ampSig_facts (n w a : ℕ) :
    Function.Bijective (ampSig n w a)
    ∧ (∀ v : Fin (3 * (n + (w + (a + 1))) + 1), v.val = 3 * (n + (w + (a + 1))) →
        (ampSig n w a v).val = 3 * n + 3 * w + 3 * a + 3) := by
  obtain ⟨hb, -, -, -, -, -, -, -, -, -, -, -, -, h13⟩ :=
    Classical.choose_spec (ShiShallow.exists_layout_bijection n w a)
  exact ⟨hb, h13⟩

private theorem ampScr_val (n w a : ℕ) :
    (ampScr n w a).val = 3 * n + 3 * w + 3 * a + 3 :=
  (ampSig_facts n w a).2 ⟨3 * (n + (w + (a + 1))), by omega⟩ rfl

private theorem ampEmb_inj (M off : ℕ) (hoff : off + M ≤ 3 * M) :
    Function.Injective (ampEmb M off hoff) := by
  intro x y he
  have h : off + x.val = off + y.val := congrArg Fin.val he
  exact Fin.val_injective (by omega)

private theorem ampFanEmb_inj (n M off : ℕ) (h1 : n ≤ off) (h2 : off + n ≤ 3 * M) :
    Function.Injective (ampFanEmb n M off h1 h2) := by
  intro x y he
  have hx := x.isLt
  have hy := y.isLt
  have h : ampFanVal n off x.val = ampFanVal n off y.val := congrArg Fin.val he
  apply Fin.val_injective
  simp only [ampFanVal] at h
  split_ifs at h <;> omega

private theorem ampE_inj (n w a off : ℕ)
    (h : off + (n + (w + (a + 1))) ≤ 3 * (n + (w + (a + 1)))) :
    Function.Injective (ampE n w a off h) :=
  (ampSig_facts n w a).1.injective.comp (ampEmb_inj _ _ h)

private theorem ampG_inj (n w a off : ℕ) (h1 : n ≤ off)
    (h2 : off + n ≤ 3 * (n + (w + (a + 1)))) :
    Function.Injective (ampG n w a off h1 h2) :=
  (ampSig_facts n w a).1.injective.comp (ampFanEmb_inj _ _ _ h1 h2)

private theorem ampG2_inj (n w a : ℕ) : Function.Injective (ampG2 n w a) :=
  ampG_inj n w a (n + (w + (a + 1))) (by omega) (by omega)

private theorem ampG3_inj (n w a : ℕ) : Function.Injective (ampG3 n w a) :=
  ampG_inj n w a (2 * (n + (w + (a + 1)))) (by omega) (by omega)

/-! ### Distinctness of the four voted wires, from BIJECTIVITY of the layout

`ampE n w a off h v = ampSig n w a ⟨off + v.val, _⟩` and `ampScr n w a = ampSig n w a ⟨3*M, _⟩`
with `M = n + (w + (a + 1))`.  For a FIXED `v` the offsets cancel, so distinct `off` give
distinct positions, and every `off + v.val` is `< 3*M` because `off + M ≤ 3*M` and `v.val < M`;
injectivity of the layout lifts distinct positions to distinct wires.  No numeral is used, so
this is valid for an arbitrary `QMAFamily.out` field. -/

private theorem ampE_ne (n w a off off' : ℕ)
    (h : off + (n + (w + (a + 1))) ≤ 3 * (n + (w + (a + 1))))
    (h' : off' + (n + (w + (a + 1))) ≤ 3 * (n + (w + (a + 1)))) (hne : off ≠ off')
    (v : Fin (n + (w + (a + 1)))) : ampE n w a off h v ≠ ampE n w a off' h' v := by
  intro he
  have hv := v.isLt
  have hb := (ampSig_facts n w a).1
  have h2 : ampEmb (n + (w + (a + 1))) off h v
      = ampEmb (n + (w + (a + 1))) off' h' v := hb.injective he
  have h3 : off + v.val = off' + v.val := congrArg Fin.val h2
  omega

private theorem ampE_ne_scr (n w a off : ℕ)
    (h : off + (n + (w + (a + 1))) ≤ 3 * (n + (w + (a + 1))))
    (v : Fin (n + (w + (a + 1)))) : ampE n w a off h v ≠ ampScr n w a := by
  intro he
  have hv := v.isLt
  have hb := (ampSig_facts n w a).1
  have h2 : ampEmb (n + (w + (a + 1))) off h v
      = (⟨3 * (n + (w + (a + 1))), by omega⟩ :
          Fin (3 * (n + (w + (a + 1))) + 1)) := hb.injective he
  have h3 : off + v.val = 3 * (n + (w + (a + 1))) := congrArg Fin.val h2
  omega

/-! ### Naming the three existentials that the bundle applies `Classical.choose` to

`Def_ShiClassQMAAmp` inlines these statements (a top-level declaration inhabiting a `Prop` is a
theorem whatever keyword introduces it, so the bundle could not export them).  Restating them
here recovers `Classical.choose_spec` on the NOSE: the distinctness and injectivity arguments
are proofs of propositions, hence definitionally irrelevant, so `Classical.choose` of the terms
below is definitionally `ampRead` / `ampFan2` / `ampFan3`. -/

private def ampReadEx (n w a : ℕ) (v : Fin (n + (w + (a + 1)))) :=
  ShiShallow.exists_majority_readout_at_wires_layerOk_depth
    (ampE n w a 0 (by omega) v)
    (ampE n w a (n + (w + (a + 1))) (by omega) v)
    (ampE n w a (2 * (n + (w + (a + 1)))) (by omega) v)
    (ampScr n w a)
    (ampE_ne n w a 0 (n + (w + (a + 1))) (by omega) (by omega) (by omega) v)
    (ampE_ne n w a 0 (2 * (n + (w + (a + 1)))) (by omega) (by omega) (by omega) v)
    (ampE_ne n w a (n + (w + (a + 1))) (2 * (n + (w + (a + 1)))) (by omega) (by omega)
      (by omega) v)
    (ampE_ne_scr n w a 0 (by omega) v)
    (ampE_ne_scr n w a (n + (w + (a + 1))) (by omega) v)
    (ampE_ne_scr n w a (2 * (n + (w + (a + 1)))) (by omega) v)

private def ampFanEx2 (n w a : ℕ) :=
  ShiShallow.exists_fanout_embedded_pullback n (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))
    (ampG2 n w a) (ampG2_inj n w a)

private def ampFanEx3 (n w a : ℕ) :=
  ShiShallow.exists_fanout_embedded_pullback n (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))
    (ampG3 n w a) (ampG3_inj n w a)

/-! ### The depth identity

`ampCirc` is `fan2 ++ fan3 ++ three embedded copies ++ readout`, `depth` is `List.length`, and
`ShiEmbed.embedCirc` is a `List.map`, so the length is `1 + 1 + 3 * depth (F.circ n) + 111`. -/

private theorem ampFamily_depth (F : QMAFamily) (n : ℕ) :
    depth ((ampFamily F).circ n) = 3 * depth (F.circ n) + 113 := by
  have h2 : (ampFan2 n (F.wit n) (F.anc n)).length = 1 :=
    (Classical.choose_spec (Classical.choose_spec (ampFanEx2 n (F.wit n) (F.anc n)))).2.2.2.2
  have h3 : (ampFan3 n (F.wit n) (F.anc n)).length = 1 :=
    (Classical.choose_spec (Classical.choose_spec (ampFanEx3 n (F.wit n) (F.anc n)))).2.2.2.2
  have hr : (ampRead n (F.wit n) (F.anc n) (F.out n)).length = 111 :=
    (Classical.choose_spec (ampReadEx n (F.wit n) (F.anc n) (F.out n))).2.2
  show depth (ampCirc F n) = 3 * depth (F.circ n) + 113
  simp only [ampCirc, ShiShallow.depth, ShiEmbed.embedCirc, List.length_append,
    List.length_map, h2, h3, hr]
  omega

/-! ### `WellFormed` and `PolyBounded`, via the accepted generic reductions -/

private theorem amp_hcirc (F : QMAFamily) (n : ℕ) :
    ∃ (g2 g3 : Fin (n + n) → Fin (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1))))
      (e1 e2 e3 : Fin (n + (F.wit n + (F.anc n + 1)))
        → Fin (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1))))
      (rd fan2 fan3 : Layered (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1))))
      (hg2 : Function.Injective g2) (hg3 : Function.Injective g3)
      (he1 : Function.Injective e1) (he2 : Function.Injective e2)
      (he3 : Function.Injective e3),
      fan2 = Classical.choose (ShiShallow.exists_fanout_embedded_pullback n
               (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1))) g2 hg2)
      ∧ fan3 = Classical.choose (ShiShallow.exists_fanout_embedded_pullback n
               (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1))) g3 hg3)
      ∧ (ampFamily F).circ n
          = fan2 ++ fan3
            ++ ShiEmbed.embedCirc e1 he1 (F.circ n)
            ++ ShiEmbed.embedCirc e2 he2 (F.circ n)
            ++ ShiEmbed.embedCirc e3 he3 (F.circ n) ++ rd
      ∧ (∀ l ∈ rd, LayerOk l) :=
  ⟨ampG2 n (F.wit n) (F.anc n), ampG3 n (F.wit n) (F.anc n),
    ampE n (F.wit n) (F.anc n) 0 (by omega),
    ampE n (F.wit n) (F.anc n) (n + (F.wit n + (F.anc n + 1))) (by omega),
    ampE n (F.wit n) (F.anc n) (2 * (n + (F.wit n + (F.anc n + 1)))) (by omega),
    ampRead n (F.wit n) (F.anc n) (F.out n),
    ampFan2 n (F.wit n) (F.anc n), ampFan3 n (F.wit n) (F.anc n),
    ampG2_inj n (F.wit n) (F.anc n), ampG3_inj n (F.wit n) (F.anc n),
    ampE_inj n (F.wit n) (F.anc n) 0 (by omega),
    ampE_inj n (F.wit n) (F.anc n) (n + (F.wit n + (F.anc n + 1))) (by omega),
    ampE_inj n (F.wit n) (F.anc n) (2 * (n + (F.wit n + (F.anc n + 1)))) (by omega),
    rfl, rfl, rfl,
    (Classical.choose_spec (ampReadEx n (F.wit n) (F.anc n) (F.out n))).2.1⟩

private theorem amp_wellFormed (F : QMAFamily) :
    ShiBQP.WellFormed F.toFamily → ShiBQP.WellFormed (ampFamily F).toFamily :=
  ShiClassQMA.wellFormed_amplified_pullback_fanout_decomposition ampFamily amp_hcirc F

private theorem amp_polyBounded (F : QMAFamily) :
    ShiBQP.PolyBounded F.toFamily → ShiBQP.PolyBounded (ampFamily F).toFamily :=
  ShiClassQMA.polyBounded_of_affine_depth_size_bounds ampFamily 3 0 113 3 2 3
    (fun G m => by
      have h := ampFamily_depth G m
      omega)
    (fun G m => by
      show 3 * G.wit m + (2 * m + 3 * G.anc m + 3) ≤ 3 * (G.wit m + G.anc m) + 2 * m + 3
      omega) F

/-! ### The concrete family used for non-vacuity

`wit = 1`, `anc = 0`, EMPTY circuit, output wire `0`.  All four amplified quantities are then
numerals, and because `depth (circ n) = 0` the depth conjunct reads exactly `113`. -/

private def ampTestF : QMAFamily :=
  { anc := fun _ => 0
    wit := fun _ => 1
    circ := fun _ => []
    out := fun _ => ⟨0, by omega⟩ }

/-- **The explicit threefold amplifier's resource identities.**

Stated about the PUBLISHED definition `ShiClassQMAAmp.ampFamily`, not about an existentially
quantified transformer: `wit -> 3 * wit`, `anc -> 2n + 3 * anc + 3`, output wire index
`3n + 3 * wit + 3 * anc + 3`, `depth -> 3 * depth + 113`, together with preservation of
`ShiBQP.WellFormed` and `ShiBQP.PolyBounded`, and a concrete family on which all four
quantities are numerals.

Every accepted analytic amplification theorem is generic in the transformer and takes exactly
the first four facts as hypotheses, so this instantiates all of them at `ampFamily`. -/
theorem _root_.QMAReferenceValidation.candidate4 :
    (∀ (F : ShiClassQMA.QMAFamily) (n : ℕ),
        (ShiClassQMAAmp.ampFamily F).wit n = 3 * F.wit n)
    ∧ (∀ (F : ShiClassQMA.QMAFamily) (n : ℕ),
        (ShiClassQMAAmp.ampFamily F).anc n = 2 * n + 3 * F.anc n + 3)
    ∧ (∀ (F : ShiClassQMA.QMAFamily) (n : ℕ),
        ((ShiClassQMAAmp.ampFamily F).out n).val
          = 3 * n + 3 * F.wit n + 3 * F.anc n + 3)
    ∧ (∀ (F : ShiClassQMA.QMAFamily) (n : ℕ),
        ShiShallow.depth ((ShiClassQMAAmp.ampFamily F).circ n)
          = 3 * ShiShallow.depth (F.circ n) + 113)
    ∧ (∀ F : ShiClassQMA.QMAFamily,
        ShiBQP.WellFormed F.toFamily →
          ShiBQP.WellFormed (ShiClassQMAAmp.ampFamily F).toFamily)
    ∧ (∀ F : ShiClassQMA.QMAFamily,
        ShiBQP.PolyBounded F.toFamily →
          ShiBQP.PolyBounded (ShiClassQMAAmp.ampFamily F).toFamily)
    ∧ (∃ F : ShiClassQMA.QMAFamily,
        (∀ n : ℕ, F.wit n = 1)
        ∧ (∀ n : ℕ, F.anc n = 0)
        ∧ (∀ n : ℕ, ShiShallow.depth (F.circ n) = 0)
        ∧ (ShiClassQMAAmp.ampFamily F).wit 0 = 3
        ∧ (ShiClassQMAAmp.ampFamily F).anc 0 = 3
        ∧ ((ShiClassQMAAmp.ampFamily F).out 0).val = 6
        ∧ ShiShallow.depth ((ShiClassQMAAmp.ampFamily F).circ 0) = 113) := by
