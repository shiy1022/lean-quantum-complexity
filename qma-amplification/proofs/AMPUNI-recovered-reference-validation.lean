  have hα0 : ∀ i : Bits w, 0 ≤ hA.eigenvalues i := fun i =>
    eigenvalues_nonneg_of_quadratic_form_nonneg A hA hlo i
  have hαs : ∀ i : Bits w, hA.eigenvalues i ≤ s := fun i =>
