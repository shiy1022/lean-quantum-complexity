set_option autoImplicit false

/-!
# `PolyBounded` is preserved by any AFFINE resource transformation

If a family transformer `T` inflates the depth and the (witness + ancilla) wire count by
arbitrary affine functions -- multiply by a constant, add a constant multiple of the input
length, add a constant -- then it maps polynomially bounded `QMAFamily`s to polynomially
bounded ones.  No resource constant is hard-coded: `ad, bd, cd, asz, bsz, csz` are universally
quantified, so any concrete construction can instantiate them with whatever it actually
achieves.

The witness polynomial is the SUM of the two affine bounds,
`C (ad + asz) * q + C (bd + bsz) * X + C (cd + csz)`, which dominates each of them because all
quantities are natural numbers.  No `max` is needed.

Recall `QMAFamily.toFamily` sets `anc := fun n => F.wit n + F.anc n`, so both the hypothesis
`PolyBounded F.toFamily` and the goal speak about that SUM -- which is why `hsize` is stated on
the sum and no separate witness-length hypothesis is required.
-/

/-- Evaluation of the affine witness polynomial. -/
private lemma shiPBG_eval (q : Polynomial ℕ) (A B Cc n : ℕ) :
    (Polynomial.C A * q + Polynomial.C B * Polynomial.X + Polynomial.C Cc).eval n
      = A * q.eval n + B * n + Cc := by
  first
  | (simp [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X];
     done)
  | (rw [Polynomial.eval_add, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_mul,
      Polynomial.eval_C, Polynomial.eval_C, Polynomial.eval_C, Polynomial.eval_X]; done)

/-- Monotonicity of an affine expression in all of its coefficients and in its argument. -/
private lemma shiPBG_step (a b c A B Cc fx qx n : ℕ) (ha : a ≤ A) (hb : b ≤ B) (hc : c ≤ Cc)
    (hf : fx ≤ qx) : a * fx + b * n + c ≤ A * qx + B * n + Cc :=
  Nat.add_le_add (Nat.add_le_add (Nat.mul_le_mul ha hf) (Nat.mul_le_mul hb (Nat.le_refl n))) hc

/-- **Affine resource bounds preserve `PolyBounded`.** -/
theorem _root_.QMAReferenceValidation.candidate16 (T : ShiClassQMA.QMAFamily → ShiClassQMA.QMAFamily)
    (ad bd cd asz bsz csz : ℕ)
    (hdepth : ∀ (F : ShiClassQMA.QMAFamily) (n : ℕ),
      ShiShallow.depth ((T F).circ n)
        ≤ ad * ShiShallow.depth (F.circ n) + bd * n + cd)
    (hsize : ∀ (F : ShiClassQMA.QMAFamily) (n : ℕ),
      (T F).wit n + (T F).anc n
        ≤ asz * (F.wit n + F.anc n) + bsz * n + csz) :
    ∀ F : ShiClassQMA.QMAFamily,
      ShiBQP.PolyBounded F.toFamily → ShiBQP.PolyBounded (T F).toFamily := by
  intro F hF
  rw [ShiBQP.PolyBounded] at hF
  obtain ⟨q, hqd, hqa⟩ := hF
  refine ⟨Polynomial.C (ad + asz) * q + Polynomial.C (bd + bsz) * Polynomial.X
      + Polynomial.C (cd + csz), ?_, ?_⟩
  · intro n
    have hd0 : ShiShallow.depth (F.circ n) ≤ q.eval n := hqd n
    have key : ShiShallow.depth ((T F).circ n)
        ≤ (Polynomial.C (ad + asz) * q + Polynomial.C (bd + bsz) * Polynomial.X
            + Polynomial.C (cd + csz)).eval n := by
      rw [shiPBG_eval]
      exact le_trans (hdepth F n)
        (shiPBG_step ad bd cd (ad + asz) (bd + bsz) (cd + csz) _ _ n
          (Nat.le_add_right ad asz) (Nat.le_add_right bd bsz) (Nat.le_add_right cd csz) hd0)
    first
    | (exact key)
    | (simp only [ShiClassQMA.QMAFamily.toFamily]; exact key)
  · intro n
    have hs0 : F.wit n + F.anc n ≤ q.eval n := hqa n
    have key : (T F).wit n + (T F).anc n
        ≤ (Polynomial.C (ad + asz) * q + Polynomial.C (bd + bsz) * Polynomial.X
            + Polynomial.C (cd + csz)).eval n := by
      rw [shiPBG_eval]
      exact le_trans (hsize F n)
        (shiPBG_step asz bsz csz (ad + asz) (bd + bsz) (cd + csz) _ _ n
          (Nat.le_add_left asz ad) (Nat.le_add_left bsz bd) (Nat.le_add_left csz cd) hs0)
    first
    | (exact key)
    | (simp only [ShiClassQMA.QMAFamily.toFamily]; exact key)

end QMAReferenceValidation.Source16

