/-!
# The structure package of the threefold amplifier, for the EXPLICIT `ampFamily`

`ShiClassQMA.exists_threefold_amplifier_structure_at_output_wires` proves the structure
package for an EXISTENTIALLY quantified `T`, and the construction realising it was `private`
to that submission, so nothing downstream could name the syntax it builds.  The construction
is now public as `Definitions.Def_ShiClassQMAAmp` (`ShiClassQMAAmp.ampFamily` and friends),
with bodies term-for-term those of the private originals.

This file proves the SAME package about `ShiClassQMAAmp.ampFamily F` -- no existential over
`T` -- so that the accepted analytic theorems, which are generic in `T`, apply to the
concrete published amplifier.  The statement is TCON4-1's fifth conjunct verbatim with
`T F` replaced by `ampFamily F`, and it is packaged as `.1` of a conjunction whose `.2` is a
non-degeneracy check at a concrete family (`wit = 1`, `anc = 0`, `circ = []`), where the
readout depth is checked at a literal numeral.

The proof is a replay: every private helper of TCON4-1 is re-derived here as a `private`
lemma ABOUT the published definitions.  Two mechanisms make the replay go through even
though the bundle inlined some of TCON4-1's private proof terms:

* the arguments that differ are PROOFS of propositions (injectivity, wire distinctness), and
  proof irrelevance in Lean 4 is definitional, so `Classical.choose` applied to the bundle's
  existential and to the locally restated one are the same term;
* the existential statements themselves (`ampRead`, `ampFan2`, `ampFan3` choose from them)
  are restated here as private `def`s of `Prop` type so that `Classical.choose_spec` lands
  on exactly the term the bundle's definition unfolds to.

`(ampFamily F).wit n`, `.anc n` and `.out n` appear in the statement as STRUCTURE
PROJECTIONS, while `σ`'s codomain is the NUMERAL form `n + (3 * F.wit n + (…))`, exactly as
in TCON4-1; with `ampFamily` concrete the two are definitionally equal, and every clause
relating them is stated on `.val`, so no cast appears anywhere.
-/

private theorem ap2_emb_inj (M off : ℕ) (hoff : off + M ≤ 3 * M) :
    Function.Injective (ampEmb M off hoff) := by
  intro x y he
  have h : off + x.val = off + y.val := congrArg Fin.val he
  exact Fin.val_injective (by omega)

private theorem ap2_fanEmb_inj (n M off : ℕ) (h1 : n ≤ off) (h2 : off + n ≤ 3 * M) :
    Function.Injective (ampFanEmb n M off h1 h2) := by
  intro x y he
  have hx := x.isLt
  have hy := y.isLt
  have h : ampFanVal n off x.val = ampFanVal n off y.val := congrArg Fin.val he
  apply Fin.val_injective
  simp only [ampFanVal] at h
  split_ifs at h <;> omega

/-- The five clauses of the layout that the construction itself needs. -/
private theorem ap2_sig_facts (n w a : ℕ) :
    Function.Bijective (ampSig n w a)
    ∧ (∀ v : Fin _, v.val = n + w + a → (ampSig n w a v).val = n + 3 * w + a)
    ∧ (∀ v : Fin _, v.val = n + (w + (a + 1)) + n + w + a →
        (ampSig n w a v).val = 2 * n + 3 * w + 2 * a + 1)
    ∧ (∀ v : Fin _, v.val = 2 * (n + (w + (a + 1))) + n + w + a →
        (ampSig n w a v).val = 3 * n + 3 * w + 3 * a + 2)
    ∧ (∀ v : Fin _, v.val = 3 * (n + (w + (a + 1))) →
        (ampSig n w a v).val = 3 * n + 3 * w + 3 * a + 3) := by
  obtain ⟨hb, -, -, -, h1, -, -, -, h2, -, -, -, h3, h4⟩ :=
    Classical.choose_spec (ShiShallow.exists_layout_bijection n w a)
  exact ⟨hb, h1, h2, h3, h4⟩

/-- The three INPUT-block clauses of the layout, which the fan-out needs. -/
private theorem ap2_sig_inputs (n w a : ℕ) :
    (∀ (v : Fin (3 * (n + (w + (a + 1))) + 1)) (j : ℕ), j < n →
        v.val = j → (ampSig n w a v).val = j)
    ∧ (∀ (v : Fin (3 * (n + (w + (a + 1))) + 1)) (j : ℕ), j < n →
        v.val = (n + (w + (a + 1))) + j →
        (ampSig n w a v).val = n + 3 * w + a + 1 + j)
    ∧ (∀ (v : Fin (3 * (n + (w + (a + 1))) + 1)) (j : ℕ), j < n →
        v.val = 2 * (n + (w + (a + 1))) + j →
        (ampSig n w a v).val = 2 * n + 3 * w + 2 * a + 2 + j) := by
  obtain ⟨-, k1, -, -, -, k2, -, -, -, k3, -, -, -, -⟩ :=
    Classical.choose_spec (ShiShallow.exists_layout_bijection n w a)
  exact ⟨k1, k2, k3⟩

private theorem ap2_scr_val (n w a : ℕ) :
    (ampScr n w a).val = 3 * n + 3 * w + 3 * a + 3 :=
  (ap2_sig_facts n w a).2.2.2.2 ⟨3 * (n + (w + (a + 1))), by omega⟩ rfl

private theorem ap2_ne_of_val {N : ℕ} {x y : Fin N} {p q : ℕ} (hx : x.val = p)
    (hy : y.val = q) (hpq : p ≠ q) : x ≠ y :=
  fun he => hpq (by rw [← hx, ← hy, he])

private theorem ap2_e_inj (n w a off : ℕ)
    (h : off + (n + (w + (a + 1))) ≤ 3 * (n + (w + (a + 1)))) :
    Function.Injective (ampE n w a off h) :=
  (ap2_sig_facts n w a).1.injective.comp (ap2_emb_inj _ _ h)

private theorem ap2_e_apply (n w a off : ℕ)
    (h : off + (n + (w + (a + 1))) ≤ 3 * (n + (w + (a + 1))))
    (v : Fin (n + (w + (a + 1)))) (u : Fin (3 * (n + (w + (a + 1))) + 1))
    (hu : u.val = off + v.val) : ampE n w a off h v = ampSig n w a u := by
  have he : ampEmb (n + (w + (a + 1))) off h v = u := by
    apply Fin.val_injective
    show off + v.val = u.val
    omega
  exact congrArg (ampSig n w a) he

/-! ### Distinctness of the four readout wires, from BIJECTIVITY of `σ` -/

private theorem ap2_sig_ne (n w a : ℕ) {p p' : Fin (3 * (n + (w + (a + 1))) + 1)}
    (h : p ≠ p') : ampSig n w a p ≠ ampSig n w a p' :=
  fun he => h ((ap2_sig_facts n w a).1.injective he)

private theorem ap2_e_sig (n w a off : ℕ)
    (h : off + (n + (w + (a + 1))) ≤ 3 * (n + (w + (a + 1))))
    (v : Fin (n + (w + (a + 1)))) (hp : off + v.val < 3 * (n + (w + (a + 1))) + 1) :
    ampE n w a off h v = ampSig n w a ⟨off + v.val, hp⟩ :=
  ap2_e_apply n w a off h v ⟨off + v.val, hp⟩ rfl

private theorem ap2_e_ne (n w a off off' : ℕ)
    (h : off + (n + (w + (a + 1))) ≤ 3 * (n + (w + (a + 1))))
    (h' : off' + (n + (w + (a + 1))) ≤ 3 * (n + (w + (a + 1))))
    (hoff : off ≠ off') (v : Fin (n + (w + (a + 1)))) :
    ampE n w a off h v ≠ ampE n w a off' h' v := by
  have hv := v.isLt
  have hp : off + v.val < 3 * (n + (w + (a + 1))) + 1 := by omega
  have hp' : off' + v.val < 3 * (n + (w + (a + 1))) + 1 := by omega
  rw [ap2_e_sig n w a off h v hp, ap2_e_sig n w a off' h' v hp']
  exact ap2_sig_ne n w a
    (ap2_ne_of_val (p := off + v.val) (q := off' + v.val) rfl rfl (by omega))

private theorem ap2_e_ne_scr (n w a off : ℕ)
    (h : off + (n + (w + (a + 1))) ≤ 3 * (n + (w + (a + 1))))
    (v : Fin (n + (w + (a + 1)))) :
    ampE n w a off h v ≠ ampScr n w a := by
  have hv := v.isLt
  have hp : off + v.val < 3 * (n + (w + (a + 1))) + 1 := by omega
  have hs : 3 * (n + (w + (a + 1))) < 3 * (n + (w + (a + 1))) + 1 := by omega
  have e0 : ampScr n w a = ampSig n w a ⟨3 * (n + (w + (a + 1))), hs⟩ := rfl
  rw [ap2_e_sig n w a off h v hp, e0]
  exact ap2_sig_ne n w a
    (ap2_ne_of_val (p := off + v.val) (q := 3 * (n + (w + (a + 1)))) rfl rfl (by omega))

/-- The readout existential, restated so that `Classical.choose_spec` lands on the very term
`ampRead` unfolds to.  The six distinctness arguments are proofs of propositions, hence
definitionally irrelevant, so this is the bundle's term. -/
private def ap2_readEx (n w a : ℕ) (v : Fin (n + (w + (a + 1)))) :=
  ShiShallow.exists_majority_readout_at_wires_layerOk_depth
    (ampE n w a 0 (by omega) v)
    (ampE n w a (n + (w + (a + 1))) (by omega) v)
    (ampE n w a (2 * (n + (w + (a + 1)))) (by omega) v)
    (ampScr n w a)
    (ap2_e_ne n w a 0 (n + (w + (a + 1))) (by omega) (by omega) (by omega) v)
    (ap2_e_ne n w a 0 (2 * (n + (w + (a + 1)))) (by omega) (by omega) (by omega) v)
    (ap2_e_ne n w a (n + (w + (a + 1))) (2 * (n + (w + (a + 1)))) (by omega) (by omega)
      (by omega) v)
    (ap2_e_ne_scr n w a 0 (by omega) v)
    (ap2_e_ne_scr n w a (n + (w + (a + 1))) (by omega) v)
    (ap2_e_ne_scr n w a (2 * (n + (w + (a + 1)))) (by omega) v)

private theorem ap2_read_spec (n w a : ℕ) (v : Fin (n + (w + (a + 1)))) :
    (∀ ψ : QState (n + (3 * w + ((2 * n + 3 * a + 3) + 1))),
        runLayered (ampRead n w a v) ψ
          = fun x => ψ (Function.update x (ampScr n w a)
              (xor (x (ampScr n w a))
                (xor (xor (x (ampE n w a 0 (by omega) v)
                            && x (ampE n w a (n + (w + (a + 1))) (by omega) v))
                        (x (ampE n w a (n + (w + (a + 1))) (by omega) v)
                            && x (ampE n w a (2 * (n + (w + (a + 1)))) (by omega) v)))
                  (x (ampE n w a 0 (by omega) v)
                      && x (ampE n w a (2 * (n + (w + (a + 1)))) (by omega) v))))))
    ∧ (∀ l ∈ ampRead n w a v, LayerOk l)
    ∧ depth (ampRead n w a v) = 111 :=
  Classical.choose_spec (ap2_readEx n w a v)

private theorem ap2_g_inj (n w a off : ℕ) (h1 : n ≤ off)
    (h2 : off + n ≤ 3 * (n + (w + (a + 1)))) :
    Function.Injective (ampG n w a off h1 h2) :=
  (ap2_sig_facts n w a).1.injective.comp (ap2_fanEmb_inj _ _ _ h1 h2)

private theorem ap2_g_apply (n w a off : ℕ) (h1 : n ≤ off)
    (h2 : off + n ≤ 3 * (n + (w + (a + 1)))) (v : Fin (n + n))
    (u : Fin (3 * (n + (w + (a + 1))) + 1)) (hu : u.val = ampFanVal n off v.val) :
    ampG n w a off h1 h2 v = ampSig n w a u := by
  have he : ampFanEmb n (n + (w + (a + 1))) off h1 h2 v = u := by
    apply Fin.val_injective
    show ampFanVal n off v.val = u.val
    omega
  exact congrArg (ampSig n w a) he

private theorem ap2_g2_inj (n w a : ℕ) : Function.Injective (ampG2 n w a) :=
  ap2_g_inj n w a (n + (w + (a + 1))) (by omega) (by omega)

private theorem ap2_g3_inj (n w a : ℕ) : Function.Injective (ampG3 n w a) :=
  ap2_g_inj n w a (2 * (n + (w + (a + 1)))) (by omega) (by omega)

private def ap2_fanEx2 (n w a : ℕ) :=
  ShiShallow.exists_fanout_embedded_pullback n (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))
    (ampG2 n w a) (ap2_g2_inj n w a)

private def ap2_fanEx3 (n w a : ℕ) :=
  ShiShallow.exists_fanout_embedded_pullback n (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))
    (ampG3 n w a) (ap2_g3_inj n w a)

private theorem ap2_fan2_spec (n w a : ℕ) :
    ∃ u : Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))
        → Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1))),
      (∀ Φ : QState (n + (3 * w + ((2 * n + 3 * a + 3) + 1))),
          runLayered (ampFan2 n w a) Φ = fun Y => Φ (u Y))
      ∧ (∀ (Y : Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))) (j : Fin n),
          u Y (ampG2 n w a (Fin.natAdd n j))
            = xor (Y (ampG2 n w a (Fin.natAdd n j))) (Y (ampG2 n w a (Fin.castAdd n j))))
      ∧ (∀ (Y : Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1))))
          (k : Fin (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))),
          (∀ j : Fin n, ampG2 n w a (Fin.natAdd n j) ≠ k) → u Y k = Y k)
      ∧ (∀ l ∈ ampFan2 n w a, LayerOk l)
      ∧ depth (ampFan2 n w a) = 1 :=
  Classical.choose_spec (ap2_fanEx2 n w a)

private theorem ap2_fan3_spec (n w a : ℕ) :
    ∃ u : Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))
        → Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1))),
      (∀ Φ : QState (n + (3 * w + ((2 * n + 3 * a + 3) + 1))),
          runLayered (ampFan3 n w a) Φ = fun Y => Φ (u Y))
      ∧ (∀ (Y : Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))) (j : Fin n),
          u Y (ampG3 n w a (Fin.natAdd n j))
            = xor (Y (ampG3 n w a (Fin.natAdd n j))) (Y (ampG3 n w a (Fin.castAdd n j))))
      ∧ (∀ (Y : Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1))))
          (k : Fin (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))),
          (∀ j : Fin n, ampG3 n w a (Fin.natAdd n j) ≠ k) → u Y k = Y k)
      ∧ (∀ l ∈ ampFan3 n w a, LayerOk l)
      ∧ depth (ampFan3 n w a) = 1 :=
  Classical.choose_spec (ap2_fanEx3 n w a)

private theorem ap2_p_val (n a : ℕ) (j : Fin n) :
    (ampP n a j).val = a + 1 + j.val := rfl

private theorem ap2_q_val (n a : ℕ) (j : Fin n) :
    (ampQ n a j).val = n + 2 * a + 2 + j.val := rfl

private theorem ap2_p_ne_q (n a : ℕ) (j j' : Fin n) : ampP n a j ≠ ampQ n a j' := by
  intro he
  have h : (ampP n a j).val = (ampQ n a j').val := congrArg Fin.val he
  have hp := ap2_p_val n a j
  have hq := ap2_q_val n a j'
  have hj := j.isLt
  have hj' := j'.isLt
  omega

private theorem ap2_val_castAdd (n m : ℕ) (j : Fin n) : (Fin.castAdd m j).val = j.val := by
  first | rfl | (simp; done)

private theorem ap2_val_natAdd (n m : ℕ) (j : Fin m) :
    (Fin.natAdd n j).val = n + j.val := by
  first | rfl | (simp; done)

private theorem ap2_fanVal_castAdd (n off : ℕ) (j : Fin n) :
    ampFanVal n off (Fin.castAdd n j).val = j.val := by
  have hj := j.isLt
  rw [ap2_val_castAdd n n j]
  simp only [ampFanVal]
  split_ifs <;> omega

private theorem ap2_fanVal_natAdd (n off : ℕ) (j : Fin n) :
    ampFanVal n off (Fin.natAdd n j).val = off + j.val := by
  rw [ap2_val_natAdd n n j]
  simp only [ampFanVal]
  split_ifs <;> omega

private theorem ap2_g_castAdd (n w a off : ℕ) (h1 : n ≤ off)
    (h2 : off + n ≤ 3 * (n + (w + (a + 1)))) (j : Fin n) :
    ampG n w a off h1 h2 (Fin.castAdd n j)
      = Fin.castAdd (3 * w + ((2 * n + 3 * a + 3) + 1)) j := by
  have hj := j.isLt
  have hg := ap2_g_apply n w a off h1 h2 (Fin.castAdd n j) ⟨j.val, by omega⟩
      (ap2_fanVal_castAdd n off j).symm
  apply Fin.val_injective
  rw [hg]
  have hs : (ampSig n w a ⟨j.val, by omega⟩).val = j.val :=
    (ap2_sig_inputs n w a).1 _ j.val hj rfl
  exact hs.trans (ap2_val_castAdd n (3 * w + ((2 * n + 3 * a + 3) + 1)) j).symm

private theorem ap2_g2_castAdd (n w a : ℕ) (j : Fin n) :
    ampG2 n w a (Fin.castAdd n j)
      = Fin.castAdd (3 * w + ((2 * n + 3 * a + 3) + 1)) j :=
  ap2_g_castAdd n w a (n + (w + (a + 1))) (by omega) (by omega) j

private theorem ap2_g3_castAdd (n w a : ℕ) (j : Fin n) :
    ampG3 n w a (Fin.castAdd n j)
      = Fin.castAdd (3 * w + ((2 * n + 3 * a + 3) + 1)) j :=
  ap2_g_castAdd n w a (2 * (n + (w + (a + 1)))) (by omega) (by omega) j

private theorem ap2_g2_natAdd (n w a : ℕ) (j : Fin n) :
    ampG2 n w a (Fin.natAdd n j)
      = Fin.natAdd n (Fin.natAdd (3 * w) (ampP n a j)) := by
  have hj := j.isLt
  have hg : ampG2 n w a (Fin.natAdd n j)
      = ampSig n w a ⟨n + (w + (a + 1)) + j.val, by omega⟩ :=
    ap2_g_apply n w a (n + (w + (a + 1))) (by omega) (by omega) (Fin.natAdd n j)
      ⟨n + (w + (a + 1)) + j.val, by omega⟩
      (ap2_fanVal_natAdd n (n + (w + (a + 1))) j).symm
  have hs : (ampSig n w a ⟨n + (w + (a + 1)) + j.val, by omega⟩).val
      = n + 3 * w + a + 1 + j.val :=
    (ap2_sig_inputs n w a).2.1 _ j.val hj rfl
  have hv : (Fin.natAdd n (Fin.natAdd (3 * w) (ampP n a j))).val
      = n + (3 * w + (a + 1 + j.val)) := by
    rw [ap2_val_natAdd, ap2_val_natAdd, ap2_p_val]
  have ha : n + 3 * w + a + 1 + j.val = n + (3 * w + (a + 1 + j.val)) := by omega
  apply Fin.val_injective
  rw [hg]
  exact hs.trans (ha.trans hv.symm)

private theorem ap2_g3_natAdd (n w a : ℕ) (j : Fin n) :
    ampG3 n w a (Fin.natAdd n j)
      = Fin.natAdd n (Fin.natAdd (3 * w) (ampQ n a j)) := by
  have hj := j.isLt
  have hg : ampG3 n w a (Fin.natAdd n j)
      = ampSig n w a ⟨2 * (n + (w + (a + 1))) + j.val, by omega⟩ :=
    ap2_g_apply n w a (2 * (n + (w + (a + 1)))) (by omega) (by omega) (Fin.natAdd n j)
      ⟨2 * (n + (w + (a + 1))) + j.val, by omega⟩
      (ap2_fanVal_natAdd n (2 * (n + (w + (a + 1)))) j).symm
  have hs : (ampSig n w a ⟨2 * (n + (w + (a + 1))) + j.val, by omega⟩).val
      = 2 * n + 3 * w + 2 * a + 2 + j.val :=
    (ap2_sig_inputs n w a).2.2 _ j.val hj rfl
  have hv : (Fin.natAdd n (Fin.natAdd (3 * w) (ampQ n a j))).val
      = n + (3 * w + (n + 2 * a + 2 + j.val)) := by
    rw [ap2_val_natAdd, ap2_val_natAdd, ap2_q_val]
  have ha : 2 * n + 3 * w + 2 * a + 2 + j.val = n + (3 * w + (n + 2 * a + 2 + j.val)) := by
    omega
  apply Fin.val_injective
  rw [hg]
  exact hs.trans (ha.trans hv.symm)

private theorem ap2_xor_transport (n w a : ℕ)
    (g : Fin (n + n) → Fin (n + (3 * w + ((2 * n + 3 * a + 3) + 1))))
    (r : Fin n → Fin (2 * n + 3 * a + 3 + 1))
    (hn : ∀ j : Fin n, g (Fin.natAdd n j) = Fin.natAdd n (Fin.natAdd (3 * w) (r j)))
    (hc : ∀ j : Fin n,
      g (Fin.castAdd n j) = Fin.castAdd (3 * w + ((2 * n + 3 * a + 3) + 1)) j)
    (u : Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1))) →
      Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1))))
    (hx : ∀ (Y : Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))) (j : Fin n),
      u Y (g (Fin.natAdd n j))
        = xor (Y (g (Fin.natAdd n j))) (Y (g (Fin.castAdd n j)))) :
    ∀ (Y : Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))) (j : Fin n),
      u Y (Fin.natAdd n (Fin.natAdd (3 * w) (r j)))
        = xor (Y (Fin.natAdd n (Fin.natAdd (3 * w) (r j))))
            (Y (Fin.castAdd (3 * w + ((2 * n + 3 * a + 3) + 1)) j)) := by
  intro Y j
  rw [← hn j, ← hc j]
  exact hx Y j

private theorem ap2_untouched_transport (n w a : ℕ)
    (g : Fin (n + n) → Fin (n + (3 * w + ((2 * n + 3 * a + 3) + 1))))
    (r : Fin n → Fin (2 * n + 3 * a + 3 + 1))
    (hn : ∀ j : Fin n, g (Fin.natAdd n j) = Fin.natAdd n (Fin.natAdd (3 * w) (r j)))
    (u : Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1))) →
      Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1))))
    (hu : ∀ (Y : Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1))))
      (k : Fin (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))),
      (∀ j : Fin n, g (Fin.natAdd n j) ≠ k) → u Y k = Y k) :
    ∀ (Y : Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1))))
      (k : Fin (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))),
      (∀ j : Fin n, Fin.natAdd n (Fin.natAdd (3 * w) (r j)) ≠ k) → u Y k = Y k := by
  intro Y k hk
  refine hu Y k ?_
  intro j he
  exact hk j ((hn j).symm.trans he)

/-- The non-degeneracy family: one witness wire, no ancilla beyond the output wire, empty
circuit.  Kept `private` so the public statement has exactly one declaration; it appears in
the statement only through its inlined structure literal. -/
private def ap2_F0 : QMAFamily :=
  { anc := fun _ => 0
    wit := fun _ => 1
    circ := fun _ => []
    out := fun n => ⟨0, by omega⟩ }

/-- The amplified depth, re-derived exactly as TCON4-1 derives it, so that the concrete-`F`
depth check below rests on the same arithmetic rather than on a separate evaluation. -/
private theorem ap2_depth (F : QMAFamily) (n : ℕ) :
    depth ((ampFamily F).circ n) = 3 * depth (F.circ n) + 113 := by
  have h2 : (ampFan2 n (F.wit n) (F.anc n)).length = 1 := by
    obtain ⟨-, -, -, -, -, h⟩ := ap2_fan2_spec n (F.wit n) (F.anc n)
    exact h
  have h3 : (ampFan3 n (F.wit n) (F.anc n)).length = 1 := by
    obtain ⟨-, -, -, -, -, h⟩ := ap2_fan3_spec n (F.wit n) (F.anc n)
    exact h
  have hr : (ampRead n (F.wit n) (F.anc n) (F.out n)).length = 111 :=
    (ap2_read_spec n (F.wit n) (F.anc n) (F.out n)).2.2
  show depth (ampCirc F n) = 3 * depth (F.circ n) + 113
  simp only [ampCirc, ShiShallow.depth, ShiEmbed.embedCirc, List.length_append,
    List.length_map, h2, h3, hr]
  omega

private theorem ap2_F0_circ :
    (ampFamily ap2_F0).circ 2
      = ampFan2 2 1 0 ++ ampFan3 2 1 0 ++ [] ++ [] ++ []
          ++ ampRead 2 1 0 ⟨0, by omega⟩ := by
  first
    | rfl
    | (show ampCirc ap2_F0 2 = _
       rfl)
    | simp only [ampCirc, ap2_F0, ShiEmbed.embedCirc, List.map_nil]

/-- The structure package of TCON4-1's fifth conjunct, about the EXPLICIT published
amplifier `ShiClassQMAAmp.ampFamily` rather than an existentially quantified `T`, so that the
accepted analytic theorems -- which are generic in `T` -- apply to it verbatim: hand `.1` of
this to `ShiClassQMA.amplified_acceptWith_le_maj3_of_single_copy_bound` and friends in place
of their `hstruct` argument.  `σ` and both fan-outs are pinned to closed `Classical.choose`
terms, and the readout is stated at the three copies' OWN output wires
`e1 (F.out n)`, `e2 (F.out n)`, `e3 (F.out n)`, so it is valid for an arbitrary
`QMAFamily.out` field.  The second component is the non-degeneracy check at
`wit = 1`, `anc = 0`, `circ = []`: the decomposition really collapses to the two fan-outs
followed by the readout, and the readout depth is `111` at a literal numeral, hence the
amplified circuit has depth `113` there. -/
theorem _root_.QMAReferenceValidation.candidate5 :
    (∀ (F : QMAFamily) (n : ℕ),
      ∃ (σ : Fin (3 * (n + (F.wit n + (F.anc n + 1))) + 1)
            → Fin (n + (3 * F.wit n + ((2 * n + 3 * F.anc n + 3) + 1))))
        (g2 g3 : Fin (n + n)
          → Fin (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1))))
        (p q : Fin n → Fin ((ampFamily F).anc n + 1))
        (e1 e2 e3 : Fin (n + (F.wit n + (F.anc n + 1)))
          → Fin (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1))))
        (rd fan2 fan3 : Layered (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1))))
        (u2 u3 : Bits (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1)))
          → Bits (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1))))
        (hg2 : Function.Injective g2) (hg3 : Function.Injective g3)
        (he1 : Function.Injective e1) (he2 : Function.Injective e2)
        (he3 : Function.Injective e3),
        σ = Classical.choose (ShiShallow.exists_layout_bijection n (F.wit n) (F.anc n))
        ∧ fan2 = Classical.choose (ShiShallow.exists_fanout_embedded_pullback n
            (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1))) g2 hg2)
        ∧ fan3 = Classical.choose (ShiShallow.exists_fanout_embedded_pullback n
            (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1))) g3 hg3)
        ∧ (ampFamily F).circ n
            = fan2 ++ fan3
              ++ ShiEmbed.embedCirc e1 he1 (F.circ n)
              ++ ShiEmbed.embedCirc e2 he2 (F.circ n)
              ++ ShiEmbed.embedCirc e3 he3 (F.circ n) ++ rd
        ∧ (∀ (v : Fin (n + (F.wit n + (F.anc n + 1)))) (u : Fin _),
            u.val = v.val → (e1 v).val = (σ u).val)
        ∧ (∀ (v : Fin (n + (F.wit n + (F.anc n + 1)))) (u : Fin _),
            u.val = n + (F.wit n + (F.anc n + 1)) + v.val → (e2 v).val = (σ u).val)
        ∧ (∀ (v : Fin (n + (F.wit n + (F.anc n + 1)))) (u : Fin _),
            u.val = 2 * (n + (F.wit n + (F.anc n + 1))) + v.val →
            (e3 v).val = (σ u).val)
        ∧ (∀ (v : Fin (n + n)) (u : Fin _),
            u.val
              = (if v.val < n then v.val
                  else n + (F.wit n + (F.anc n + 1)) + (v.val - n)) →
            (g2 v).val = (σ u).val)
        ∧ (∀ (v : Fin (n + n)) (u : Fin _),
            u.val
              = (if v.val < n then v.val
                  else 2 * (n + (F.wit n + (F.anc n + 1))) + (v.val - n)) →
            (g3 v).val = (σ u).val)
        ∧ (∀ j : Fin n, (p j).val = F.anc n + 1 + j.val)
        ∧ (∀ j : Fin n, (q j).val = n + 2 * F.anc n + 2 + j.val)
        ∧ (∀ j j' : Fin n, p j ≠ q j')
        ∧ (∀ Φ : QState (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1))),
            runLayered fan2 Φ = fun Y => Φ (u2 Y))
        ∧ (∀ (Y : Bits (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1))))
            (j : Fin n),
            u2 Y (Fin.natAdd n (Fin.natAdd ((ampFamily F).wit n) (p j)))
              = xor (Y (Fin.natAdd n (Fin.natAdd ((ampFamily F).wit n) (p j))))
                  (Y (Fin.castAdd ((ampFamily F).wit n + ((ampFamily F).anc n + 1)) j)))
        ∧ (∀ (Y : Bits (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1))))
            (k : Fin (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1)))),
            (∀ j : Fin n, Fin.natAdd n (Fin.natAdd ((ampFamily F).wit n) (p j)) ≠ k) →
              u2 Y k = Y k)
        ∧ (∀ Φ : QState (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1))),
            runLayered fan3 Φ = fun Y => Φ (u3 Y))
        ∧ (∀ (Y : Bits (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1))))
            (j : Fin n),
            u3 Y (Fin.natAdd n (Fin.natAdd ((ampFamily F).wit n) (q j)))
              = xor (Y (Fin.natAdd n (Fin.natAdd ((ampFamily F).wit n) (q j))))
                  (Y (Fin.castAdd ((ampFamily F).wit n + ((ampFamily F).anc n + 1)) j)))
        ∧ (∀ (Y : Bits (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1))))
            (k : Fin (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1)))),
            (∀ j : Fin n, Fin.natAdd n (Fin.natAdd ((ampFamily F).wit n) (q j)) ≠ k) →
              u3 Y k = Y k)
        ∧ (∀ ψ : QState (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1))),
            runLayered rd ψ
              = fun x => ψ (Function.update x ((ampFamily F).out n)
                  (xor (x ((ampFamily F).out n))
                    (xor (xor (x (e1 (F.out n)) && x (e2 (F.out n)))
                            (x (e2 (F.out n)) && x (e3 (F.out n))))
                      (x (e1 (F.out n)) && x (e3 (F.out n)))))))
        ∧ (∀ l ∈ rd, LayerOk l)
        ∧ depth rd = 111)
    ∧ ((ampFamily
          { anc := fun _ => 0, wit := fun _ => 1, circ := fun _ => [],
            out := fun n => ⟨0, by omega⟩ }).circ 2
          = ampFan2 2 1 0 ++ ampFan3 2 1 0 ++ [] ++ [] ++ []
              ++ ampRead 2 1 0 ⟨0, by omega⟩
        ∧ depth (ampRead 2 1 0 ⟨0, by omega⟩) = 111
        ∧ depth ((ampFamily
            { anc := fun _ => 0, wit := fun _ => 1, circ := fun _ => [],
              out := fun n => ⟨0, by omega⟩ }).circ 2) = 113) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro F n
    obtain ⟨hrs, hrok, hrdep⟩ := ap2_read_spec n (F.wit n) (F.anc n) (F.out n)
    obtain ⟨u2, h2a, h2x, h2u, -, -⟩ := ap2_fan2_spec n (F.wit n) (F.anc n)
    obtain ⟨u3, h3a, h3x, h3u, -, -⟩ := ap2_fan3_spec n (F.wit n) (F.anc n)
    refine ⟨ampSig n (F.wit n) (F.anc n),
      ampG2 n (F.wit n) (F.anc n), ampG3 n (F.wit n) (F.anc n),
      ampP n (F.anc n), ampQ n (F.anc n),
      ampE n (F.wit n) (F.anc n) 0 (by omega),
      ampE n (F.wit n) (F.anc n) (n + (F.wit n + (F.anc n + 1))) (by omega),
      ampE n (F.wit n) (F.anc n) (2 * (n + (F.wit n + (F.anc n + 1)))) (by omega),
      ampRead n (F.wit n) (F.anc n) (F.out n),
      ampFan2 n (F.wit n) (F.anc n), ampFan3 n (F.wit n) (F.anc n), u2, u3,
      ap2_g2_inj n (F.wit n) (F.anc n), ap2_g3_inj n (F.wit n) (F.anc n),
      ap2_e_inj n (F.wit n) (F.anc n) 0 (by omega),
      ap2_e_inj n (F.wit n) (F.anc n) (n + (F.wit n + (F.anc n + 1))) (by omega),
      ap2_e_inj n (F.wit n) (F.anc n) (2 * (n + (F.wit n + (F.anc n + 1)))) (by omega),
      rfl, rfl, rfl, rfl, ?_, ?_, ?_, ?_, ?_,
      ap2_p_val n (F.anc n), ap2_q_val n (F.anc n), ap2_p_ne_q n (F.anc n),
      h2a,
      ap2_xor_transport n (F.wit n) (F.anc n) (ampG2 n (F.wit n) (F.anc n))
        (ampP n (F.anc n)) (ap2_g2_natAdd n (F.wit n) (F.anc n))
        (ap2_g2_castAdd n (F.wit n) (F.anc n)) u2 h2x,
      ap2_untouched_transport n (F.wit n) (F.anc n) (ampG2 n (F.wit n) (F.anc n))
        (ampP n (F.anc n)) (ap2_g2_natAdd n (F.wit n) (F.anc n)) u2 h2u,
      h3a,
      ap2_xor_transport n (F.wit n) (F.anc n) (ampG3 n (F.wit n) (F.anc n))
        (ampQ n (F.anc n)) (ap2_g3_natAdd n (F.wit n) (F.anc n))
        (ap2_g3_castAdd n (F.wit n) (F.anc n)) u3 h3x,
      ap2_untouched_transport n (F.wit n) (F.anc n) (ampG3 n (F.wit n) (F.anc n))
        (ampQ n (F.anc n)) (ap2_g3_natAdd n (F.wit n) (F.anc n)) u3 h3u,
      ?_, hrok, hrdep⟩
    · intro v u hu
      exact congrArg Fin.val (ap2_e_apply n (F.wit n) (F.anc n) 0 (by omega) v u (by omega))
    · intro v u hu
      exact congrArg Fin.val (ap2_e_apply n (F.wit n) (F.anc n)
        (n + (F.wit n + (F.anc n + 1))) (by omega) v u hu)
    · intro v u hu
      exact congrArg Fin.val (ap2_e_apply n (F.wit n) (F.anc n)
        (2 * (n + (F.wit n + (F.anc n + 1)))) (by omega) v u hu)
    · intro v u hu
      exact congrArg Fin.val (ap2_g_apply n (F.wit n) (F.anc n)
        (n + (F.wit n + (F.anc n + 1))) (by omega) (by omega) v u hu)
    · intro v u hu
      exact congrArg Fin.val (ap2_g_apply n (F.wit n) (F.anc n)
        (2 * (n + (F.wit n + (F.anc n + 1)))) (by omega) (by omega) v u hu)
    · exact hrs
  · exact ap2_F0_circ
  · exact (ap2_read_spec 2 1 0 ⟨0, by omega⟩).2.2
  · have hd := ap2_depth ap2_F0 2
    have h0 : depth (ap2_F0.circ 2) = 0 := rfl
    show depth ((ampFamily ap2_F0).circ 2) = 113
    rw [h0] at hd
    omega

