namespace QMAReferenceValidation.Source6
/-
# Bridge (readout seam): acceptance weight of an amplified QMA family
  = scratch-false majority weight of the pre-readout state

Let `G` be a `QMAFamily` whose circuit at length `n` FACTORS as an action part `cA` followed by a
majority-readout part `rd` that XORs `maj3 (z w1) (z w2) (z w3)` into the output wire `G.out n`.
This file shows that `G.acceptWith x Psi` -- the accept weight AT the output wire of the run on the
witness input state -- equals the weight, in the PRE-readout state `runLayered cA (witnessInputState
G x Psi)`, of the basis strings whose scratch bit is `false` and at least two of whose three
designated wires read `true`.

`Psi` is an ARBITRARY `QState (G.wit n)`: no product structure, no normalisation, and no
independence between the witness blocks is assumed anywhere.  The only assumption on the action
part `cA` is `hInit`: the pre-readout state vanishes on strings whose scratch bit is `true`.

Instantiating `G := T F` with the decomposition and the `rd` semantics clause of
`ShiClassQMA.exists_threefold_amplifier_structure` (there `cA` is the five-fold append
`fanout2 ++ fanout3 ++ copy1 ++ copy2 ++ copy3`, associated to the LEFT, and `w1 w2 w3` are the
three copies' output wires) turns the amplified family's accept weight into a majority weight of
the three copies, which is the form the spectral soundness bound consumes.

Cited, all published: `ShiShallow.runLayered_append_action_readout` (peel the readout off the
action part), `ShiShallow.majority3_accum` (the three accumulating Toffolis compose to the single
XOR-in of the majority polynomial), and
`ShiShallow.majority_readout_scratch_accept_weight_eq_majority_weight` (accept weight after the
readout = scratch-false majority weight before it).
-/

set_option autoImplicit false

open ShiShallow ShiClassQMA

/-! ### Two Boolean bookkeeping facts -/

/-- The amplifier's readout writes `xor (z out) (maj-polynomial)`; the accumulating-Toffoli normal
form of `ShiShallow.majority3_accum` writes the same bit left-associated and with the last
conjunction transposed.  Pure `Bool` algebra. -/
private lemma shiBr_xor_shuffle (a b c d : Bool) :
    xor a (xor (xor (b && c) (c && d)) (b && d))
      = xor (xor (xor a (b && c)) (c && d)) (d && b) := by
  cases a <;> cases b <;> cases c <;> cases d <;> decide

/-- The majority polynomial `ab + bc + ca` over `GF(2)` IS the majority indicator. -/
private lemma shiBr_maj (a b c : Bool) :
    xor (xor (a && b) (b && c)) (c && a)
      = (if (2 : ℕ) ≤ (if a then (1 : ℕ) else 0) + (if b then (1 : ℕ) else 0)
            + (if c then (1 : ℕ) else 0) then true else false) := by
  cases a <;> cases b <;> cases c <;> decide

/-! ### The bridge -/

/-- **Readout seam of the threefold amplifier.**  If the amplified family's circuit factors as an
action part `cA` followed by the majority readout `rd` (as
`ShiClassQMA.exists_threefold_amplifier_structure` provides), and if the pre-readout state vanishes
whenever the scratch/output wire reads `true` (`hInit`), then the acceptance weight at the output
wire equals the weight, in the pre-readout state, of the strings with scratch bit `false` and at
least two of `w1, w2, w3` set.

`Psi` is arbitrary: entangled witnesses are covered. -/
theorem _root_.QMAReferenceValidation.candidate6 {n : ℕ} (G : QMAFamily) (x : Bits n) (Psi : QState (G.wit n))
    (cA rd : Layered (n + (G.wit n + (G.anc n + 1))))
    (w1 w2 w3 : Fin (n + (G.wit n + (G.anc n + 1))))
    (h1 : w1 ≠ G.out n) (h2 : w2 ≠ G.out n) (h3 : w3 ≠ G.out n)
    (hcirc : G.circ n = cA ++ rd)
    (hrd : ∀ ψ : QState (n + (G.wit n + (G.anc n + 1))),
      runLayered rd ψ
        = fun z => ψ (Function.update z (G.out n)
            (xor (z (G.out n))
              (xor (xor (z w1 && z w2) (z w2 && z w3)) (z w1 && z w3)))))
    (hInit : ∀ z : Bits (n + (G.wit n + (G.anc n + 1))),
      z (G.out n) = true → runLayered cA (witnessInputState G x Psi) z = 0) :
    G.acceptWith x Psi
      = ∑ z : Bits (n + (G.wit n + (G.anc n + 1))),
          (if z (G.out n) = false ∧ (2 : ℕ) ≤ (if z w1 then (1 : ℕ) else 0)
                + (if z w2 then (1 : ℕ) else 0) + (if z w3 then (1 : ℕ) else 0)
            then ‖runLayered cA (witnessInputState G x Psi) z‖ ^ 2 else 0) := by
  -- the three accumulating Toffolis of the readout, in single-update normal form
  have hTri := ShiShallow.majority3_accum w1 w2 w3 (G.out n) h1 h2 h3
      (fun p q r ψ => fun z => ψ (Function.update z r (xor (z r) (z p && z q))))
      (fun _ _ _ _ => rfl) (runLayered cA (witnessInputState G x Psi))
  -- accept weight after the readout = scratch-false majority weight before it
  have key := ShiShallow.majority_readout_scratch_accept_weight_eq_majority_weight
      w1 w2 w3 (G.out n) h1 h2 h3 (runLayered cA (witnessInputState G x Psi)) hInit
      (fun p q r ψ => fun z => ψ (Function.update z r (xor (z r) (z p && z q))))
      (fun φ => ShiShallow.majority3_accum w1 w2 w3 (G.out n) h1 h2 h3
        (fun p q r ψ => fun z => ψ (Function.update z r (xor (z r) (z p && z q))))
        (fun _ _ _ _ => rfl) φ)
      shiBr_maj
  -- peel the readout off the action part, and match the two spellings of the majority polynomial
  have hrun : runLayered (G.circ n) (witnessInputState G x Psi)
      = fun z => runLayered cA (witnessInputState G x Psi)
          (Function.update z (G.out n)
            (xor (xor (xor (z (G.out n)) (z w1 && z w2)) (z w2 && z w3)) (z w3 && z w1))) := by
    rw [hcirc, ShiShallow.runLayered_append_action_readout cA rd
      (fun ψ => runLayered cA ψ)
      (fun z => Function.update z (G.out n)
        (xor (z (G.out n))
          (xor (xor (z w1 && z w2) (z w2 && z w3)) (z w1 && z w3))))
      (fun _ => rfl) hrd (witnessInputState G x Psi)]
    funext z
    exact congrArg
      (fun b => runLayered cA (witnessInputState G x Psi)
        (Function.update z (G.out n) b))
      (shiBr_xor_shuffle (z (G.out n)) (z w1) (z w2) (z w3))
  -- Build the hypothesis in the shape we need instead of rewriting `key`: chaining `hrun`
  -- with `hTri.symm` is a pure `Eq.trans`, checked up to defeq, so the differing
  -- beta-reduction depths of the two sides are irrelevant.
  have hfun := hrun.trans hTri.symm
  show (∑ y : Bits (n + (G.wit n + (G.anc n + 1))),
      if y (G.out n) = true then
        ‖runLayered (G.circ n) (witnessInputState G x Psi) y‖ ^ 2 else 0) = _
  first
    | (refine Eq.trans (Finset.sum_congr rfl (fun y _ => ?_)) key;
       exact congrArg (fun v : ℂ => if y (G.out n) = true then ‖v‖ ^ 2 else 0)
         (congrFun hfun y);
       done)
    | (rw [hfun]; exact key; done)
    | (simp only [hTri] at key; rw [hrun]; exact key; done)

end QMAReferenceValidation.Source6

