namespace QMAReferenceValidation.Source14
/-
WACC-1: the WITNESS-SPACE acceptance operator of a QMA verifier.

WHY THIS PIECE.  `ShiTensor.quadratic_form_three_block_majority_le_of_bound` (and `SNDR-1`) bound
the majority polynomial of an ABSTRACT Hermitian `A` whose quadratic form lies in `[0, s]` at every
normalized vector.  That hypothesis is UNSATISFIABLE for `s < 1` if `A` is taken to be a circuit's
acceptance operator `P = star C * projOut out * C` on the CIRCUIT register: `C` unitary makes `P`
idempotent, and a nonzero projector's quadratic form attains `1` on its range.  (That is exactly the
defect of `ShiTensor.majority_weight_three_copies_le_of_single_copy_bound` and
`ShiShallow.acceptOperator_eigenvalues_in_zero_s`, which are vacuous and are NOT cited here.)

THE REPAIR, supplied by this file: pull the acceptance operator back to the WITNESS register.  Let
`W` be the isometric embedding sending a witness `psi` to the witness-carrying input state
(`witnessInputState`), and set

  A := W.conjTranspose * (star C * projOut out * C) * W   on `Op (F.wit n)`.

Then the quadratic form of `A` at `psi` IS `F.acceptWith x psi`, so a QMA soundness hypothesis
`forall normalized psi, F.acceptWith x psi <= s` becomes, verbatim, the `[0, s]` quadratic-form
hypothesis that the majority bound consumes.

NOT A PROJECTOR -- the whole point.  `W` is an isometry, NOT a unitary: `W.conjTranspose * W = 1`
on the witness register, but `W * W.conjTranspose` is the projector `Pi` onto the
`{input = x, ancillas = 0}` subspace, which is a PROPER subspace whenever `n + F.anc n + 1 > 0`.
Hence `A * A = W.conjTranspose * P * Pi * P * W`, which differs from
`A = W.conjTranspose * P * W` in general, because `P` moves vectors out of the range of `Pi`.
`A` is a COMPRESSION of a projector to a subspace, and compressions of projectors are not
idempotent; its eigenvalues are the acceptance probabilities of the eigen-witnesses, which for a
sound verifier lie strictly inside `[0, 1]`.  So `hqf` with `s < 1` is satisfiable here, and the
majority bound applied to this `A` is not vacuous.

CONSTRUCTION CHOICE: `W` is built as an honest rectangular MATRIX
`Matrix (Bits (n + (F.wit n + (F.anc n + 1)))) (Bits (F.wit n)) Complex` (`shiWA_emb`), not
entrywise, because then `Matrix.mulVec W psi = witnessInputState F x psi` is one `funext` plus a
single-term sum, and the two operator-level facts (Hermitian-ness, quadratic-form transfer) are
generic matrix algebra proved once for an arbitrary rectangular `V` (`shiWA_conj_herm`,
`shiWA_adjoint`, `shiWA_mulVec_conj`), with no index arithmetic at all.

Cited platform theorems (both Proved): `ShiClassQMA.acceptWith_eq_quadratic_form`,
`ShiShallow.acceptOperator_isHermitian`.

Built against Mathlib at revision 0df444a360eaa60ab8c11dca51a86af692955474.
-/

set_option autoImplicit false

open ShiShallow
open ShiClassQMA

/-! ### Part A: generic rectangular-conjugation algebra -/

/-- Conjugating a Hermitian operator by a rectangular matrix stays Hermitian. -/
private lemma shiWA_conj_herm {iota kappa : Type} [Fintype iota] [Fintype kappa]
    (V : Matrix iota kappa ℂ) (P : Matrix iota iota ℂ) (hP : P.IsHermitian) :
    (V.conjTranspose * P * V).IsHermitian := by
  have h : (V.conjTranspose * P * V).conjTranspose = V.conjTranspose * P * V := by
    rw [Matrix.conjTranspose_mul, Matrix.conjTranspose_mul,
      Matrix.conjTranspose_conjTranspose, hP.eq, Matrix.mul_assoc]
  exact h

/-- `(Vᴴ P V) psi = Vᴴ (P (V psi))`, as vectors. -/
private lemma shiWA_mulVec_conj {iota kappa : Type} [Fintype iota] [Fintype kappa]
    (V : Matrix iota kappa ℂ) (P : Matrix iota iota ℂ) (psi : kappa → ℂ) :
    Matrix.mulVec (V.conjTranspose * P * V) psi
      = Matrix.mulVec V.conjTranspose (Matrix.mulVec P (Matrix.mulVec V psi)) := by
  first
  | (simp only [Matrix.mulVec_mulVec, Matrix.mul_assoc]; done)
  | (rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec]; done)
  | rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, Matrix.mul_assoc]

/-- The adjoint relation: moving `Vᴴ` across the sesquilinear pairing. -/
private lemma shiWA_adjoint {iota kappa : Type} [Fintype iota] [Fintype kappa]
    (V : Matrix iota kappa ℂ) (psi : kappa → ℂ) (z : iota → ℂ) :
    (∑ u : kappa, (starRingEnd ℂ) (psi u) * Matrix.mulVec V.conjTranspose z u)
      = ∑ y : iota, (starRingEnd ℂ) (Matrix.mulVec V psi y) * z y := by
  have hL : (∑ u : kappa, (starRingEnd ℂ) (psi u) * Matrix.mulVec V.conjTranspose z u)
      = dotProduct (star psi) (Matrix.mulVec V.conjTranspose z) := by
    first
    | rfl
    | (simp only [dotProduct, Pi.star_apply, starRingEnd_apply]; done)
  have hR : (∑ y : iota, (starRingEnd ℂ) (Matrix.mulVec V psi y) * z y)
      = dotProduct (star (Matrix.mulVec V psi)) z := by
    first
    | rfl
    | (simp only [dotProduct, Pi.star_apply, starRingEnd_apply]; done)
  rw [hL, hR, Matrix.dotProduct_mulVec, Matrix.vecMul_conjTranspose, star_star]

/-! ### Part B: the witness embedding as a rectangular matrix -/

/-- `shiWA_emb F x` sends a witness amplitude vector on `Bits (F.wit n)` to the
witness-carrying input state: its `(y, u)` entry is `1` exactly when `y` reads `x` on the input
block, is all-`false` on the ancilla block, and reads `u` on the witness block. -/
private def shiWA_emb {n : ℕ} (F : QMAFamily) (x : Bits n) :
    Matrix (Bits (n + (F.wit n + (F.anc n + 1)))) (Bits (F.wit n)) ℂ :=
  Matrix.of fun y u =>
    if ((∀ i : Fin n, y (Fin.castAdd (F.wit n + (F.anc n + 1)) i) = x i) ∧
        (∀ l : Fin (F.anc n + 1), y (Fin.natAdd n (Fin.natAdd (F.wit n) l)) = false)) ∧
       (∀ j : Fin (F.wit n), y (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j)) = u j)
    then 1 else 0

private lemma shiWA_emb_apply {n : ℕ} (F : QMAFamily) (x : Bits n)
    (y : Bits (n + (F.wit n + (F.anc n + 1)))) (u : Bits (F.wit n)) :
    shiWA_emb F x y u
      = if ((∀ i : Fin n, y (Fin.castAdd (F.wit n + (F.anc n + 1)) i) = x i) ∧
            (∀ l : Fin (F.anc n + 1), y (Fin.natAdd n (Fin.natAdd (F.wit n) l)) = false)) ∧
           (∀ j : Fin (F.wit n), y (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j)) = u j)
        then 1 else 0 := rfl

/-- The embedding matrix really does produce `witnessInputState`. -/
private lemma shiWA_mulVec_emb {n : ℕ} (F : QMAFamily) (x : Bits n) (psi : QState (F.wit n)) :
    Matrix.mulVec (shiWA_emb F x) psi = witnessInputState F x psi := by
  funext y
  have hmv : Matrix.mulVec (shiWA_emb F x) psi y
      = ∑ u : Bits (F.wit n), shiWA_emb F x y u * psi u := by
    first
    | rfl
    | (simp only [Matrix.mulVec, dotProduct]; done)
  by_cases hy : (∀ i : Fin n, y (Fin.castAdd (F.wit n + (F.anc n + 1)) i) = x i) ∧
      (∀ l : Fin (F.anc n + 1), y (Fin.natAdd n (Fin.natAdd (F.wit n) l)) = false)
  · have h0 : ∀ b ∈ (Finset.univ : Finset (Bits (F.wit n))),
        b ≠ (fun j : Fin (F.wit n) => y (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))) →
        shiWA_emb F x y b * psi b = 0 := by
      intro b _ hb
      have hz : shiWA_emb F x y b = 0 := by
        rw [shiWA_emb_apply]
        apply if_neg
        intro hc
        exact hb (funext fun j => (hc.2 j).symm)
      rw [hz, zero_mul]
    have hstep : (∑ u : Bits (F.wit n), shiWA_emb F x y u * psi u)
        = shiWA_emb F x y
              (fun j : Fin (F.wit n) => y (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j)))
            * psi (fun j : Fin (F.wit n) => y (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))) :=
      Finset.sum_eq_single_of_mem
        (fun j : Fin (F.wit n) => y (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j)))
        (Finset.mem_univ _) h0
    have hone : shiWA_emb F x y
        (fun j : Fin (F.wit n) => y (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))) = 1 := by
      rw [shiWA_emb_apply]
      exact if_pos ⟨hy, fun j => rfl⟩
    have hwis : witnessInputState F x psi y
        = psi (fun j : Fin (F.wit n) => y (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))) := by
      simp only [witnessInputState]
      exact if_pos hy
    rw [hwis, hmv, hstep, hone, one_mul]
  · have hzero : ∑ u : Bits (F.wit n), shiWA_emb F x y u * psi u = 0 := by
      refine Finset.sum_eq_zero ?_
      intro u _
      have hz : shiWA_emb F x y u = 0 := by
        rw [shiWA_emb_apply]
        apply if_neg
        intro hc
        exact hy hc.1
      rw [hz, zero_mul]
    have hwis : witnessInputState F x psi y = 0 := by
      simp only [witnessInputState]
      exact if_neg hy
    rw [hwis, hmv, hzero]

/-- Acceptance probability is a sum of nonnegative terms. -/
private lemma shiWA_acceptWith_nonneg {n : ℕ} (F : QMAFamily) (x : Bits n)
    (psi : QState (F.wit n)) : 0 ≤ F.acceptWith x psi := by
  unfold QMAFamily.acceptWith
  refine Finset.sum_nonneg ?_
  intro y _
  by_cases h : y (F.out n) = true
  · rw [if_pos h]
    first
    | positivity
    | exact sq_nonneg _
    | exact pow_two_nonneg _
  · rw [if_neg h]
    all_goals exact le_rfl

/-! ### Part C: the witness-space acceptance operator -/

/-- **The witness-space acceptance operator.**  For every QMA verifier family `F` and input `x`
there is a Hermitian operator `A` on the WITNESS register whose quadratic form at a witness
amplitude vector `psi` is exactly the acceptance probability `F.acceptWith x psi` (which is, in
particular, nonnegative).

Unlike the circuit-register acceptance operator `star C * projOut out * C`, this `A` is a
COMPRESSION of that projector to the `{input = x, ancillas = 0}` subspace and is NOT idempotent,
so a soundness hypothesis `F.acceptWith x psi <= s` with `s < 1` transfers to a genuinely
satisfiable `[0, s]` quadratic-form bound on `A`. -/
theorem _root_.QMAReferenceValidation.candidate14 {n : ℕ} (F : ShiClassQMA.QMAFamily) (x : Bits n) :
    ∃ A : Op (F.wit n),
      A.IsHermitian
      ∧ ∀ psi : QState (F.wit n),
          (∑ u : Bits (F.wit n), (starRingEnd ℂ) (psi u) * Matrix.mulVec A psi u).re
              = F.acceptWith x psi
            ∧ 0 ≤ F.acceptWith x psi := by
  refine ⟨(shiWA_emb F x).conjTranspose
      * (star (circMatrix (F.circ n)) * projOut (F.out n) * circMatrix (F.circ n))
      * shiWA_emb F x, ?_, ?_⟩
  · exact shiWA_conj_herm (shiWA_emb F x)
      (star (circMatrix (F.circ n)) * projOut (F.out n) * circMatrix (F.circ n))
      (acceptOperator_isHermitian (circMatrix (F.circ n)) (F.out n))
  · intro psi
    refine ⟨?_, shiWA_acceptWith_nonneg F x psi⟩
    have h1 : Matrix.mulVec ((shiWA_emb F x).conjTranspose
          * (star (circMatrix (F.circ n)) * projOut (F.out n) * circMatrix (F.circ n))
          * shiWA_emb F x) psi
        = Matrix.mulVec (shiWA_emb F x).conjTranspose
            (Matrix.mulVec
              (star (circMatrix (F.circ n)) * projOut (F.out n) * circMatrix (F.circ n))
              (Matrix.mulVec (shiWA_emb F x) psi)) :=
      shiWA_mulVec_conj (shiWA_emb F x)
        (star (circMatrix (F.circ n)) * projOut (F.out n) * circMatrix (F.circ n)) psi
    have h2 : (∑ u : Bits (F.wit n), (starRingEnd ℂ) (psi u)
          * Matrix.mulVec (shiWA_emb F x).conjTranspose
              (Matrix.mulVec
                (star (circMatrix (F.circ n)) * projOut (F.out n) * circMatrix (F.circ n))
                (Matrix.mulVec (shiWA_emb F x) psi)) u)
        = ∑ y : Bits (n + (F.wit n + (F.anc n + 1))),
            (starRingEnd ℂ) (witnessInputState F x psi y)
              * Matrix.mulVec
                  (star (circMatrix (F.circ n)) * projOut (F.out n) * circMatrix (F.circ n))
                  (witnessInputState F x psi) y := by
      rw [← shiWA_mulVec_emb F x psi]
      exact shiWA_adjoint (shiWA_emb F x) psi
        (Matrix.mulVec (star (circMatrix (F.circ n)) * projOut (F.out n) * circMatrix (F.circ n))
          (Matrix.mulVec (shiWA_emb F x) psi))
    refine Eq.trans (congrArg Complex.re ?_) (acceptWith_eq_quadratic_form F x psi).symm
    rw [h1]
    exact h2

end QMAReferenceValidation.Source14

