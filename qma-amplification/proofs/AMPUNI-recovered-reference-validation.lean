namespace QMAReferenceValidation.Source12

set_option autoImplicit false

open ShiShallow ShiClassQMA

/-!
# The threefold majority amplifier, majority-voting the COPIES' OUTPUT WIRES

Identical to the accepted structure theorem except for the readout conjunct.  `QMAFamily.out` is
a FREE structure field: nothing in the tower pins `F.out n` to the last wire of the input/witness/
ancilla block, so a readout pinned by NUMERAL (`n + 3*wit + anc`, ...) majority-votes wires that
need not be the copies' outputs at all, and the downstream soundness statement is then false.
Here the readout is stated at `e1 (F.out n)`, `e2 (F.out n)`, `e3 (F.out n)` -- the three copies'
ACTUAL output wires -- which is correct for ANY `F.out n` and needs no numerals and no case
analysis.  `ShiShallow.exists_majority_readout_at_wires_layerOk_depth` accepts ARBITRARY pairwise
distinct wires and always has `depth = 111`, so the depth arithmetic
`1 + 1 + 3 * depth (F.circ n) + 111 = 3 * depth (F.circ n) + 113` is untouched.  Distinctness of
the four readout wires comes from BIJECTIVITY of the layout permutation, not from numerals.

Everything else is as in the accepted theorem: the two fan-out blocks are
`Classical.choose (ShiShallow.exists_fanout_embedded_pullback n N g)` built DIRECTLY on the
amplified register `N = n + (3 * wit + ((2 * n + 3 * anc + 3) + 1))` along the wire map `g`, so
the payload exposes the fan-out ACTION (`u2`/`u3`, XOR law, untouched law) in the shape
`ShiClassQMA.fanout_replicates_input_across_copies` needs for `hA`/`huA1`/`huA2`.
`p`/`q` are the ancilla addresses of copy 2's and copy 3's input blocks, `anc + 1 + j` and
`n + 2 * anc + 2 + j`, matching clauses 6 and 10 of `ShiShallow.exists_layout_bijection`.
`WellFormed` is NOT proved here.
-/

private def shiT_emb (M off : ℕ) (hoff : off + M ≤ 3 * M) (v : Fin M) : Fin (3 * M + 1) :=
  ⟨off + v.val, by have := v.isLt; omega⟩

private theorem shiT_emb_inj (M off : ℕ) (hoff : off + M ≤ 3 * M) :
    Function.Injective (shiT_emb M off hoff) := by
  intro x y he
  have h : off + x.val = off + y.val := congrArg Fin.val he
  exact Fin.val_injective (by omega)

/-- Fan-out addresses: first half is copy 1's input block, second half the block at `off`. -/
private def shiT_fanVal (n off k : ℕ) : ℕ := if k < n then k else off + (k - n)

private def shiT_fanEmb (n M off : ℕ) (h1 : n ≤ off) (h2 : off + n ≤ 3 * M)
    (v : Fin (n + n)) : Fin (3 * M + 1) :=
  ⟨shiT_fanVal n off v.val, by
    have hv := v.isLt
    simp only [shiT_fanVal]
    split_ifs <;> omega⟩

private theorem shiT_fanEmb_inj (n M off : ℕ) (h1 : n ≤ off) (h2 : off + n ≤ 3 * M) :
    Function.Injective (shiT_fanEmb n M off h1 h2) := by
  intro x y he
  have hx := x.isLt
  have hy := y.isLt
  have h : shiT_fanVal n off x.val = shiT_fanVal n off y.val := congrArg Fin.val he
  apply Fin.val_injective
  simp only [shiT_fanVal] at h
  split_ifs at h <;> omega

private noncomputable def shiT_sig (n w a : ℕ) :
    Fin (3 * (n + (w + (a + 1))) + 1) → Fin (n + (3 * w + ((2 * n + 3 * a + 3) + 1))) :=
  Classical.choose (ShiShallow.exists_layout_bijection n w a)

/-- The five clauses of the layout that the construction itself needs. -/
private theorem shiT_sig_facts (n w a : ℕ) :
    Function.Bijective (shiT_sig n w a)
    ∧ (∀ v : Fin _, v.val = n + w + a → (shiT_sig n w a v).val = n + 3 * w + a)
    ∧ (∀ v : Fin _, v.val = n + (w + (a + 1)) + n + w + a →
        (shiT_sig n w a v).val = 2 * n + 3 * w + 2 * a + 1)
    ∧ (∀ v : Fin _, v.val = 2 * (n + (w + (a + 1))) + n + w + a →
        (shiT_sig n w a v).val = 3 * n + 3 * w + 3 * a + 2)
    ∧ (∀ v : Fin _, v.val = 3 * (n + (w + (a + 1))) →
        (shiT_sig n w a v).val = 3 * n + 3 * w + 3 * a + 3) := by
  obtain ⟨hb, -, -, -, h1, -, -, -, h2, -, -, -, h3, h4⟩ :=
    Classical.choose_spec (ShiShallow.exists_layout_bijection n w a)
  exact ⟨hb, h1, h2, h3, h4⟩

/-- The three INPUT-block clauses of the layout, which the fan-out needs. -/
private theorem shiT3_sig_inputs (n w a : ℕ) :
    (∀ (v : Fin (3 * (n + (w + (a + 1))) + 1)) (j : ℕ), j < n →
        v.val = j → (shiT_sig n w a v).val = j)
    ∧ (∀ (v : Fin (3 * (n + (w + (a + 1))) + 1)) (j : ℕ), j < n →
        v.val = (n + (w + (a + 1))) + j →
        (shiT_sig n w a v).val = n + 3 * w + a + 1 + j)
    ∧ (∀ (v : Fin (3 * (n + (w + (a + 1))) + 1)) (j : ℕ), j < n →
        v.val = 2 * (n + (w + (a + 1))) + j →
        (shiT_sig n w a v).val = 2 * n + 3 * w + 2 * a + 2 + j) := by
  obtain ⟨-, k1, -, -, -, k2, -, -, -, k3, -, -, -, -⟩ :=
    Classical.choose_spec (ShiShallow.exists_layout_bijection n w a)
  exact ⟨k1, k2, k3⟩

private noncomputable def shiT_scr (n w a : ℕ) :
    Fin (n + (3 * w + ((2 * n + 3 * a + 3) + 1))) :=
  shiT_sig n w a ⟨3 * (n + (w + (a + 1))), by omega⟩

private theorem shiT_scr_val (n w a : ℕ) :
    (shiT_scr n w a).val = 3 * n + 3 * w + 3 * a + 3 :=
  (shiT_sig_facts n w a).2.2.2.2 ⟨3 * (n + (w + (a + 1))), by omega⟩ rfl

private theorem shiT_ne_of_val {N : ℕ} {x y : Fin N} {p q : ℕ} (hx : x.val = p)
    (hy : y.val = q) (hpq : p ≠ q) : x ≠ y :=
  fun he => hpq (by rw [← hx, ← hy, he])

private noncomputable def shiT_e (n w a off : ℕ)
    (h : off + (n + (w + (a + 1))) ≤ 3 * (n + (w + (a + 1)))) :
    Fin (n + (w + (a + 1))) → Fin (n + (3 * w + ((2 * n + 3 * a + 3) + 1))) :=
  shiT_sig n w a ∘ shiT_emb (n + (w + (a + 1))) off h

private theorem shiT_e_inj (n w a off : ℕ)
    (h : off + (n + (w + (a + 1))) ≤ 3 * (n + (w + (a + 1)))) :
    Function.Injective (shiT_e n w a off h) :=
  (shiT_sig_facts n w a).1.injective.comp (shiT_emb_inj _ _ h)

private theorem shiT_e_apply (n w a off : ℕ)
    (h : off + (n + (w + (a + 1))) ≤ 3 * (n + (w + (a + 1))))
    (v : Fin (n + (w + (a + 1)))) (u : Fin (3 * (n + (w + (a + 1))) + 1))
    (hu : u.val = off + v.val) : shiT_e n w a off h v = shiT_sig n w a u := by
  have he : shiT_emb (n + (w + (a + 1))) off h v = u := by
    apply Fin.val_injective
    show off + v.val = u.val
    omega
  exact congrArg (shiT_sig n w a) he

/-! ### Distinctness of the four readout wires, from BIJECTIVITY of `σ`

`e_i v = σ ⟨pos_i v, _⟩` with `pos_1 v = v.val`, `pos_2 v = M + v.val`, `pos_3 v = 2*M + v.val`
and `M = n + (w + (a + 1))`, while the scratch wire is `σ ⟨3*M, _⟩`.  For a FIXED `v` the three
positions are pairwise distinct by cancellation of `v.val` (only `off ≠ off'` is needed), and each
is `< 3*M` because `off + M ≤ 3*M` and `v.val < M`; injectivity of `σ` then lifts distinct
positions to distinct wires.  No numeral, and no assumption about where `v` lives. -/

private theorem shiT4_sig_ne (n w a : ℕ) {p p' : Fin (3 * (n + (w + (a + 1))) + 1)}
    (h : p ≠ p') : shiT_sig n w a p ≠ shiT_sig n w a p' :=
  fun he => h ((shiT_sig_facts n w a).1.injective he)

private theorem shiT4_e_sig (n w a off : ℕ)
    (h : off + (n + (w + (a + 1))) ≤ 3 * (n + (w + (a + 1))))
    (v : Fin (n + (w + (a + 1)))) (hp : off + v.val < 3 * (n + (w + (a + 1))) + 1) :
    shiT_e n w a off h v = shiT_sig n w a ⟨off + v.val, hp⟩ :=
  shiT_e_apply n w a off h v ⟨off + v.val, hp⟩ rfl

private theorem shiT4_e_ne (n w a off off' : ℕ)
    (h : off + (n + (w + (a + 1))) ≤ 3 * (n + (w + (a + 1))))
    (h' : off' + (n + (w + (a + 1))) ≤ 3 * (n + (w + (a + 1))))
    (hoff : off ≠ off') (v : Fin (n + (w + (a + 1)))) :
    shiT_e n w a off h v ≠ shiT_e n w a off' h' v := by
  have hv := v.isLt
  have hp : off + v.val < 3 * (n + (w + (a + 1))) + 1 := by omega
  have hp' : off' + v.val < 3 * (n + (w + (a + 1))) + 1 := by omega
  rw [shiT4_e_sig n w a off h v hp, shiT4_e_sig n w a off' h' v hp']
  exact shiT4_sig_ne n w a
    (shiT_ne_of_val (p := off + v.val) (q := off' + v.val) rfl rfl (by omega))

private theorem shiT4_e_ne_scr (n w a off : ℕ)
    (h : off + (n + (w + (a + 1))) ≤ 3 * (n + (w + (a + 1))))
    (v : Fin (n + (w + (a + 1)))) :
    shiT_e n w a off h v ≠ shiT_scr n w a := by
  have hv := v.isLt
  have hp : off + v.val < 3 * (n + (w + (a + 1))) + 1 := by omega
  have hs : 3 * (n + (w + (a + 1))) < 3 * (n + (w + (a + 1))) + 1 := by omega
  have e0 : shiT_scr n w a = shiT_sig n w a ⟨3 * (n + (w + (a + 1))), hs⟩ := rfl
  rw [shiT4_e_sig n w a off h v hp, e0]
  exact shiT4_sig_ne n w a
    (shiT_ne_of_val (p := off + v.val) (q := 3 * (n + (w + (a + 1)))) rfl rfl (by omega))

/-- Naming the readout existential lets `Classical.choose` and `Classical.choose_spec` hit
the SAME proof without restating the six distinctness arguments.  The voted wires are the three
copies' images of `v`; `v` will be instantiated at `F.out n`. -/
private def shiT_readEx (n w a : ℕ) (v : Fin (n + (w + (a + 1)))) :=
  ShiShallow.exists_majority_readout_at_wires_layerOk_depth
    (shiT_e n w a 0 (by omega) v)
    (shiT_e n w a (n + (w + (a + 1))) (by omega) v)
    (shiT_e n w a (2 * (n + (w + (a + 1)))) (by omega) v)
    (shiT_scr n w a)
    (shiT4_e_ne n w a 0 (n + (w + (a + 1))) (by omega) (by omega) (by omega) v)
    (shiT4_e_ne n w a 0 (2 * (n + (w + (a + 1)))) (by omega) (by omega) (by omega) v)
    (shiT4_e_ne n w a (n + (w + (a + 1))) (2 * (n + (w + (a + 1)))) (by omega) (by omega)
      (by omega) v)
    (shiT4_e_ne_scr n w a 0 (by omega) v)
    (shiT4_e_ne_scr n w a (n + (w + (a + 1))) (by omega) v)
    (shiT4_e_ne_scr n w a (2 * (n + (w + (a + 1)))) (by omega) v)

private noncomputable def shiT_read (n w a : ℕ) (v : Fin (n + (w + (a + 1)))) :
    Layered (n + (3 * w + ((2 * n + 3 * a + 3) + 1))) :=
  Classical.choose (shiT_readEx n w a v)

private noncomputable def shiT_g (n w a off : ℕ) (h1 : n ≤ off)
    (h2 : off + n ≤ 3 * (n + (w + (a + 1)))) :
    Fin (n + n) → Fin (n + (3 * w + ((2 * n + 3 * a + 3) + 1))) :=
  shiT_sig n w a ∘ shiT_fanEmb n (n + (w + (a + 1))) off h1 h2

private theorem shiT_g_inj (n w a off : ℕ) (h1 : n ≤ off)
    (h2 : off + n ≤ 3 * (n + (w + (a + 1)))) :
    Function.Injective (shiT_g n w a off h1 h2) :=
  (shiT_sig_facts n w a).1.injective.comp (shiT_fanEmb_inj _ _ _ h1 h2)

private theorem shiT_g_apply (n w a off : ℕ) (h1 : n ≤ off)
    (h2 : off + n ≤ 3 * (n + (w + (a + 1)))) (v : Fin (n + n))
    (u : Fin (3 * (n + (w + (a + 1))) + 1)) (hu : u.val = shiT_fanVal n off v.val) :
    shiT_g n w a off h1 h2 v = shiT_sig n w a u := by
  have he : shiT_fanEmb n (n + (w + (a + 1))) off h1 h2 v = u := by
    apply Fin.val_injective
    show shiT_fanVal n off v.val = u.val
    omega
  exact congrArg (shiT_sig n w a) he

private noncomputable def shiT3_g2 (n w a : ℕ) :
    Fin (n + n) → Fin (n + (3 * w + ((2 * n + 3 * a + 3) + 1))) :=
  shiT_g n w a (n + (w + (a + 1))) (by omega) (by omega)

private noncomputable def shiT3_g3 (n w a : ℕ) :
    Fin (n + n) → Fin (n + (3 * w + ((2 * n + 3 * a + 3) + 1))) :=
  shiT_g n w a (2 * (n + (w + (a + 1)))) (by omega) (by omega)

private theorem shiT3_g2_inj (n w a : ℕ) : Function.Injective (shiT3_g2 n w a) :=
  shiT_g_inj n w a (n + (w + (a + 1))) (by omega) (by omega)

private theorem shiT3_g3_inj (n w a : ℕ) : Function.Injective (shiT3_g3 n w a) :=
  shiT_g_inj n w a (2 * (n + (w + (a + 1)))) (by omega) (by omega)

private def shiT3_p (n a : ℕ) (j : Fin n) : Fin (2 * n + 3 * a + 3 + 1) :=
  ⟨a + 1 + j.val, by have := j.isLt; omega⟩

private def shiT3_q (n a : ℕ) (j : Fin n) : Fin (2 * n + 3 * a + 3 + 1) :=
  ⟨n + 2 * a + 2 + j.val, by have := j.isLt; omega⟩

private theorem shiT3_p_val (n a : ℕ) (j : Fin n) :
    (shiT3_p n a j).val = a + 1 + j.val := rfl

private theorem shiT3_q_val (n a : ℕ) (j : Fin n) :
    (shiT3_q n a j).val = n + 2 * a + 2 + j.val := rfl

private theorem shiT3_p_ne_q (n a : ℕ) (j j' : Fin n) : shiT3_p n a j ≠ shiT3_q n a j' := by
  intro he
  have h : (shiT3_p n a j).val = (shiT3_q n a j').val := congrArg Fin.val he
  have hp := shiT3_p_val n a j
  have hq := shiT3_q_val n a j'
  have hj := j.isLt
  have hj' := j'.isLt
  omega

private theorem shiT3_val_castAdd (n m : ℕ) (j : Fin n) : (Fin.castAdd m j).val = j.val := by
  first | rfl | (simp; done)

private theorem shiT3_val_natAdd (n m : ℕ) (j : Fin m) :
    (Fin.natAdd n j).val = n + j.val := by
  first | rfl | (simp; done)

private theorem shiT3_fanVal_castAdd (n off : ℕ) (j : Fin n) :
    shiT_fanVal n off (Fin.castAdd n j).val = j.val := by
  have hj := j.isLt
  rw [shiT3_val_castAdd n n j]
  simp only [shiT_fanVal]
  split_ifs <;> omega

private theorem shiT3_fanVal_natAdd (n off : ℕ) (j : Fin n) :
    shiT_fanVal n off (Fin.natAdd n j).val = off + j.val := by
  rw [shiT3_val_natAdd n n j]
  simp only [shiT_fanVal]
  split_ifs <;> omega

private theorem shiT3_g_castAdd (n w a off : ℕ) (h1 : n ≤ off)
    (h2 : off + n ≤ 3 * (n + (w + (a + 1)))) (j : Fin n) :
    shiT_g n w a off h1 h2 (Fin.castAdd n j)
      = Fin.castAdd (3 * w + ((2 * n + 3 * a + 3) + 1)) j := by
  have hj := j.isLt
  have hg := shiT_g_apply n w a off h1 h2 (Fin.castAdd n j) ⟨j.val, by omega⟩
      (shiT3_fanVal_castAdd n off j).symm
  apply Fin.val_injective
  rw [hg]
  have hs : (shiT_sig n w a ⟨j.val, by omega⟩).val = j.val :=
    (shiT3_sig_inputs n w a).1 _ j.val hj rfl
  exact hs.trans (shiT3_val_castAdd n (3 * w + ((2 * n + 3 * a + 3) + 1)) j).symm

private theorem shiT3_g2_castAdd (n w a : ℕ) (j : Fin n) :
    shiT3_g2 n w a (Fin.castAdd n j)
      = Fin.castAdd (3 * w + ((2 * n + 3 * a + 3) + 1)) j :=
  shiT3_g_castAdd n w a (n + (w + (a + 1))) (by omega) (by omega) j

private theorem shiT3_g3_castAdd (n w a : ℕ) (j : Fin n) :
    shiT3_g3 n w a (Fin.castAdd n j)
      = Fin.castAdd (3 * w + ((2 * n + 3 * a + 3) + 1)) j :=
  shiT3_g_castAdd n w a (2 * (n + (w + (a + 1)))) (by omega) (by omega) j

private theorem shiT3_g2_natAdd (n w a : ℕ) (j : Fin n) :
    shiT3_g2 n w a (Fin.natAdd n j)
      = Fin.natAdd n (Fin.natAdd (3 * w) (shiT3_p n a j)) := by
  have hj := j.isLt
  have hg : shiT3_g2 n w a (Fin.natAdd n j)
      = shiT_sig n w a ⟨n + (w + (a + 1)) + j.val, by omega⟩ :=
    shiT_g_apply n w a (n + (w + (a + 1))) (by omega) (by omega) (Fin.natAdd n j)
      ⟨n + (w + (a + 1)) + j.val, by omega⟩
      (shiT3_fanVal_natAdd n (n + (w + (a + 1))) j).symm
  have hs : (shiT_sig n w a ⟨n + (w + (a + 1)) + j.val, by omega⟩).val
      = n + 3 * w + a + 1 + j.val :=
    (shiT3_sig_inputs n w a).2.1 _ j.val hj rfl
  have hv : (Fin.natAdd n (Fin.natAdd (3 * w) (shiT3_p n a j))).val
      = n + (3 * w + (a + 1 + j.val)) := by
    rw [shiT3_val_natAdd, shiT3_val_natAdd, shiT3_p_val]
  have ha : n + 3 * w + a + 1 + j.val = n + (3 * w + (a + 1 + j.val)) := by omega
  apply Fin.val_injective
  rw [hg]
  exact hs.trans (ha.trans hv.symm)

private theorem shiT3_g3_natAdd (n w a : ℕ) (j : Fin n) :
    shiT3_g3 n w a (Fin.natAdd n j)
      = Fin.natAdd n (Fin.natAdd (3 * w) (shiT3_q n a j)) := by
  have hj := j.isLt
  have hg : shiT3_g3 n w a (Fin.natAdd n j)
      = shiT_sig n w a ⟨2 * (n + (w + (a + 1))) + j.val, by omega⟩ :=
    shiT_g_apply n w a (2 * (n + (w + (a + 1)))) (by omega) (by omega) (Fin.natAdd n j)
      ⟨2 * (n + (w + (a + 1))) + j.val, by omega⟩
      (shiT3_fanVal_natAdd n (2 * (n + (w + (a + 1)))) j).symm
  have hs : (shiT_sig n w a ⟨2 * (n + (w + (a + 1))) + j.val, by omega⟩).val
      = 2 * n + 3 * w + 2 * a + 2 + j.val :=
    (shiT3_sig_inputs n w a).2.2 _ j.val hj rfl
  have hv : (Fin.natAdd n (Fin.natAdd (3 * w) (shiT3_q n a j))).val
      = n + (3 * w + (n + 2 * a + 2 + j.val)) := by
    rw [shiT3_val_natAdd, shiT3_val_natAdd, shiT3_q_val]
  have ha : 2 * n + 3 * w + 2 * a + 2 + j.val = n + (3 * w + (n + 2 * a + 2 + j.val)) := by
    omega
  apply Fin.val_injective
  rw [hg]
  exact hs.trans (ha.trans hv.symm)

private theorem shiT3_xor_transport (n w a : ℕ)
    (g : Fin (n + n) → Fin (n + (3 * w + ((2 * n + 3 * a + 3) + 1))))
    (r : Fin n → Fin (2 * n + 3 * a + 3 + 1))
    (hn : ∀ j : Fin n, g (Fin.natAdd n j) = Fin.natAdd n (Fin.natAdd (3 * w) (r j)))
    (hc : ∀ j : Fin n,
      g (Fin.castAdd n j) = Fin.castAdd (3 * w + ((2 * n + 3 * a + 3) + 1)) j)
    (u : Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1))) →
      Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1))))
    (hx : ∀ (Y : Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))) (j : Fin n),
      u Y (g (Fin.natAdd n j))
        = xor (Y (g (Fin.natAdd n j))) (Y (g (Fin.castAdd n j)))) :
    ∀ (Y : Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))) (j : Fin n),
      u Y (Fin.natAdd n (Fin.natAdd (3 * w) (r j)))
        = xor (Y (Fin.natAdd n (Fin.natAdd (3 * w) (r j))))
            (Y (Fin.castAdd (3 * w + ((2 * n + 3 * a + 3) + 1)) j)) := by
  intro Y j
  rw [← hn j, ← hc j]
  exact hx Y j

private theorem shiT3_untouched_transport (n w a : ℕ)
    (g : Fin (n + n) → Fin (n + (3 * w + ((2 * n + 3 * a + 3) + 1))))
    (r : Fin n → Fin (2 * n + 3 * a + 3 + 1))
    (hn : ∀ j : Fin n, g (Fin.natAdd n j) = Fin.natAdd n (Fin.natAdd (3 * w) (r j)))
    (u : Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1))) →
      Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1))))
    (hu : ∀ (Y : Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1))))
      (k : Fin (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))),
      (∀ j : Fin n, g (Fin.natAdd n j) ≠ k) → u Y k = Y k) :
    ∀ (Y : Bits (n + (3 * w + ((2 * n + 3 * a + 3) + 1))))
      (k : Fin (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))),
      (∀ j : Fin n, Fin.natAdd n (Fin.natAdd (3 * w) (r j)) ≠ k) → u Y k = Y k := by
  intro Y k hk
  refine hu Y k ?_
  intro j he
  exact hk j ((hn j).symm.trans he)

private def shiT3_fanEx2 (n w a : ℕ) :=
  ShiShallow.exists_fanout_embedded_pullback n (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))
    (shiT3_g2 n w a) (shiT3_g2_inj n w a)

private def shiT3_fanEx3 (n w a : ℕ) :=
  ShiShallow.exists_fanout_embedded_pullback n (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))
    (shiT3_g3 n w a) (shiT3_g3_inj n w a)

private noncomputable def shiT3_fan2 (n w a : ℕ) :
    Layered (n + (3 * w + ((2 * n + 3 * a + 3) + 1))) :=
  Classical.choose (shiT3_fanEx2 n w a)

private noncomputable def shiT3_fan3 (n w a : ℕ) :
    Layered (n + (3 * w + ((2 * n + 3 * a + 3) + 1))) :=
  Classical.choose (shiT3_fanEx3 n w a)

private noncomputable def shiT_circ (F : QMAFamily) (n : ℕ) :
    Layered (n + (3 * F.wit n + ((2 * n + 3 * F.anc n + 3) + 1))) :=
  shiT3_fan2 n (F.wit n) (F.anc n)
    ++ shiT3_fan3 n (F.wit n) (F.anc n)
    ++ ShiEmbed.embedCirc (shiT_e n (F.wit n) (F.anc n) 0 (by omega))
      (shiT_e_inj n (F.wit n) (F.anc n) 0 (by omega)) (F.circ n)
    ++ ShiEmbed.embedCirc
      (shiT_e n (F.wit n) (F.anc n) (n + (F.wit n + (F.anc n + 1))) (by omega))
      (shiT_e_inj n (F.wit n) (F.anc n) (n + (F.wit n + (F.anc n + 1))) (by omega)) (F.circ n)
    ++ ShiEmbed.embedCirc
      (shiT_e n (F.wit n) (F.anc n) (2 * (n + (F.wit n + (F.anc n + 1)))) (by omega))
      (shiT_e_inj n (F.wit n) (F.anc n) (2 * (n + (F.wit n + (F.anc n + 1)))) (by omega))
      (F.circ n)
    ++ shiT_read n (F.wit n) (F.anc n) (F.out n)

private noncomputable def shiT_T (F : QMAFamily) : QMAFamily :=
  { anc := fun n => 2 * n + 3 * F.anc n + 3
    wit := fun n => 3 * F.wit n
    circ := shiT_circ F
    out := fun n => shiT_scr n (F.wit n) (F.anc n) }

private theorem shiT_depth (F : QMAFamily) (n : ℕ) :
    depth ((shiT_T F).circ n) = 3 * depth (F.circ n) + 113 := by
  have h2 : (shiT3_fan2 n (F.wit n) (F.anc n)).length = 1 :=
    (Classical.choose_spec (Classical.choose_spec (shiT3_fanEx2 n (F.wit n) (F.anc n)))).2.2.2.2
  have h3 : (shiT3_fan3 n (F.wit n) (F.anc n)).length = 1 :=
    (Classical.choose_spec (Classical.choose_spec (shiT3_fanEx3 n (F.wit n) (F.anc n)))).2.2.2.2
  have hr : (shiT_read n (F.wit n) (F.anc n) (F.out n)).length = 111 :=
    (Classical.choose_spec (shiT_readEx n (F.wit n) (F.anc n) (F.out n))).2.2
  show depth (shiT_circ F n) = 3 * depth (F.circ n) + 113
  simp only [shiT_circ, ShiShallow.depth, ShiEmbed.embedCirc, List.length_append,
    List.length_map, h2, h3, hr]
  omega

/-- `σ` and both fan-outs are pinned to closed `Classical.choose` terms, so the thirteen
placement clauses and each fan-out's `LayerOk`/`depth = 1` stay recoverable downstream; the
ACTION, which no pin could give, is exposed as `u2`/`u3`.  The readout is stated at the three
copies' OWN output wires `e1 (F.out n)`, `e2 (F.out n)`, `e3 (F.out n)`, so it is valid for an
arbitrary `QMAFamily.out` field and carries no `∀`-premise for the consumer to discharge. -/
theorem _root_.QMAReferenceValidation.candidate12 :
    ∃ T : QMAFamily → QMAFamily,
      (∀ (F : QMAFamily) (n : ℕ), (T F).wit n = 3 * F.wit n)
      ∧ (∀ (F : QMAFamily) (n : ℕ), (T F).anc n = 2 * n + 3 * F.anc n + 3)
      ∧ (∀ (F : QMAFamily) (n : ℕ), depth ((T F).circ n) = 3 * depth (F.circ n) + 113)
      ∧ (∀ (F : QMAFamily) (n : ℕ),
          ((T F).out n).val = 3 * n + 3 * F.wit n + 3 * F.anc n + 3)
      ∧ (∀ (F : QMAFamily) (n : ℕ),
          ∃ (σ : Fin (3 * (n + (F.wit n + (F.anc n + 1))) + 1)
                → Fin (n + (3 * F.wit n + ((2 * n + 3 * F.anc n + 3) + 1))))
            (g2 g3 : Fin (n + n) → Fin (n + ((T F).wit n + ((T F).anc n + 1))))
            (p q : Fin n → Fin ((T F).anc n + 1))
            (e1 e2 e3 : Fin (n + (F.wit n + (F.anc n + 1)))
              → Fin (n + ((T F).wit n + ((T F).anc n + 1))))
            (rd fan2 fan3 : Layered (n + ((T F).wit n + ((T F).anc n + 1))))
            (u2 u3 : Bits (n + ((T F).wit n + ((T F).anc n + 1)))
              → Bits (n + ((T F).wit n + ((T F).anc n + 1))))
            (hg2 : Function.Injective g2) (hg3 : Function.Injective g3)
            (he1 : Function.Injective e1) (he2 : Function.Injective e2)
            (he3 : Function.Injective e3),
            σ = Classical.choose (ShiShallow.exists_layout_bijection n (F.wit n) (F.anc n))
            ∧ fan2 = Classical.choose (ShiShallow.exists_fanout_embedded_pullback n
                (n + ((T F).wit n + ((T F).anc n + 1))) g2 hg2)
            ∧ fan3 = Classical.choose (ShiShallow.exists_fanout_embedded_pullback n
                (n + ((T F).wit n + ((T F).anc n + 1))) g3 hg3)
            ∧ (T F).circ n
                = fan2 ++ fan3
                  ++ ShiEmbed.embedCirc e1 he1 (F.circ n)
                  ++ ShiEmbed.embedCirc e2 he2 (F.circ n)
                  ++ ShiEmbed.embedCirc e3 he3 (F.circ n) ++ rd
            ∧ (∀ (v : Fin (n + (F.wit n + (F.anc n + 1)))) (u : Fin _),
                u.val = v.val → (e1 v).val = (σ u).val)
            ∧ (∀ (v : Fin (n + (F.wit n + (F.anc n + 1)))) (u : Fin _),
                u.val = n + (F.wit n + (F.anc n + 1)) + v.val → (e2 v).val = (σ u).val)
            ∧ (∀ (v : Fin (n + (F.wit n + (F.anc n + 1)))) (u : Fin _),
                u.val = 2 * (n + (F.wit n + (F.anc n + 1))) + v.val →
                (e3 v).val = (σ u).val)
            ∧ (∀ (v : Fin (n + n)) (u : Fin _),
                u.val
                  = (if v.val < n then v.val
                      else n + (F.wit n + (F.anc n + 1)) + (v.val - n)) →
                (g2 v).val = (σ u).val)
            ∧ (∀ (v : Fin (n + n)) (u : Fin _),
                u.val
                  = (if v.val < n then v.val
                      else 2 * (n + (F.wit n + (F.anc n + 1))) + (v.val - n)) →
                (g3 v).val = (σ u).val)
            ∧ (∀ j : Fin n, (p j).val = F.anc n + 1 + j.val)
            ∧ (∀ j : Fin n, (q j).val = n + 2 * F.anc n + 2 + j.val)
            ∧ (∀ j j' : Fin n, p j ≠ q j')
            ∧ (∀ Φ : QState (n + ((T F).wit n + ((T F).anc n + 1))),
                runLayered fan2 Φ = fun Y => Φ (u2 Y))
            ∧ (∀ (Y : Bits (n + ((T F).wit n + ((T F).anc n + 1)))) (j : Fin n),
                u2 Y (Fin.natAdd n (Fin.natAdd ((T F).wit n) (p j)))
                  = xor (Y (Fin.natAdd n (Fin.natAdd ((T F).wit n) (p j))))
                      (Y (Fin.castAdd ((T F).wit n + ((T F).anc n + 1)) j)))
            ∧ (∀ (Y : Bits (n + ((T F).wit n + ((T F).anc n + 1))))
                (k : Fin (n + ((T F).wit n + ((T F).anc n + 1)))),
                (∀ j : Fin n, Fin.natAdd n (Fin.natAdd ((T F).wit n) (p j)) ≠ k) →
                  u2 Y k = Y k)
            ∧ (∀ Φ : QState (n + ((T F).wit n + ((T F).anc n + 1))),
                runLayered fan3 Φ = fun Y => Φ (u3 Y))
            ∧ (∀ (Y : Bits (n + ((T F).wit n + ((T F).anc n + 1)))) (j : Fin n),
                u3 Y (Fin.natAdd n (Fin.natAdd ((T F).wit n) (q j)))
                  = xor (Y (Fin.natAdd n (Fin.natAdd ((T F).wit n) (q j))))
                      (Y (Fin.castAdd ((T F).wit n + ((T F).anc n + 1)) j)))
            ∧ (∀ (Y : Bits (n + ((T F).wit n + ((T F).anc n + 1))))
                (k : Fin (n + ((T F).wit n + ((T F).anc n + 1)))),
                (∀ j : Fin n, Fin.natAdd n (Fin.natAdd ((T F).wit n) (q j)) ≠ k) →
                  u3 Y k = Y k)
            ∧ (∀ ψ : QState (n + ((T F).wit n + ((T F).anc n + 1))),
                runLayered rd ψ
                  = fun x => ψ (Function.update x ((T F).out n)
                      (xor (x ((T F).out n))
                        (xor (xor (x (e1 (F.out n)) && x (e2 (F.out n)))
                                (x (e2 (F.out n)) && x (e3 (F.out n))))
                          (x (e1 (F.out n)) && x (e3 (F.out n)))))))
            ∧ (∀ l ∈ rd, LayerOk l)
            ∧ depth rd = 111) := by
  refine ⟨shiT_T, fun _ _ => rfl, fun _ _ => rfl, shiT_depth,
    fun F n => shiT_scr_val n (F.wit n) (F.anc n), ?_⟩
  intro F n
  obtain ⟨hrs, hrok, hrdep⟩ :=
    Classical.choose_spec (shiT_readEx n (F.wit n) (F.anc n) (F.out n))
  obtain ⟨u2, h2a, h2x, h2u, -, -⟩ :=
    Classical.choose_spec (shiT3_fanEx2 n (F.wit n) (F.anc n))
  obtain ⟨u3, h3a, h3x, h3u, -, -⟩ :=
    Classical.choose_spec (shiT3_fanEx3 n (F.wit n) (F.anc n))
  refine ⟨shiT_sig n (F.wit n) (F.anc n),
    shiT3_g2 n (F.wit n) (F.anc n), shiT3_g3 n (F.wit n) (F.anc n),
    shiT3_p n (F.anc n), shiT3_q n (F.anc n),
    shiT_e n (F.wit n) (F.anc n) 0 (by omega),
    shiT_e n (F.wit n) (F.anc n) (n + (F.wit n + (F.anc n + 1))) (by omega),
    shiT_e n (F.wit n) (F.anc n) (2 * (n + (F.wit n + (F.anc n + 1)))) (by omega),
    shiT_read n (F.wit n) (F.anc n) (F.out n),
    shiT3_fan2 n (F.wit n) (F.anc n), shiT3_fan3 n (F.wit n) (F.anc n), u2, u3,
    shiT3_g2_inj n (F.wit n) (F.anc n), shiT3_g3_inj n (F.wit n) (F.anc n),
    shiT_e_inj n (F.wit n) (F.anc n) 0 (by omega),
    shiT_e_inj n (F.wit n) (F.anc n) (n + (F.wit n + (F.anc n + 1))) (by omega),
    shiT_e_inj n (F.wit n) (F.anc n) (2 * (n + (F.wit n + (F.anc n + 1)))) (by omega),
    rfl, rfl, rfl, rfl, ?_, ?_, ?_, ?_, ?_,
    shiT3_p_val n (F.anc n), shiT3_q_val n (F.anc n), shiT3_p_ne_q n (F.anc n),
    h2a,
    shiT3_xor_transport n (F.wit n) (F.anc n) (shiT3_g2 n (F.wit n) (F.anc n))
      (shiT3_p n (F.anc n)) (shiT3_g2_natAdd n (F.wit n) (F.anc n))
      (shiT3_g2_castAdd n (F.wit n) (F.anc n)) u2 h2x,
    shiT3_untouched_transport n (F.wit n) (F.anc n) (shiT3_g2 n (F.wit n) (F.anc n))
      (shiT3_p n (F.anc n)) (shiT3_g2_natAdd n (F.wit n) (F.anc n)) u2 h2u,
    h3a,
    shiT3_xor_transport n (F.wit n) (F.anc n) (shiT3_g3 n (F.wit n) (F.anc n))
      (shiT3_q n (F.anc n)) (shiT3_g3_natAdd n (F.wit n) (F.anc n))
      (shiT3_g3_castAdd n (F.wit n) (F.anc n)) u3 h3x,
    shiT3_untouched_transport n (F.wit n) (F.anc n) (shiT3_g3 n (F.wit n) (F.anc n))
      (shiT3_q n (F.anc n)) (shiT3_g3_natAdd n (F.wit n) (F.anc n)) u3 h3u,
    ?_, hrok, hrdep⟩
  · intro v u hu
    exact congrArg Fin.val (shiT_e_apply n (F.wit n) (F.anc n) 0 (by omega) v u (by omega))
  · intro v u hu
    exact congrArg Fin.val (shiT_e_apply n (F.wit n) (F.anc n)
      (n + (F.wit n + (F.anc n + 1))) (by omega) v u hu)
  · intro v u hu
    exact congrArg Fin.val (shiT_e_apply n (F.wit n) (F.anc n)
      (2 * (n + (F.wit n + (F.anc n + 1)))) (by omega) v u hu)
  · intro v u hu
    exact congrArg Fin.val (shiT_g_apply n (F.wit n) (F.anc n)
      (n + (F.wit n + (F.anc n + 1))) (by omega) (by omega) v u hu)
  · intro v u hu
    exact congrArg Fin.val (shiT_g_apply n (F.wit n) (F.anc n)
      (2 * (n + (F.wit n + (F.anc n + 1)))) (by omega) (by omega) v u hu)
  · exact hrs

