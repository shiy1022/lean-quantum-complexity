     done)
  | (exact ⟨⟨⟨n, hkey'⟩, le_rfl⟩⟩
     done)
  | (refine ⟨{ steps := n, evals_in_steps := ?_, steps_le_m := le_rfl }⟩
     exact hkey'
     done)
  | (refine ⟨{ steps := n, evals_in_steps := ?_, steps_le_m := le_rfl }⟩
