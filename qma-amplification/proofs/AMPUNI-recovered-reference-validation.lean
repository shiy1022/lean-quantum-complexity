and the result is data, hence `def` rather than `theorem`. -/
private def shiPoly_outputsInTime_mono {tm : Turing.FinTM2}
    {l : List (tm.Γ tm.k₀)} {l' : Option (List (tm.Γ tm.k₁))} {m m' : ℕ}
