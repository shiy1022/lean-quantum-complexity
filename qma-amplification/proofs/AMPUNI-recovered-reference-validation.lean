namespace QMAReferenceValidation.Source3

set_option autoImplicit false

open ShiShallow ShiClassQMA ShiClassQMAAmp ShiClassQMAAmpX

private lemma runLayered_append {N : ℕ} (c₁ c₂ : Layered N) (φ : QState N) :
    runLayered (c₁ ++ c₂) φ = runLayered c₂ (runLayered c₁ φ) := by
  unfold runLayered
  rw [List.foldl_append]

private noncomputable def fanMap (n N : ℕ) (g : Fin (n + n) → Fin N) (Y : Bits N) : Bits N :=
  fun k =>
    if h : ∃ j : Fin n, g (Fin.natAdd n j) = k
      then xor (Y k) (Y (g (Fin.castAdd n h.choose)))
      else Y k

private theorem fan_spec_determines_map (n N : ℕ)
    (g : Fin (n + n) → Fin N) (_hg : Function.Injective g)
    (u : Bits N → Bits N)
    (htarget : ∀ (Y : Bits N) (j : Fin n),
      u Y (g (Fin.natAdd n j))
        = xor (Y (g (Fin.natAdd n j))) (Y (g (Fin.castAdd n j))))
    (hfix : ∀ (Y : Bits N) (k : Fin N),
      (∀ j : Fin n, g (Fin.natAdd n j) ≠ k) → u Y k = Y k) :
    u = fanMap n N g := by
  funext Y k
  by_cases h : ∃ j : Fin n, g (Fin.natAdd n j) = k
  · rw [fanMap, dif_pos h]
    have hj := h.choose_spec
    calc
      u Y k = u Y (g (Fin.natAdd n h.choose)) := congrArg (u Y) hj.symm
      _ = xor (Y (g (Fin.natAdd n h.choose)))
          (Y (g (Fin.castAdd n h.choose))) := htarget Y h.choose
      _ = xor (Y k) (Y (g (Fin.castAdd n h.choose))) := by rw [hj]
  · rw [fanMap, dif_neg h]
    exact hfix Y k (fun j hj => h ⟨j, hj⟩)

private theorem chosen_fan_semantics (n N : ℕ)
    (g : Fin (n + n) → Fin N) (hg : Function.Injective g) (Φ : QState N) :
    runLayered (Classical.choose
      (ShiShallow.exists_fanout_embedded_pullback n N g hg)) Φ
      = fun Y => Φ (fanMap n N g Y) := by
  obtain ⟨u, hsem, htarget, hfix, hok, hd⟩ :=
    Classical.choose_spec (ShiShallow.exists_fanout_embedded_pullback n N g hg)
  rw [hsem, fan_spec_determines_map n N g hg u htarget hfix]

private theorem explicit_fan_semantics (n N : ℕ)
    (g : Fin (n + n) → Fin N) (hg : Function.Injective g) (Φ : QState N) :
    runLayered (fanEmbCirc n N g hg) Φ
      = fun Y => Φ (fanMap n N g Y) := by
  obtain ⟨c, u, hc, hu, hsem, htarget, hfix, hok, hd⟩ :=
    ShiShallow.explicit_embedded_fanout_circuit.1 n N g hg
  have hc' : c = fanEmbCirc n N g hg := by
    rw [hc]
    rfl
  rw [← hc', hsem, hu]
  rfl

private theorem fan_semantic_eq (n N : ℕ)
    (g : Fin (n + n) → Fin N) (hg : Function.Injective g) (Φ : QState N) :
    runLayered (fanEmbCirc n N g hg) Φ
      = runLayered (Classical.choose
          (ShiShallow.exists_fanout_embedded_pullback n N g hg)) Φ := by
  exact (explicit_fan_semantics n N g hg Φ).trans
    (chosen_fan_semantics n N g hg Φ).symm

private theorem ampFan2_semantic_eq (n w a : ℕ)
    (Φ : QState (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))) :
    runLayered (ampFan2X n w a) Φ = runLayered (ampFan2 n w a) Φ := by
  unfold ampFan2X ampFan2
  exact fan_semantic_eq n _ (ampG2 n w a) _ Φ

private theorem ampFan3_semantic_eq (n w a : ℕ)
    (Φ : QState (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))) :
    runLayered (ampFan3X n w a) Φ = runLayered (ampFan3 n w a) Φ := by
  unfold ampFan3X ampFan3
  exact fan_semantic_eq n _ (ampG3 n w a) _ Φ

private theorem read_semantic_eq {N : ℕ} (w1 w2 w3 s : Fin N)
    (h12 : w1 ≠ w2) (h13 : w1 ≠ w3) (h23 : w2 ≠ w3)
    (h1s : w1 ≠ s) (h2s : w2 ≠ s) (h3s : w3 ≠ s) (Φ : QState N) :
    runLayered (ShiExplicitCirc.readCirc w1 w2 w3 s h12 h13 h23 h1s h2s h3s) Φ
      = runLayered (Classical.choose
          (ShiShallow.exists_majority_readout_at_wires_layerOk_depth
            w1 w2 w3 s h12 h13 h23 h1s h2s h3s)) Φ := by
  obtain ⟨read, hread, hsemX, hokX, hdX⟩ :=
    ShiShallow.explicit_toffoli_majority_readout_and_fanout_circuits
      w1 w2 w3 h12 h13 h23 w1 w2 w3 s h12 h13 h23 h1s h2s h3s 0 |>.2.1
  have hX := hsemX Φ
  rw [hread] at hX
  have hC := (Classical.choose_spec
    (ShiShallow.exists_majority_readout_at_wires_layerOk_depth
      w1 w2 w3 s h12 h13 h23 h1s h2s h3s)).1 Φ
  exact hX.trans hC.symm

private theorem ampRead_semantic_eq (n w a : ℕ)
    (v : Fin (n + (w + (a + 1))))
    (Φ : QState (n + (3 * w + ((2 * n + 3 * a + 3) + 1)))) :
    runLayered (ampReadX n w a v) Φ = runLayered (ampRead n w a v) Φ := by
  unfold ampReadX ampRead
  exact read_semantic_eq _ _ _ _ _ _ _ _ _ _ Φ

private theorem run_six_semantic_eq {N : ℕ}
    (aX a bX b c d e rX r : Layered N)
    (ha : ∀ ψ, runLayered aX ψ = runLayered a ψ)
    (hb : ∀ ψ, runLayered bX ψ = runLayered b ψ)
    (hr : ∀ ψ, runLayered rX ψ = runLayered r ψ)
    (Φ : QState N) :
    runLayered (aX ++ bX ++ c ++ d ++ e ++ rX) Φ
      = runLayered (a ++ b ++ c ++ d ++ e ++ r) Φ := by
  simp only [runLayered_append]
  rw [ha, hb, hr]

/-- Replacing the choice-based fan-out and readout blocks by their determined explicit gate
lists preserves the complete state-vector semantics of the amplified verifier. -/
theorem _root_.QMAReferenceValidation.candidate3 (F : QMAFamily) (n : ℕ)
    (Φ : QState (n + ((ampFamily F).wit n + ((ampFamily F).anc n + 1)))) :
    runLayered ((ampFamilyX F).circ n) Φ = runLayered ((ampFamily F).circ n) Φ := by
  change runLayered (ampCircX F n) Φ = runLayered (ampCirc F n) Φ
  unfold ampCircX ampCirc
  exact run_six_semantic_eq _ _ _ _ _ _ _ _ _
    (ampFan2_semantic_eq n (F.wit n) (F.anc n))
    (ampFan3_semantic_eq n (F.wit n) (F.anc n))
    (ampRead_semantic_eq n (F.wit n) (F.anc n) (F.out n)) Φ

end QMAReferenceValidation.Source3

