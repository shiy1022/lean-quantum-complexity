set_option autoImplicit false

open ShiShallow ShiClassQMA

/-- The placement basis string: `x` on the `n` input wires, `w` on the `K` witness wires,
`false` on the remaining `A` ancilla/output wires. -/
private def shiWi_place {n K A : ℕ} (x : Bits n) (w : Bits K) : Bits (n + (K + A)) :=
  Fin.addCases (motive := fun _ => Bool) x
    (Fin.addCases (motive := fun _ => Bool) w fun _ => false)

private lemma shiWi_place_left {n K A : ℕ} (x : Bits n) (w : Bits K) (i : Fin n) :
    shiWi_place (A := A) x w (Fin.castAdd (K + A) i) = x i := by
  simp only [shiWi_place, Fin.addCases_left]

private lemma shiWi_place_mid {n K A : ℕ} (x : Bits n) (w : Bits K) (j : Fin K) :
    shiWi_place (A := A) x w (Fin.natAdd n (Fin.castAdd A j)) = w j := by
  simp only [shiWi_place, Fin.addCases_right, Fin.addCases_left]

private lemma shiWi_place_zero {n K A : ℕ} (x : Bits n) (w : Bits K) (l : Fin A) :
    shiWi_place (A := A) x w (Fin.natAdd n (Fin.natAdd K l)) = false := by
  simp only [shiWi_place, Fin.addCases_right]

/-- Two full-register strings agreeing on each of the three blocks are equal. -/
private lemma shiWi_bits_ext {n K A : ℕ} {y z : Bits (n + (K + A))}
    (h1 : ∀ i : Fin n, y (Fin.castAdd (K + A) i) = z (Fin.castAdd (K + A) i))
    (h2 : ∀ j : Fin K, y (Fin.natAdd n (Fin.castAdd A j)) = z (Fin.natAdd n (Fin.castAdd A j)))
    (h3 : ∀ l : Fin A, y (Fin.natAdd n (Fin.natAdd K l)) = z (Fin.natAdd n (Fin.natAdd K l))) :
    y = z := by
  funext k
  induction k using Fin.addCases with
  | left i => exact h1 i
  | right r =>
    induction r using Fin.addCases with
    | left j => exact h2 j
    | right l => exact h3 l

/-- `y` is the placement of `w` exactly when it reads `x` on the inputs, `false` on the
ancilla/output block, and restricts to `w` on the witness block. -/
private lemma shiWi_place_eq_iff {n K A : ℕ} (x : Bits n) (w : Bits K)
    (y : Bits (n + (K + A))) :
    y = shiWi_place (A := A) x w ↔
      ((∀ i : Fin n, y (Fin.castAdd (K + A) i) = x i) ∧
        (∀ l : Fin A, y (Fin.natAdd n (Fin.natAdd K l)) = false) ∧
        (fun j : Fin K => y (Fin.natAdd n (Fin.castAdd A j))) = w) := by
  constructor
  · intro h
    subst h
    exact ⟨fun i => shiWi_place_left (A := A) x w i, fun l => shiWi_place_zero (A := A) x w l,
      funext fun j => shiWi_place_mid (A := A) x w j⟩
  · intro h
    refine shiWi_bits_ext (fun i => ?_) (fun j => ?_) (fun l => ?_)
    · exact (h.1 i).trans (shiWi_place_left (A := A) x w i).symm
    · exact (congrFun h.2.2 j).trans (shiWi_place_mid (A := A) x w j).symm
    · exact (h.2.1 l).trans (shiWi_place_zero (A := A) x w l).symm

/-- Placement is injective in the witness block. -/
private lemma shiWi_place_inj {n K A : ℕ} {x : Bits n} {w w' : Bits K}
    (h : shiWi_place (A := A) x w = shiWi_place (A := A) x w') : w = w' := by
  funext j
  exact ((shiWi_place_mid (A := A) x w j).symm.trans
    (congrFun h (Fin.natAdd n (Fin.castAdd A j)))).trans (shiWi_place_mid (A := A) x w' j)

/-- The explicit 0/1 placement matrix. -/
private def shiWi_mat {n : ℕ} (F : QMAFamily) (x : Bits n) :
    Matrix (Bits (n + (F.wit n + (F.anc n + 1)))) (Bits (F.wit n)) ℂ :=
  Matrix.of fun y w => if y = shiWi_place (A := F.anc n + 1) x w then 1 else 0

private lemma shiWi_mat_apply {n : ℕ} (F : QMAFamily) (x : Bits n)
    (y : Bits (n + (F.wit n + (F.anc n + 1)))) (w : Bits (F.wit n)) :
    shiWi_mat F x y w = if y = shiWi_place (A := F.anc n + 1) x w then 1 else 0 := rfl

/-- The placement matrix is an isometry. -/
private lemma shiWi_mat_iso {n : ℕ} (F : QMAFamily) (x : Bits n) :
    Matrix.conjTranspose (shiWi_mat F x) * shiWi_mat F x = (1 : Op (F.wit n)) := by
  refine Matrix.ext fun w w' => ?_
  rw [Matrix.mul_apply]
  by_cases hw : w = w'
  · subst hw
    have h1 : ∀ y : Bits (n + (F.wit n + (F.anc n + 1))),
        Matrix.conjTranspose (shiWi_mat F x) w y * shiWi_mat F x y w
          = if y = shiWi_place (A := F.anc n + 1) x w then (1 : ℂ) else 0 := by
      intro y
      rw [Matrix.conjTranspose_apply, shiWi_mat_apply]
      by_cases hy : y = shiWi_place (A := F.anc n + 1) x w
      · rw [if_pos hy, star_one, one_mul]
      · rw [if_neg hy, star_zero, zero_mul]
    rw [Matrix.one_apply_eq]
    simp only [h1]
    exact Fintype.sum_ite_eq' (shiWi_place (A := F.anc n + 1) x w) (fun _ => (1 : ℂ))
  · rw [Matrix.one_apply_ne hw]
    refine Finset.sum_eq_zero fun y _ => ?_
    rw [Matrix.conjTranspose_apply, shiWi_mat_apply, shiWi_mat_apply]
    by_cases hy : y = shiWi_place (A := F.anc n + 1) x w
    · have hne : y ≠ shiWi_place (A := F.anc n + 1) x w' := fun hh =>
        hw (shiWi_place_inj (hy.symm.trans hh))
      rw [if_pos hy, if_neg hne, star_one, one_mul]
    · rw [if_neg hy, star_zero, zero_mul]

/-- The placement matrix acts on a witness vector exactly as `witnessInputState`. -/
private lemma shiWi_mat_mulVec {n : ℕ} (F : QMAFamily) (x : Bits n) (ψ : QState (F.wit n)) :
    Matrix.mulVec (shiWi_mat F x) ψ = witnessInputState F x ψ := by
  funext y
  rw [Matrix.mulVec_apply_eq_sum]
  by_cases hP : (∀ i : Fin n, y (Fin.castAdd (F.wit n + (F.anc n + 1)) i) = x i) ∧
      (∀ l : Fin (F.anc n + 1), y (Fin.natAdd n (Fin.natAdd (F.wit n) l)) = false)
  · have hs : ∀ w : Bits (F.wit n),
        shiWi_mat F x y w * ψ w =
          if (fun j : Fin (F.wit n) => y (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))) = w
            then ψ w else 0 := by
      intro w
      have hiff : y = shiWi_place (A := F.anc n + 1) x w ↔
          (fun j : Fin (F.wit n) => y (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))) = w := by
        constructor
        · intro hh
          exact ((shiWi_place_eq_iff x w y).mp hh).2.2
        · intro hh
          exact (shiWi_place_eq_iff x w y).mpr ⟨hP.1, hP.2, hh⟩
      rw [shiWi_mat_apply]
      by_cases hq : (fun j : Fin (F.wit n) => y (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))) = w
      · rw [if_pos (hiff.mpr hq), if_pos hq, one_mul]
      · have hne : y ≠ shiWi_place (A := F.anc n + 1) x w := fun hh => hq (hiff.mp hh)
        rw [if_neg hne, if_neg hq, zero_mul]
    simp only [hs]
    rw [Fintype.sum_ite_eq
      (fun j : Fin (F.wit n) => y (Fin.natAdd n (Fin.castAdd (F.anc n + 1) j))) ψ]
    simp only [witnessInputState]
    rw [if_pos hP]
  · have hz : ∀ w : Bits (F.wit n), shiWi_mat F x y w * ψ w = 0 := by
      intro w
      have hne : y ≠ shiWi_place (A := F.anc n + 1) x w := fun hh =>
        hP ⟨((shiWi_place_eq_iff x w y).mp hh).1, ((shiWi_place_eq_iff x w y).mp hh).2.1⟩
      rw [shiWi_mat_apply, if_neg hne, zero_mul]
    simp only [hz]
    rw [Finset.sum_const_zero]
    simp only [witnessInputState]
    rw [if_neg hP]

/-- `witnessInputState F x` is the action of an explicit isometry on the witness register. -/
theorem _root_.QMAReferenceValidation.candidate13 {n : ℕ} (F : ShiClassQMA.QMAFamily) (x : ShiShallow.Bits n) :
    ∃ W : Matrix (ShiShallow.Bits (n + (F.wit n + (F.anc n + 1))))
                 (ShiShallow.Bits (F.wit n)) ℂ,
      Matrix.conjTranspose W * W = (1 : ShiShallow.Op (F.wit n)) ∧
      ∀ ψ : ShiShallow.QState (F.wit n),
        Matrix.mulVec W ψ = ShiClassQMA.witnessInputState F x ψ :=
  ⟨shiWi_mat F x, shiWi_mat_iso F x, fun ψ => shiWi_mat_mulVec F x ψ⟩

end QMAReferenceValidation.Source13

