open ShiShallow ShiClassQMA ShiClassQMAAmp ShiClassQMAAmpX

private theorem ampx_fan_spec (n N : ℕ) (g : Fin (n + n) → Fin N)
    (hg : Function.Injective g) :
    (∀ l ∈ fanEmbCirc n N g hg, LayerOk l) ∧ depth (fanEmbCirc n N g hg) = 1 := by
  obtain ⟨c, u, hc, hu, hact, hxor, hfix, hok, hd⟩ :=
    ShiShallow.explicit_embedded_fanout_circuit.1 n N g hg
  have heq : c = fanEmbCirc n N g hg := by
    rw [hc]
    rfl
  rw [← heq]
  exact ⟨hok, hd⟩

private theorem ampx_read_spec {N : ℕ} (w1 w2 w3 s : Fin N)
    (h12 : w1 ≠ w2) (h13 : w1 ≠ w3) (h23 : w2 ≠ w3)
    (h1s : w1 ≠ s) (h2s : w2 ≠ s) (h3s : w3 ≠ s) :
    (∀ l ∈ ShiExplicitCirc.readCirc w1 w2 w3 s h12 h13 h23 h1s h2s h3s,
      LayerOk l)
      ∧ depth (ShiExplicitCirc.readCirc w1 w2 w3 s h12 h13 h23 h1s h2s h3s) = 111 := by
  obtain ⟨read, hread, hact, hok, hd⟩ :=
    ShiShallow.explicit_toffoli_majority_readout_and_fanout_circuits
      w1 w2 w3 h12 h13 h23 w1 w2 w3 s h12 h13 h23 h1s h2s h3s 0 |>.2.1
  have heq : read =
      ShiExplicitCirc.readCirc w1 w2 w3 s h12 h13 h23 h1s h2s h3s := by
    rw [hread]
    rfl
  rw [← heq]
  exact ⟨hok, hd⟩

private theorem ampx_depth (F : QMAFamily) (n : ℕ) :
    depth ((ampFamilyX F).circ n) = 3 * depth (F.circ n) + 113 := by
  change depth (ampCircX F n) = 3 * depth (F.circ n) + 113
  have h2 : depth (ampFan2X n (F.wit n) (F.anc n)) = 1 := by
    exact (ampx_fan_spec n _ (ampG2 n (F.wit n) (F.anc n)) _).2
  have h3 : depth (ampFan3X n (F.wit n) (F.anc n)) = 1 := by
    exact (ampx_fan_spec n _ (ampG3 n (F.wit n) (F.anc n)) _).2
  have hr : depth (ampReadX n (F.wit n) (F.anc n) (F.out n)) = 111 := by
    unfold ampReadX
    exact (ampx_read_spec _ _ _ _ _ _ _ _ _ _).2
  simp only [ampCircX, depth, List.length_append, ShiEmbed.embedCirc, List.length_map] at *
  omega

private theorem ampx_wellFormed (F : QMAFamily) :
    ShiBQP.WellFormed F.toFamily → ShiBQP.WellFormed (ampFamilyX F).toFamily := by
  intro hF n l hl
  change l ∈ ampCircX F n at hl
  unfold ampCircX at hl
  rcases List.mem_append.mp hl with hleft | hr
  rcases List.mem_append.mp hleft with hleft | he3
  rcases List.mem_append.mp hleft with hleft | he2
  rcases List.mem_append.mp hleft with hleft | he1
  rcases List.mem_append.mp hleft with h2 | h3
  · exact (ampx_fan_spec n _ (ampG2 n (F.wit n) (F.anc n)) _).1 l h2
  · exact (ampx_fan_spec n _ (ampG3 n (F.wit n) (F.anc n)) _).1 l h3
  · exact (ShiEmbed.layerOk_closure_append_embedCirc _ _).1 (F.circ n) (hF n) l he1
  · exact (ShiEmbed.layerOk_closure_append_embedCirc _ _).1 (F.circ n) (hF n) l he2
  · exact (ShiEmbed.layerOk_closure_append_embedCirc _ _).1 (F.circ n) (hF n) l he3
  · unfold ampReadX at hr
    exact (ampx_read_spec _ _ _ _ _ _ _ _ _ _).1 l hr

private theorem ampx_polyBounded (F : QMAFamily) :
    ShiBQP.PolyBounded F.toFamily → ShiBQP.PolyBounded (ampFamilyX F).toFamily :=
  ShiClassQMA.polyBounded_of_affine_depth_size_bounds ampFamilyX 3 0 113 3 2 3
    (fun G m => by
      have h := ampx_depth G m
      omega)
    (fun G m => by
      show 3 * G.wit m + (2 * m + 3 * G.anc m + 3)
        ≤ 3 * (G.wit m + G.anc m) + 2 * m + 3
      omega) F

private def ampxTestF : QMAFamily :=
  { anc := fun _ => 0
    wit := fun _ => 1
    circ := fun _ => []
    out := fun _ => ⟨0, by omega⟩ }

/-- Resource identities and regularity of the determined-gate-list amplifier. -/
theorem _root_.QMAReferenceValidation.candidate2 :
    (∀ (F : QMAFamily) (n : ℕ), (ampFamilyX F).wit n = 3 * F.wit n)
    ∧ (∀ (F : QMAFamily) (n : ℕ),
        (ampFamilyX F).anc n = 2 * n + 3 * F.anc n + 3)
    ∧ (∀ (F : QMAFamily) (n : ℕ),
        ((ampFamilyX F).out n).val = 3 * n + 3 * F.wit n + 3 * F.anc n + 3)
    ∧ (∀ (F : QMAFamily) (n : ℕ),
        depth ((ampFamilyX F).circ n) = 3 * depth (F.circ n) + 113)
    ∧ (∀ F : QMAFamily,
        ShiBQP.WellFormed F.toFamily → ShiBQP.WellFormed (ampFamilyX F).toFamily)
    ∧ (∀ F : QMAFamily,
        ShiBQP.PolyBounded F.toFamily → ShiBQP.PolyBounded (ampFamilyX F).toFamily)
    ∧ (∃ F : QMAFamily,
        (ampFamilyX F).wit 0 = 3
        ∧ (ampFamilyX F).anc 0 = 3
        ∧ ((ampFamilyX F).out 0).val = 6
        ∧ depth ((ampFamilyX F).circ 0) = 113) := by
  refine ⟨fun _ _ => rfl, fun _ _ => rfl, ?_, ampx_depth,
    ampx_wellFormed, ampx_polyBounded, ⟨ampxTestF, rfl, rfl, ?_, ?_⟩⟩
  · intro F n
    exact ShiClassQMAAmp.ampFamily_resource_identities_and_depth.2.2.1 F n
  · exact ShiClassQMAAmp.ampFamily_resource_identities_and_depth.2.2.1 ampxTestF 0
  · have h := ampx_depth ampxTestF 0
    have h0 : depth (ampxTestF.circ 0) = 0 := rfl
    omega

