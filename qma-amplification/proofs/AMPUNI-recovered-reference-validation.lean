Released under the Apache License, Version 2.0.
Authors: Yueheng Shi

FAN-OUT REPLICATION for the threefold QMA amplifier.

The two fan-out blocks of the amplified verifier are stated ABSTRACTLY here: each is a
circuit `cA` / `cR` on the amplified register whose `runLayered` acts by PULLBACK along a
wire-update map (`hA`, `hR`), the update XORing the input block into a designated
`n`-wire sub-block of the ancilla region (`huA1`/`huR1`) and leaving every other wire
alone (`huA2`/`huR2`).  The copy-2 and copy-3 input blocks are given by ancilla-block
offsets `p q : Fin n -> Fin (G.anc n + 1)` with disjoint images, so no wire-block
arithmetic beyond `Fin.val` is needed and nothing of the amplifier's payload is imported.

The conclusion is the support characterisation the three embedded verifier copies need:
`runLayered (cA ++ cR) (witnessInputState G x Psi)` is supported exactly on the strings
whose input block, copy-2 block and copy-3 block ALL read `x`, whose remaining
ancilla/scratch wires all read `false`, with amplitude `Psi` read off the witness block.
`Psi` is an arbitrary `QState (G.wit n)`: no product structure and no normalisation.
-/

set_option autoImplicit false

open ShiShallow ShiClassQMA

private theorem shiFR_ne_of_val_ne {N : ℕ} {a b : Fin N} (h : (a : ℕ) ≠ (b : ℕ)) : a ≠ b :=
  fun e => h (congrArg Fin.val e)

private theorem shiFR_xor_eq_false_iff (a b : Bool) : (xor a b = false) ↔ a = b := by
  cases a <;> cases b <;> decide

/-- An ancilla-block wire is never an input-block wire. -/
private theorem shiFR_anc_ne_in {n w a : ℕ} (l : Fin (a + 1)) (i : Fin n) :
    (Fin.natAdd n (Fin.natAdd w l) : Fin (n + (w + (a + 1))))
      ≠ Fin.castAdd (w + (a + 1)) i := by
  refine shiFR_ne_of_val_ne ?_
  have h1 : ((Fin.natAdd n (Fin.natAdd w l) : Fin (n + (w + (a + 1)))) : ℕ)
      = n + (w + (l : ℕ)) := rfl
  have h2 : ((Fin.castAdd (w + (a + 1)) i : Fin (n + (w + (a + 1)))) : ℕ) = (i : ℕ) := rfl
  have h3 : (i : ℕ) < n := i.isLt
  omega

/-- An ancilla-block wire is never a witness-block wire. -/
private theorem shiFR_anc_ne_wit {n w a : ℕ} (l : Fin (a + 1)) (j : Fin w) :
    (Fin.natAdd n (Fin.natAdd w l) : Fin (n + (w + (a + 1))))
      ≠ Fin.natAdd n (Fin.castAdd (a + 1) j) := by
  refine shiFR_ne_of_val_ne ?_
  have h1 : ((Fin.natAdd n (Fin.natAdd w l) : Fin (n + (w + (a + 1)))) : ℕ)
      = n + (w + (l : ℕ)) := rfl
  have h2 : ((Fin.natAdd n (Fin.castAdd (a + 1) j) : Fin (n + (w + (a + 1)))) : ℕ)
      = n + (j : ℕ) := rfl
  have h3 : (j : ℕ) < w := j.isLt
  omega

/-- Distinct ancilla-block offsets name distinct wires. -/
private theorem shiFR_anc_ne_anc {n w a : ℕ} {l l' : Fin (a + 1)} (h : l ≠ l') :
    (Fin.natAdd n (Fin.natAdd w l) : Fin (n + (w + (a + 1))))
      ≠ Fin.natAdd n (Fin.natAdd w l') := by
  refine shiFR_ne_of_val_ne ?_
  have h1 : ((Fin.natAdd n (Fin.natAdd w l) : Fin (n + (w + (a + 1)))) : ℕ)
      = n + (w + (l : ℕ)) := rfl
  have h2 : ((Fin.natAdd n (Fin.natAdd w l') : Fin (n + (w + (a + 1)))) : ℕ)
      = n + (w + (l' : ℕ)) := rfl
  have h3 : (l : ℕ) ≠ (l' : ℕ) := fun e => h (Fin.eq_of_val_eq e)
  omega

/-- **Fan-out replication.**  Two abstract fan-out blocks acting by pullback on the
amplified register turn the witness input state into the state supported exactly on the
strings whose three input blocks all read `x`. -/
theorem _root_.QMAReferenceValidation.candidate15 {n : ℕ} (G : QMAFamily) (x : Bits n) (Ψ : QState (G.wit n))
    (p q : Fin n → Fin (G.anc n + 1)) (hpq : ∀ j j' : Fin n, p j ≠ q j')
    (cA cR : Layered (n + (G.wit n + (G.anc n + 1))))
    (uA uR : Bits (n + (G.wit n + (G.anc n + 1))) →
      Bits (n + (G.wit n + (G.anc n + 1))))
    (hA : ∀ Φ : QState (n + (G.wit n + (G.anc n + 1))),
      runLayered cA Φ = fun Y => Φ (uA Y))
    (hR : ∀ Φ : QState (n + (G.wit n + (G.anc n + 1))),
      runLayered cR Φ = fun Y => Φ (uR Y))
    (huA1 : ∀ (Y : Bits (n + (G.wit n + (G.anc n + 1)))) (j : Fin n),
      uA Y (Fin.natAdd n (Fin.natAdd (G.wit n) (p j)))
        = xor (Y (Fin.natAdd n (Fin.natAdd (G.wit n) (p j))))
            (Y (Fin.castAdd (G.wit n + (G.anc n + 1)) j)))
    (huA2 : ∀ (Y : Bits (n + (G.wit n + (G.anc n + 1))))
      (k : Fin (n + (G.wit n + (G.anc n + 1)))),
      (∀ j : Fin n, Fin.natAdd n (Fin.natAdd (G.wit n) (p j)) ≠ k) → uA Y k = Y k)
    (huR1 : ∀ (Y : Bits (n + (G.wit n + (G.anc n + 1)))) (j : Fin n),
      uR Y (Fin.natAdd n (Fin.natAdd (G.wit n) (q j)))
        = xor (Y (Fin.natAdd n (Fin.natAdd (G.wit n) (q j))))
            (Y (Fin.castAdd (G.wit n + (G.anc n + 1)) j)))
    (huR2 : ∀ (Y : Bits (n + (G.wit n + (G.anc n + 1))))
      (k : Fin (n + (G.wit n + (G.anc n + 1)))),
      (∀ j : Fin n, Fin.natAdd n (Fin.natAdd (G.wit n) (q j)) ≠ k) → uR Y k = Y k) :
    runLayered (cA ++ cR) (witnessInputState G x Ψ)
      = fun Y =>
          if (∀ i : Fin n, Y (Fin.castAdd (G.wit n + (G.anc n + 1)) i) = x i)
              ∧ (∀ j : Fin n, Y (Fin.natAdd n (Fin.natAdd (G.wit n) (p j))) = x j)
              ∧ (∀ j : Fin n, Y (Fin.natAdd n (Fin.natAdd (G.wit n) (q j))) = x j)
              ∧ (∀ l : Fin (G.anc n + 1), (∀ j : Fin n, p j ≠ l) →
                  (∀ j : Fin n, q j ≠ l) →
                  Y (Fin.natAdd n (Fin.natAdd (G.wit n) l)) = false)
          then Ψ (fun w : Fin (G.wit n) => Y (Fin.natAdd n (Fin.castAdd (G.anc n + 1) w)))
          else 0 := by
  refine (runLayered_append_action_readout cA cR (fun Φ Y => Φ (uA Y)) uR hA hR
    (witnessInputState G x Ψ)).trans ?_
  funext Y
  show witnessInputState G x Ψ (uA (uR Y)) = _
  have hin : ∀ i : Fin n,
      uA (uR Y) (Fin.castAdd (G.wit n + (G.anc n + 1)) i)
        = Y (Fin.castAdd (G.wit n + (G.anc n + 1)) i) := fun i =>
    (huA2 _ _ (fun j => shiFR_anc_ne_in (p j) i)).trans
      (huR2 _ _ (fun j => shiFR_anc_ne_in (q j) i))
  have hwt : ∀ w : Fin (G.wit n),
      uA (uR Y) (Fin.natAdd n (Fin.castAdd (G.anc n + 1) w))
        = Y (Fin.natAdd n (Fin.castAdd (G.anc n + 1) w)) := fun w =>
    (huA2 _ _ (fun j => shiFR_anc_ne_wit (p j) w)).trans
      (huR2 _ _ (fun j => shiFR_anc_ne_wit (q j) w))
  have hap : ∀ j : Fin n,
      uA (uR Y) (Fin.natAdd n (Fin.natAdd (G.wit n) (p j)))
        = xor (Y (Fin.natAdd n (Fin.natAdd (G.wit n) (p j))))
            (Y (Fin.castAdd (G.wit n + (G.anc n + 1)) j)) := by
    intro j
    refine (huA1 (uR Y) j).trans ?_
    rw [huR2 Y _ (fun j' => shiFR_anc_ne_anc (hpq j j').symm),
      huR2 Y _ (fun j' => shiFR_anc_ne_in (q j') j)]
  have haq : ∀ j : Fin n,
      uA (uR Y) (Fin.natAdd n (Fin.natAdd (G.wit n) (q j)))
        = xor (Y (Fin.natAdd n (Fin.natAdd (G.wit n) (q j))))
            (Y (Fin.castAdd (G.wit n + (G.anc n + 1)) j)) := fun j =>
    (huA2 (uR Y) _ (fun j' => shiFR_anc_ne_anc (hpq j' j))).trans (huR1 Y j)
  have hfree : ∀ l : Fin (G.anc n + 1), (∀ j : Fin n, p j ≠ l) → (∀ j : Fin n, q j ≠ l) →
      uA (uR Y) (Fin.natAdd n (Fin.natAdd (G.wit n) l))
        = Y (Fin.natAdd n (Fin.natAdd (G.wit n) l)) := by
    intro l hp hq
    exact (huA2 (uR Y) _ (fun j => shiFR_anc_ne_anc (hp j))).trans
      (huR2 Y _ (fun j => shiFR_anc_ne_anc (hq j)))
  have hiff :
      ((∀ i : Fin n, uA (uR Y) (Fin.castAdd (G.wit n + (G.anc n + 1)) i) = x i)
          ∧ (∀ l : Fin (G.anc n + 1),
              uA (uR Y) (Fin.natAdd n (Fin.natAdd (G.wit n) l)) = false))
        ↔ ((∀ i : Fin n, Y (Fin.castAdd (G.wit n + (G.anc n + 1)) i) = x i)
            ∧ (∀ j : Fin n, Y (Fin.natAdd n (Fin.natAdd (G.wit n) (p j))) = x j)
            ∧ (∀ j : Fin n, Y (Fin.natAdd n (Fin.natAdd (G.wit n) (q j))) = x j)
            ∧ (∀ l : Fin (G.anc n + 1), (∀ j : Fin n, p j ≠ l) →
                (∀ j : Fin n, q j ≠ l) →
                Y (Fin.natAdd n (Fin.natAdd (G.wit n) l)) = false)) := by
    constructor
    · intro h
      have hI : ∀ i : Fin n, Y (Fin.castAdd (G.wit n + (G.anc n + 1)) i) = x i := fun i =>
        (hin i).symm.trans (h.1 i)
      refine ⟨hI, ?_, ?_, ?_⟩
      · intro j
        exact ((shiFR_xor_eq_false_iff _ _).mp ((hap j).symm.trans (h.2 (p j)))).trans (hI j)
      · intro j
        exact ((shiFR_xor_eq_false_iff _ _).mp ((haq j).symm.trans (h.2 (q j)))).trans (hI j)
      · intro l hp hq
        exact (hfree l hp hq).symm.trans (h.2 l)
    · intro h
      refine ⟨fun i => (hin i).trans (h.1 i), ?_⟩
      intro l
      by_cases hep : ∃ j : Fin n, p j = l
      · obtain ⟨j, hj⟩ := hep
        subst hj
        exact (hap j).trans
          ((shiFR_xor_eq_false_iff _ _).mpr ((h.2.1 j).trans (h.1 j).symm))
      · by_cases heq : ∃ j : Fin n, q j = l
        · obtain ⟨j, hj⟩ := heq
          subst hj
          exact (haq j).trans
            ((shiFR_xor_eq_false_iff _ _).mpr ((h.2.2.1 j).trans (h.1 j).symm))
        · exact (hfree l (fun j hj => hep ⟨j, hj⟩) (fun j hj => heq ⟨j, hj⟩)).trans
            (h.2.2.2 l (fun j hj => hep ⟨j, hj⟩) (fun j hj => heq ⟨j, hj⟩))
  refine Eq.trans ?_ (if_congr hiff (congrArg Ψ (funext hwt))
