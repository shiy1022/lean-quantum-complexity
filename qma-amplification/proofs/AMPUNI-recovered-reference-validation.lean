open Turing Turing.TM2 Turing.TM2.Stmt

/-!
# Parsing one unary code `encNat k` off a `TM2` stack

`ShiBQP.encNat k = List.replicate k true ++ [false]`. A machine whose label `lc` carries the
`branch_loop` shape -- `pop ka fpop (branch gtest (push kb hpush (goto lc)) (goto lnext))` --
parses such a code with NO new induction: this file is a pure SPECIALISATION of the accepted
`ShiTM.branch_loop_transfers_prefix_until_symbol` at `p := List.replicate k (b true)`,
`c := b false`, `t := rest`.

`b : Bool → Gam ka` is the alphabet embedding that puts a bit on the stack; no equation
`Gam ka = Bool` is assumed, and `b := id` recovers the literal `Bool`-alphabet case.

Conclusions: the exact iterate equation at `k + 1` steps (DERIVED from the cited
`p.length + 1` via `(List.replicate k (b true)).length = k`), the `Nonempty EvalsToInTime`
package with the step witness explicit, the residual `ka = rest`, and the parsed value exposed
as the natural number `k`: the mark stack is exactly `List.replicate k (e (b true)) ++ S kb`,
whose length exceeds `(S kb).length` by `k`, so `k` is RECOVERABLE from the halting
configuration by subtracting the two lengths.
-/

theorem _root_.QMAReferenceValidation.candidate64 {K : Type} [DecidableEq K] {Gam : K → Type} {Lam sig : Type}
    (M : Lam → Turing.TM2.Stmt Gam Lam sig) {ka kb : K} (hab : ka ≠ kb) {lc lnext : Lam}
    {fpop : sig → Option (Gam ka) → sig} {gtest : sig → Bool} {hpush : sig → Gam kb}
    {e : Gam ka → Gam kb} (b : Bool → Gam ka)
    (hM : M lc = Turing.TM2.Stmt.pop ka fpop
            (Turing.TM2.Stmt.branch gtest
              (Turing.TM2.Stmt.push kb hpush (Turing.TM2.Stmt.goto (fun _ => lc)))
              (Turing.TM2.Stmt.goto (fun _ => lnext))))
    (hval : forall (w : sig) (y : Gam ka), hpush (fpop w (some y)) = e y)
    (hone : forall w : sig, gtest (fpop w (some (b true))) = true)
    (hzero : forall w : sig, gtest (fpop w (some (b false))) = false)
    (k : ℕ) (rest : List (Gam ka)) (v : sig) (S : forall j, List (Gam j))
    (hS : S ka = (ShiBQP.encNat k).map b ++ rest) :
    (fun cf : Option (Turing.TM2.Cfg Gam Lam sig) => cf.bind (Turing.TM2.step M))^[k + 1]
        (some { l := some lc, var := v, stk := S })
      = some { l := some lnext,
               var := fpop (List.foldl (fun w y => fpop w (some y)) v
                        (List.replicate k (b true))) (some (b false)),
               stk := Function.update (Function.update S ka rest) kb
                        (List.replicate k (e (b true)) ++ S kb) }
    ∧ Nonempty (StateTransition.EvalsToInTime (Turing.TM2.step M)
        { l := some lc, var := v, stk := S }
        (some { l := some lnext,
                var := fpop (List.foldl (fun w y => fpop w (some y)) v
                         (List.replicate k (b true))) (some (b false)),
                stk := Function.update (Function.update S ka rest) kb
                         (List.replicate k (e (b true)) ++ S kb) })
        (k + 1))
    ∧ (Function.update (Function.update S ka rest) kb
        (List.replicate k (e (b true)) ++ S kb)) ka = rest
    ∧ (List.replicate k (e (b true)) ++ S kb).length = k + (S kb).length
    ∧ (List.replicate k (e (b true)) ++ S kb).length - (S kb).length = k := by
  -- Reshape the caller's hypothesis into the loop's `p ++ c :: t` form.
  have henc : (ShiBQP.encNat k).map b ++ rest
      = List.replicate k (b true) ++ (b false) :: rest := by
    simp only [ShiBQP.encNat, List.map_append, List.map_replicate, List.map_cons,
      List.map_nil, List.append_assoc, List.cons_append, List.nil_append]
    all_goals rfl
  -- Cite the accepted loop theorem; no induction is redone here.
  have hmain := ShiTM.branch_loop_transfers_prefix_until_symbol M hab hM hval
    (List.replicate k (b true))
    (fun w y hy => by rw [List.eq_of_mem_replicate hy]; exact hone w)
    (b false) hzero rest v S (hS.trans henc)
  -- `(List.replicate k (b true)).length = k` turns `p.length + 1` into `k + 1`, and
  -- `(List.map e (List.replicate k (b true))).reverse = List.replicate k (e (b true))`
  -- puts the mark stack in replicate normal form.
  have h1 := hmain.1
  simp only [List.length_replicate, List.map_replicate, List.reverse_replicate] at h1
  have hres : (Function.update (Function.update S ka rest) kb
      (List.replicate k (e (b true)) ++ S kb)) ka = rest := by
    rw [Function.update_of_ne hab, Function.update_self]
  have hlen2 : (List.replicate k (e (b true)) ++ S kb).length = k + (S kb).length := by
    rw [List.length_append, List.length_replicate]
  have hsub : (List.replicate k (e (b true)) ++ S kb).length - (S kb).length = k := by
    rw [hlen2]
    omega
  exact ⟨h1, ⟨⟨k + 1, h1⟩, le_refl _⟩, hres, hlen2, hsub⟩

/-! ## Satisfiability witness

The hypotheses are not vacuous. Toy machine: `K = Lam = Bool`, `Gam = fun _ => Bool`,
`sig = Option Bool` (the variable remembers the popped bit), input stack `ka = true`,
mark stack `kb = false`, loop label `lc = true`, exit label `lnext = false`,
`b = e = id`. Every hypothesis of `QMAReferenceValidation.candidate64` is discharged by `rfl`/`decide` below, so the
whole statement instantiates at a concrete machine, for every `k`, `rest` and `v`. -/

private def shiPs_M (l : Bool) : Turing.TM2.Stmt (fun _ : Bool => Bool) Bool (Option Bool) :=
  bif l then
    Turing.TM2.Stmt.pop true (fun _ y => y)
      (Turing.TM2.Stmt.branch (fun w => decide (w = some true))
        (Turing.TM2.Stmt.push false (fun w => w.getD false)
          (Turing.TM2.Stmt.goto (fun _ => true)))
        (Turing.TM2.Stmt.goto (fun _ => false)))
  else Turing.TM2.Stmt.halt

private theorem shiPs_hM : shiPs_M true =
    Turing.TM2.Stmt.pop true (fun _ y => y)
      (Turing.TM2.Stmt.branch (fun w => decide (w = some true))
        (Turing.TM2.Stmt.push false (fun w => w.getD false)
          (Turing.TM2.Stmt.goto (fun _ => true)))
        (Turing.TM2.Stmt.goto (fun _ => false))) := rfl

private theorem shiPs_hypotheses_satisfiable (k : ℕ) (rest : List Bool)
    (v : Option Bool) : True := by
  have _h := QMAReferenceValidation.candidate64 (M := shiPs_M) (ka := true) (kb := false)
    (hab := by decide) (e := id) (b := id) (hM := shiPs_hM)
    (hval := fun _ _ => rfl) (hone := fun _ => rfl) (hzero := fun _ => rfl)
    (k := k) (rest := rest) (v := v)
    (S := fun _ => (ShiBQP.encNat k).map id ++ rest) (hS := rfl)
  trivial

end QMAReferenceValidation.Source64

