/-!
# Exact lengths of the circuit serialisation, and a polynomial size bound

Pure list arithmetic about `ShiBQP.encNat`, `encStr`, `encInstr`, `encLayer`, `encCirc` and
`encFamilyAt`.  No Turing machine appears.  The point is that machine step counts phrased in
terms of wire indices, list lengths and sums over lists can be compared with a polynomial in
the LENGTH of the serialised input, which is what classical uniformity is stated against.

## What is proved

* `(encNat k).length = k + 1` -- the unary code of `k` carries the terminating `false`, so the
  code of `0` has length `1`, NOT `0`.
* `(encStr ls).length = ls.length + 1 + (ls.map List.length).sum`.
* The five per-instruction lengths.  These are NOT uniform in the tag: the tag `encNat t` itself
  occupies `t + 1` bits, so
  `h i ↦ i + 2`, `s i ↦ i + 3`, `t i ↦ i + 4`, `x i ↦ i + 5`, `cnot i j _ ↦ i + j + 7`.
* The uniform cap `(encInstr g).length ≤ 2 * m + 5`, from `(i : ℕ) < m` for `i : Fin m`.  The
  cap is TIGHT: it is attained by a `cnot` on the two top wires when `m ≥ 2`.
* The structural formulas for `encLayer`, `encCirc` and `encFamilyAt`.
* An unconditional bound in the per-layer gate counts:
  `(encCirc c).length ≤ 2 * ShiShallow.depth c + 1 + (c.map List.length).sum * (2 * m + 6)`.
* The polynomial bound, for circuits all of whose layers are `LayerOk`:
  `(encCirc c).length ≤ 2 * depth c + 1 + depth c * m * (2 * m + 6)`,
  obtained from the previous line and the published platform theorem
  `ShiShallow.gateCount_le_depth_mul_width_of_layerOk_core`, which bounds the total gate count
  `(c.map List.length).sum` by `depth c * m`.  That citation is the ONLY place this file appeals
  to anything outside list arithmetic; the conjunct before it is free of that dependency.

## Limitations

Nothing here says the encoding is injective or decodable; these are size statements only.
-/

/-- The unary code of `k` has length `k + 1`: the terminating `false` is part of the code. -/
private lemma shiSz_encNat_len (k : ℕ) : (ShiBQP.encNat k).length = k + 1 := by
  have hE : ShiBQP.encNat k = List.replicate k true ++ [false] := rfl
  rw [hE]
  simp

/-- Length of a length-prefixed concatenation. -/
private lemma shiSz_encStr_len (ls : List PvsNP.Str) :
    (ShiBQP.encStr ls).length = ls.length + 1 + (ls.map List.length).sum := by
  have hE : ShiBQP.encStr ls = ShiBQP.encNat ls.length ++ ls.flatten := rfl
  rw [hE, List.length_append, shiSz_encNat_len, List.length_flatten]

/-! ### Pointwise sum lemmas, proved by induction to avoid any name drift -/

/-- Monotonicity of `Σ` over a list under a pointwise bound. -/
private lemma shiSz_sum_le_sum {α : Type*} (f g : α → ℕ) :
    ∀ l : List α, (∀ x ∈ l, f x ≤ g x) → (l.map f).sum ≤ (l.map g).sum := by
  intro l
  induction l with
  | nil => intro _; simp
  | cons a t ih =>
    intro h
    have ha : f a ≤ g a := h a (by simp)
    have ht : (t.map f).sum ≤ (t.map g).sum := ih (fun x hx => h x (by simp [hx]))
    simp only [List.map_cons, List.sum_cons]
    exact Nat.add_le_add ha ht

/-- A constant pointwise bound gives `length * bound`. -/
private lemma shiSz_sum_const_le {α : Type*} (f : α → ℕ) (B : ℕ) :
    ∀ l : List α, (∀ x ∈ l, f x ≤ B) → (l.map f).sum ≤ l.length * B := by
  intro l
  induction l with
  | nil => intro _; simp
  | cons a t ih =>
    intro h
    have ha : f a ≤ B := h a (by simp)
    have ht : (t.map f).sum ≤ t.length * B := ih (fun x hx => h x (by simp [hx]))
    have hmul : (a :: t).length * B = t.length * B + B := by
      simp only [List.length_cons]
      ring
    simp only [List.map_cons, List.sum_cons, hmul]
    omega

/-- `Σ (1 + len x * K) = length + (Σ len) * K`. -/
private lemma shiSz_sum_affine {α : Type*} (len : α → ℕ) (K : ℕ) :
    ∀ l : List α,
      (l.map (fun x => 1 + len x * K)).sum = l.length + (l.map len).sum * K := by
  intro l
  induction l with
  | nil => simp
  | cons a t ih =>
    simp only [List.map_cons, List.sum_cons, List.length_cons, ih]
    ring

/-! ### The five instruction codes

`encInstr` writes the constructor tag with `encNat`, so the tag for `t` already costs `3` bits
and the tags have DIFFERENT lengths.  Hence the per-constructor lengths differ by tag. -/

private lemma shiSz_encInstr_h {m : ℕ} (i : Fin m) :
    (ShiBQP.encInstr (ShiShallow.Instr.h i)).length = (i : ℕ) + 2 := by
  have hE : ShiBQP.encInstr (ShiShallow.Instr.h i)
      = ShiBQP.encNat 0 ++ ShiBQP.encNat (i : ℕ) := rfl
  rw [hE, List.length_append, shiSz_encNat_len, shiSz_encNat_len]
  all_goals omega

private lemma shiSz_encInstr_s {m : ℕ} (i : Fin m) :
    (ShiBQP.encInstr (ShiShallow.Instr.s i)).length = (i : ℕ) + 3 := by
  have hE : ShiBQP.encInstr (ShiShallow.Instr.s i)
      = ShiBQP.encNat 1 ++ ShiBQP.encNat (i : ℕ) := rfl
  rw [hE, List.length_append, shiSz_encNat_len, shiSz_encNat_len]
  all_goals omega

private lemma shiSz_encInstr_t {m : ℕ} (i : Fin m) :
    (ShiBQP.encInstr (ShiShallow.Instr.t i)).length = (i : ℕ) + 4 := by
  have hE : ShiBQP.encInstr (ShiShallow.Instr.t i)
      = ShiBQP.encNat 2 ++ ShiBQP.encNat (i : ℕ) := rfl
  rw [hE, List.length_append, shiSz_encNat_len, shiSz_encNat_len]
  all_goals omega

private lemma shiSz_encInstr_x {m : ℕ} (i : Fin m) :
    (ShiBQP.encInstr (ShiShallow.Instr.x i)).length = (i : ℕ) + 5 := by
  have hE : ShiBQP.encInstr (ShiShallow.Instr.x i)
      = ShiBQP.encNat 3 ++ ShiBQP.encNat (i : ℕ) := rfl
  rw [hE, List.length_append, shiSz_encNat_len, shiSz_encNat_len]
  all_goals omega

/-- The `cnot` code costs `(i : ℕ) + (j : ℕ) + 7`: the tag `encNat 4` alone is `5` bits.  The
third field is the proof `i ≠ j`, a `Prop`, and contributes nothing. -/
private lemma shiSz_encInstr_cnot {m : ℕ} (i j : Fin m) (hij : i ≠ j) :
    (ShiBQP.encInstr (ShiShallow.Instr.cnot i j hij)).length = (i : ℕ) + (j : ℕ) + 7 := by
  have hE : ShiBQP.encInstr (ShiShallow.Instr.cnot i j hij)
      = ShiBQP.encNat 4 ++ ShiBQP.encNat (i : ℕ) ++ ShiBQP.encNat (j : ℕ) := rfl
  rw [hE, List.length_append, List.length_append, shiSz_encNat_len, shiSz_encNat_len,
    shiSz_encNat_len]
  all_goals omega

/-- Uniform cap on one instruction code, from `(i : ℕ) < m`.  Tight: a `cnot` on wires
`m - 2, m - 1` attains it. -/
private lemma shiSz_encInstr_le {m : ℕ} (g : ShiShallow.Instr m) :
    (ShiBQP.encInstr g).length ≤ 2 * m + 5 := by
  cases g with
  | h i =>
    have hi : (i : ℕ) < m := i.isLt
    rw [shiSz_encInstr_h]
    omega
  | s i =>
    have hi : (i : ℕ) < m := i.isLt
    rw [shiSz_encInstr_s]
    omega
  | t i =>
    have hi : (i : ℕ) < m := i.isLt
    rw [shiSz_encInstr_t]
    omega
  | x i =>
    have hi : (i : ℕ) < m := i.isLt
    rw [shiSz_encInstr_x]
    omega
  | cnot i j hij =>
    have hi : (i : ℕ) < m := i.isLt
    have hj : (j : ℕ) < m := j.isLt
    rw [shiSz_encInstr_cnot]
    omega

/-! ### Layers, circuits, and the family record -/

private lemma shiSz_encLayer_len {m : ℕ} (l : List (ShiShallow.Instr m)) :
    (ShiBQP.encLayer l).length
      = l.length + 1 + (l.map (fun g => (ShiBQP.encInstr g).length)).sum := by
  have hE : ShiBQP.encLayer l = ShiBQP.encStr (l.map ShiBQP.encInstr) := rfl
  have hmap : (l.map ShiBQP.encInstr).map List.length
      = l.map (fun g => (ShiBQP.encInstr g).length) := by
    simp [List.map_map, Function.comp_def]
  rw [hE, shiSz_encStr_len, hmap, List.length_map]

private lemma shiSz_encCirc_len {m : ℕ} (c : ShiShallow.Layered m) :
    (ShiBQP.encCirc c).length
      = c.length + 1 + (c.map (fun l => (ShiBQP.encLayer l).length)).sum := by
  have hE : ShiBQP.encCirc c = ShiBQP.encStr (c.map ShiBQP.encLayer) := rfl
  have hmap : (c.map ShiBQP.encLayer).map List.length
      = c.map (fun l => (ShiBQP.encLayer l).length) := by
    simp [List.map_map, Function.comp_def]
  rw [hE, shiSz_encStr_len, hmap, List.length_map]

private lemma shiSz_encFamilyAt_len (F : ShiClass.Family) (n : ℕ) :
    (ShiBQP.encFamilyAt F n).length
      = F.anc n + ((F.out n : ℕ)) + 2 + (ShiBQP.encCirc (F.circ n)).length := by
  have hE : ShiBQP.encFamilyAt F n
      = ShiBQP.encNat (F.anc n) ++ ShiBQP.encNat ((F.out n : ℕ))
        ++ ShiBQP.encCirc (F.circ n) := rfl
  rw [hE, List.length_append, List.length_append, shiSz_encNat_len, shiSz_encNat_len]
  all_goals omega

/-! ### The size bound

Each instruction code costs at most `2 * m + 5`; a layer of `g` gates therefore costs at most
`1 + g * (2 * m + 6)`, the extra `+ g` paying for the layer's own unary length prefix. -/

private lemma shiSz_encLayer_le {m : ℕ} (l : List (ShiShallow.Instr m)) :
    (ShiBQP.encLayer l).length ≤ 1 + l.length * (2 * m + 6) := by
  have h1 : (l.map (fun g => (ShiBQP.encInstr g).length)).sum ≤ l.length * (2 * m + 5) :=
    shiSz_sum_const_le _ _ l (fun g _ => shiSz_encInstr_le g)
  have h2 : l.length * (2 * m + 6) = l.length * (2 * m + 5) + l.length := by ring
  rw [shiSz_encLayer_len]
  omega

/-- Unconditional: the code length is linear in the depth and in the TOTAL gate count, with
coefficient linear in the wire count. -/
private lemma shiSz_encCirc_le {m : ℕ} (c : ShiShallow.Layered m) :
    (ShiBQP.encCirc c).length
      ≤ 2 * c.length + 1 + (c.map List.length).sum * (2 * m + 6) := by
  have h1 : (c.map (fun l => (ShiBQP.encLayer l).length)).sum
      ≤ (c.map (fun l => 1 + l.length * (2 * m + 6))).sum :=
    shiSz_sum_le_sum _ _ c (fun l _ => shiSz_encLayer_le l)
  have h2 : (c.map (fun l => 1 + l.length * (2 * m + 6))).sum
      = c.length + (c.map List.length).sum * (2 * m + 6) :=
    shiSz_sum_affine List.length (2 * m + 6) c
  rw [shiSz_encCirc_len]
  omega

/-- The polynomial bound.  Cites the published platform theorem
`ShiShallow.gateCount_le_depth_mul_width_of_layerOk_core` to replace the total gate count by
`depth c * m`; that step, and only that step, needs `LayerOk` of every layer. -/
private lemma shiSz_encCirc_le_poly {m : ℕ} (c : ShiShallow.Layered m)
    (hc : ∀ l ∈ c, ShiShallow.LayerOk l) :
    (ShiBQP.encCirc c).length
      ≤ 2 * ShiShallow.depth c + 1 + ShiShallow.depth c * m * (2 * m + 6) := by
  have hd : ShiShallow.depth c = c.length := rfl
  have hG : (c.map List.length).sum ≤ ShiShallow.depth c * m :=
    ShiShallow.gateCount_le_depth_mul_width_of_layerOk_core c hc
  have h1 : (ShiBQP.encCirc c).length
      ≤ 2 * c.length + 1 + (c.map List.length).sum * (2 * m + 6) := shiSz_encCirc_le c
  have h2 : (c.map List.length).sum * (2 * m + 6) ≤ c.length * m * (2 * m + 6) :=
    Nat.mul_le_mul hG (Nat.le_refl (2 * m + 6))
  rw [hd]
  omega

/-! ### The deliverable -/

/-- **Exact lengths of the circuit serialisation, and a polynomial size bound.**

Conjuncts, in order:

1. the unary code of `k` has length `k + 1`;
2. the length of a length-prefixed concatenation;
3. the five per-instruction lengths -- note they are tag-dependent, `h ↦ i + 2` through
   `x ↦ i + 5`, and `cnot i j _ ↦ i + j + 7`;
4. the uniform cap `2 * m + 5` on one instruction code;
5. the layer formula;
6. the circuit formula;
7. the family-record formula;
8. an unconditional bound by depth and total gate count;
9. the polynomial bound for `LayerOk` circuits, via
   `ShiShallow.gateCount_le_depth_mul_width_of_layerOk_core`. -/
theorem _root_.QMAReferenceValidation.candidate65 :
    (∀ k : ℕ, (ShiBQP.encNat k).length = k + 1) ∧
    (∀ ls : List PvsNP.Str,
      (ShiBQP.encStr ls).length = ls.length + 1 + (ls.map List.length).sum) ∧
    (∀ (m : ℕ) (i : Fin m),
