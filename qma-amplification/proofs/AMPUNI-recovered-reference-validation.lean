    (fun i => hA.eigenvalues i.1.1) (fun i => hA.eigenvalues i.1.2) (fun i => hA.eigenvalues i.2)
    (fun i => hα0 _) (fun i => hα0 _) (fun i => hα0 _)
    (fun i => hαs _) (fun i => hαs _) (fun i => hαs _)
